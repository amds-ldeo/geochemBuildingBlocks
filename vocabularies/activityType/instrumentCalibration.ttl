@prefix cdifact: <https://w3id.org/cdif/concepts/provenance/activity/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix geochemvoc: <https://w3id.org/geochem/vocabulary/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

geochemvoc:instrumentCalibration a skos:Concept ;
    dcterms:replaces <https://w3id.org/cdif/provenance/activityType/instrumentCalibration> ;
    skos:broadMatch cdifact:Calibration ;
    skos:definition "An activity that measures reference materials or standards of known value to establish the relationship between the instrument's response and the quantity being measured."@en ;
    skos:inScheme geochemvoc:activityTypes ;
    skos:notation "instrumentCalibration" ;
    skos:prefLabel "Instrument calibration"@en ;
    skos:topConceptOf geochemvoc:activityTypes .

