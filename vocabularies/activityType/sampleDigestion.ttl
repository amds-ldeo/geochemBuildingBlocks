@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix geochemvoc: <https://w3id.org/geochem/vocabulary/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

geochemvoc:sampleDigestion a skos:Concept ;
    dcterms:replaces <https://w3id.org/cdif/provenance/activityType/sampleDigestion> ;
    skos:broader geochemvoc:samplePreparation ;
    skos:definition "Sample preparation that dissolves a solid sample, typically in acid, to produce a solution for analysis."@en ;
    skos:inScheme geochemvoc:activityTypes ;
    skos:notation "sampleDigestion" ;
    skos:prefLabel "Sample digestion"@en .

