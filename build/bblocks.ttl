    prof:hasResource [ dct:conformsTo <https://json-schema.org/draft/2020-12/schema> ;
            dct:format "application/yaml" ;
            prof:hasArtifact <https://amds-ldeo.github.io/geochemBuildingBlocks/build/annotated/techniqueProtocols/parameterValues/schema.yaml> ;
            prof:hasRole role:schema ],
        [ dct:conformsTo <https://json-schema.org/draft/2020-12/schema> ;
            dct:format "application/json" ;
            prof:hasArtifact <https://amds-ldeo.github.io/geochemBuildingBlocks/build/annotated/techniqueProtocols/parameterValues/schema.json> ;
