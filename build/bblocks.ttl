<bblocks://ogch.techniqueProfile.geochemProfile.TEM.detail> a skos:Concept,
        dcat:Dataset,
        bblocks:BBlock,
        bblocks:Schema ;
    rdfs:label "TEM Analysis Detail" ;
    dct:abstract "Detail block for TEM hasPart items. Discriminates on ada:componentType, carries analysis-level required properties and an @id reference to a registered temTAPP definition, and per-dataset schema:additionalProperty entries constrained via $refs to the parameterValues registry plus a catch-all. Generated by tools/build_tapp.py."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:created "2026-06-07T00:00:00+00:00"^^xsd:dateTime ;
