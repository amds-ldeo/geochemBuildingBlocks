<bblocks://ogch.techniqueProfile.geochemProfile.XCT.tapp> a skos:Concept,
        dcat:Dataset,
        bblocks:BBlock,
        bblocks:Schema ;
    rdfs:label "Lab-XCT Technique-Aligned Protocol Profile (labxctTAPP)" ;
    dct:abstract "Laboratory X-ray computed tomography (polychromatic cone-beam) extension of the base TAPP definition. Adds XCT protocol-level acquisition/processing defaults as top-level ada: properties and an ada:methodParameters vocabulary of session-adjustable parameter templates. XCT has no per-element analyte axis, so no analyteTemplate is defined. Vocabularies and parameter templates ship as separate files under vocab/ and parameterTemplates/."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:created "2026-06-04T00:00:00+00:00"^^xsd:dateTime ;
