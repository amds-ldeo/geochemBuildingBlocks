            rdfs:isDefinedBy <https://amds-ldeo.github.io/geochemBuildingBlocks/build/generateddocs/json-full/techniqueProfile/geochemProfile/TEM/tapp/index.json> ],
        [ dct:format "text/html" ;
            rdfs:isDefinedBy <https://amds-ldeo.github.io/geochemBuildingBlocks/bblock/ogch.techniqueProfile.geochemProfile.TEM.tapp> ] ;
