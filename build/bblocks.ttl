    bblocks:validationPassed true .

<bblocks://ogch.registry.analyteColumns> a skos:Concept,
        dcat:Dataset,
        bblocks:BBlock,
        bblocks:Schema ;
    rdfs:label "Analyte-Column Specification Registry" ;
    dct:abstract "Registry of reusable schema:PropertyValueSpecification analyte-column definitions derived from technique TAPP spreadsheets. Hosts one $def per analyte-table reporting column. TAPP building blocks reference these definitions via fragment $refs so they resolve locally through the register."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
