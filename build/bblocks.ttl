        dcat:Dataset,
        bblocks:BBlock,
        bblocks:Schema ;
    rdfs:label "Lab-XCT Analysis Detail" ;
    dct:abstract "Laboratory X-ray computed tomography analysis-specific detail properties. Discriminates on ada:componentType (XCTVolume, XCTProjectionImageSet, XCTSegmentationVolume, XCTRenderedImage, XCTQuantitativeTabular), carries analysis-level required properties (analyst, dates, sample, VOI) and per-dataset schema:additionalProperty values referencing the labxctTAPP parameterValues registry."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:created "2026-06-04T00:00:00+00:00"^^xsd:dateTime ;
    dct:description [ dct:format "text/html" ;
            rdfs:isDefinedBy <https://amds-ldeo.github.io/geochemBuildingBlocks/bblock/ogch.techniqueProfile.geochemProfile.XCT.detail> ],
