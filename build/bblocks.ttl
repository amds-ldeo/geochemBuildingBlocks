        bblocks:Schema ;
    rdfs:label "FIB-SEM Analysis Detail" ;
    dct:abstract "Detail block for FIB-SEM hasPart items. Discriminates on ada:componentType, carries analysis-level required properties and an @id reference to a registered semFibsemTAPP definition, and per-dataset schema:additionalProperty entries constrained via $refs to the parameterValues registry plus a catch-all. Generated by tools/build_tapp.py."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
