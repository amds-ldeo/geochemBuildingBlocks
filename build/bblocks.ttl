<https://amds-ldeo.github.io/geochemBuildingBlocks/> a skos:ConceptScheme,
        dcat:Catalog,
        bblocks:BBlocksRegister ;
    rdfs:label "Building Blocks - ADA Geochemistry Building Blocks repository" ;
    dct:abstract """Building blocks for Astromat Data Archive (ADA) geochemistry metadata profiles,
using the OGC Building Blocks pattern.
"""^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:description """Modular schema components for ADA analytical technique metadata. Imports shared
schema.org and CDIF property building blocks from the CDIF Building Blocks repository.
"""^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:modified "2026-06-04T20:45:18.708555"^^xsd:dateTime ;
    owl:imports <https://cross-domain-interoperability-framework.github.io/metadataBuildingBlocks/build/register.json>,
        <https://opengeospatial.github.io/bblocks/register.json> ;
