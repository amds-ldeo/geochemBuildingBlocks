            rdfs:isDefinedBy <https://amds-ldeo.github.io/geochemBuildingBlocks/build/generateddocs/json-full/BaseSchema/tappDefinition/index.json> ],
        [ dct:format "text/markdown" ;
            rdfs:isDefinedBy <https://amds-ldeo.github.io/geochemBuildingBlocks/build/generateddocs/markdown/BaseSchema/tappDefinition/index.md> ] ;
