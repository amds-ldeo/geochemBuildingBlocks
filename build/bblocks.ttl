<bblocks://ogch.BaseSchema.modules.blank> a skos:Concept,
        dcat:Dataset,
        bblocks:BBlock,
        bblocks:Schema ;
    rdfs:label "TAPP Composition Module: Blank" ;
    dct:abstract "The shared Blank block of the 2026-08-11 TAPP library, composed by 12 of the sixteen delivery tables. 1 owned fields over 0 schema paths, split into the procedure and analysis halves a TAPP schema and a technique detail compose respectively. A profile over existing tappDefinition/adaProduct properties, not a new vocabulary. Generated from the module CSV and its schema-path sidecar."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:created "2026-08-21T00:00:00+00:00"^^xsd:dateTime ;
    dct:description [ dct:format "text/html" ;
            rdfs:isDefinedBy <https://amds-ldeo.github.io/geochemBuildingBlocks/bblock/ogch.BaseSchema.modules.blank> ],
        [ dct:format "text/markdown" ;
            rdfs:isDefinedBy <https://amds-ldeo.github.io/geochemBuildingBlocks/build/generateddocs/markdown/BaseSchema/modules/blank/index.md> ],
        [ dct:format "application/json" ;
            rdfs:isDefinedBy <https://amds-ldeo.github.io/geochemBuildingBlocks/build/generateddocs/json-full/BaseSchema/modules/blank/index.json> ] ;
    dct:hasVersion "0.1" ;
    dct:modified "2026-09-06"^^xsd:date ;
    dct:source <https://github.com/amds-ldeo/geochemBuildingBlocks>,
        <https://github.com/amds-ldeo/metadata> ;
    skos:inScheme <https://amds-ldeo.github.io/geochemBuildingBlocks/> ;
    skos:prefLabel "TAPP Composition Module: Blank" ;
    skos:topConceptOf <https://amds-ldeo.github.io/geochemBuildingBlocks/> ;
    dcat:keyword "ada",
        "astromat",
        "blank",
        "composition-module",
        "profile",
        "tapp" ;
    prof:hasResource [ dct:conformsTo <https://json-schema.org/draft/2020-12/schema> ;
            dct:format "application/yaml" ;
            prof:hasArtifact <https://amds-ldeo.github.io/geochemBuildingBlocks/build/annotated/BaseSchema/modules/blank/schema.yaml> ;
            prof:hasRole role:schema ],
        [ dct:conformsTo <https://www.w3.org/TR/json-ld11/> ;
            dct:format "application/ld+json" ;
            prof:hasArtifact <https://amds-ldeo.github.io/geochemBuildingBlocks/_sources/BaseSchema/modules/blank/context.jsonld> ;
            prof:hasRole role:mapping ],
        [ dct:conformsTo <https://json-schema.org/draft/2020-12/schema> ;
