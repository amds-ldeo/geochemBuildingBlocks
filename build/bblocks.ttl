<bblocks://ogch.registry.channelColumns> a skos:Concept,
        dcat:Dataset,
        bblocks:BBlock,
        bblocks:Schema ;
    rdfs:label "Channel-Column Specification Registry" ;
    dct:abstract "Registry of reusable schema:PropertyValueSpecification channel column definitions derived from technique TAPP workbooks. Each $def constrains one column of the channel table, a channel being an instrument selection position -- a mass, a Faraday cup, an energy-loss edge, an X-ray line -- as distinct from the analyte measured on it. TAPP building blocks reference these definitions via fragment $refs so they resolve locally through the building-block register. The root only hosts $defs; it has no instantiable properties of its own. TAPP building blocks reference these definitions via fragment $refs so they resolve locally through the register."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:created "2026-08-21T00:00:00+00:00"^^xsd:dateTime ;
    dct:description [ dct:format "text/markdown" ;
            rdfs:isDefinedBy <https://amds-ldeo.github.io/geochemBuildingBlocks/build/generateddocs/markdown/registry/channelColumns/index.md> ],
        [ dct:format "text/html" ;
            rdfs:isDefinedBy <https://amds-ldeo.github.io/geochemBuildingBlocks/bblock/ogch.registry.channelColumns> ],
        [ dct:format "application/json" ;
            rdfs:isDefinedBy <https://amds-ldeo.github.io/geochemBuildingBlocks/build/generateddocs/json-full/registry/channelColumns/index.json> ] ;
    dct:hasVersion "0.1" ;
    dct:modified "2026-09-06"^^xsd:date ;
    dct:source <https://github.com/amds-ldeo/metadata> ;
    skos:inScheme <https://amds-ldeo.github.io/geochemBuildingBlocks/> ;
    skos:prefLabel "Channel-Column Specification Registry" ;
    skos:topConceptOf <https://amds-ldeo.github.io/geochemBuildingBlocks/> ;
    dcat:keyword "ada",
        "astromat",
        "channelColumn",
        "registry",
        "tapp" ;
    prof:hasResource [ dct:conformsTo <https://json-schema.org/draft/2020-12/schema> ;
            dct:format "application/yaml" ;
            prof:hasArtifact <https://amds-ldeo.github.io/geochemBuildingBlocks/build/annotated/registry/channelColumns/schema.yaml> ;
            prof:hasRole role:schema ],
        [ dct:conformsTo <https://json-schema.org/draft/2020-12/schema> ;
            dct:format "application/json" ;
            prof:hasArtifact <https://amds-ldeo.github.io/geochemBuildingBlocks/build/annotated/registry/channelColumns/schema.json> ;
            prof:hasRole role:schema ] ;
