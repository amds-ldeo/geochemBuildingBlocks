<ex:detail-Mittlefehldt2024> a ada:LAICPMSGeochronTabular ;
    schema1:additionalProperty <https://ada.astromat.org/metadata/parameter/laSficpmsUPbTAPP/preAnalysisImagingAndScreening> ;
