            }
          ],
          "schema:name": "Monitored Masses",
          "schema:value": "\u2075\u00b2Cr \u2192 Cr; \u2075\u2077Fe \u2192 Fe; \u2075\u2079Co \u2192 Co; \u2076\u00b9Ni \u2192 Ni; \u2076\u2075Cu \u2192 Cu; \u2076\u2079Ga \u2192 Ga; \u2077\u00b2Ge \u2192 Ge; \u2077\u2075As \u2192 As; \u2079\u2079Ru \u2192 Ru; \u00b9\u2070\u00b3Rh \u2192 Rh; \u00b9\u2070\u2075Pd \u2192 Pd; \u00b9\u2078\u00b2W \u2192 W; \u00b9\u2078\u2075Re \u2192 Re; \u00b9\u2078\u2079Os \u2192 Os; \u00b9\u2079\u00b3Ir \u2192 Ir; \u00b9\u2079\u2075Pt \u2192 Pt; \u00b9\u2079\u2077Au \u2192 Au \u2014 Table 2, with relative abundances; for Fe and Ni the lower-abundance isotopes 'allow their measurement in the analog mode'"
        },
