@prefix ada: <https://ada.astromat.org/metadata/> .
@prefix bios: <https://bioschemas.org/> .
@prefix cdi: <http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix schema1: <http://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<ex:ebsdTAPP-P0> a cdi:Activity,
        schema1:Action,
        prov:Plan,
        ada:TAPPDefinition,
        bios:LabProtocol ;
    schema1:actionProcess [ a schema1:HowTo ;
            schema1:step [ a cdi:Activity,
                        schema1:Action,
                        schema1:HowToStep ;
                    schema1:additionalType "bios:LabProcess" ;
                    schema1:name "Data reduction" ;
                    schema1:position 2 ;
                    ada:crystalStructureFileSourcesDefault "HKL; ICSD; American Mineralogist" ;
                    ada:houghResolutionDefault "60" ;
                    ada:maximumMeanAngularDeviation "1.2 deg" ;
                    ada:minimumBandsForIndexing "5" ],
                [ a cdi:Activity,
                        schema1:Action,
                        schema1:HowToStep ;
                    schema1:additionalType "bios:LabProcess" ;
                    schema1:name "Data acquisition" ;
                    schema1:position 1 ;
                    ada:edsChannelsDefault "2024" ;
                    ada:edsProcessTimeDefault "5" ],
                [ a cdi:Activity,
                        schema1:Action,
                        schema1:HowToStep ;
                    schema1:additionalType "bios:LabProcess" ;
                    schema1:name "Sample preparation" ;
                    schema1:position -9999 ] ] ;
    schema1:creator [ a schema1:Person ;
            schema1:description "Draft generated by Claude (Anthropic) under human review, from analysis of ADA metadata records and the 14 Curtin University method-description documents attached to them. Parameter values and tier assignments are derived, not authored by the laboratory." ;
            schema1:name "Claude assisted" ] ;
    schema1:datePublished "2023-11-16" ;
    schema1:description "ebsdTAPP instance derived from ADA n=1354 | Nicholas E Timms | Curtin University | Tescan MIRA3 (14 method-description documents) (publication column of EBSD_TAPP_draft_v2.csv)." ;
    schema1:instrument <ex:instrument/SEM> ;
    schema1:measurementTechnique [ a schema1:DefinedTerm ;
            schema1:name "ebsd" ;
            schema1:termCode "ebsd" ] ;
    schema1:name "ebsd protocol — P0" ;
    ada:acceleratingVoltageDefault -9999 ;
    ada:analyticalMode "missing" ;
    ada:beamCurrentDefault -9999 ;
    ada:crystalStructureFileSourcesDefault "missing" ;
    ada:dataProcessingSoftwareDefault "missing" ;
    ada:ebsdCameraGain -9999 ;
    ada:ebsdCameraSpeedSetting "missing" ;
    ada:ebsdPatternResolution "missing" ;
    ada:edsChannelsDefault -9999 ;
    ada:edsDetector "missing" ;
    ada:edsProcessTimeDefault -9999 ;
    ada:houghResolutionDefault -9999 ;
    ada:instrumentManufacturer "Tescan" ;
    ada:instrumentModel "Tescan MIRA3" ;
    ada:maximumMeanAngularDeviation -9999 ;
    ada:minimumBandsForIndexing -9999 ;
    ada:samplePreparationMethodDefault "missing" ;
    ada:stageTilt "70 deg" .

<ex:instrument/SEM> a schema1:Product,
        schema1:Thing ;
    schema1:additionalType <https://www.wikidata.org/wiki/Q3099911>,
        "SEM" ;
    schema1:hasPart <ex:instrument/SEM/part/EBSD-Detector>,
        <ex:instrument/SEM/part/EDS-Detector> ;
    schema1:name "example instrumentName" ;
    ada:acceleratingVoltageDefault "20 kV" ;
    ada:beamCurrentDefault "~1.5 nA" .

<ex:instrument/SEM/part/EBSD-Detector> a schema1:Product,
        schema1:Thing ;
    schema1:additionalType <https://www.wikidata.org/wiki/Q3099911>,
        "EBSD Detector" ;
    schema1:name "missing" ;
    ada:ebsdCameraGain "2" ;
    ada:ebsdCameraSpeedSetting "Speed 1" ;
    ada:ebsdPatternResolution "622 x 512 pixels" .

<ex:instrument/SEM/part/EDS-Detector> a schema1:Product,
        schema1:Thing ;
    schema1:additionalType <https://www.wikidata.org/wiki/Q3099911>,
        "EDS Detector" ;
    schema1:model [ a schema1:ProductModel ;
            schema1:name "XMax 150 mm SDD" ] ;
    schema1:name "missing" .

