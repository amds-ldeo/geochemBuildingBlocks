        <https://ada.astromat.org/metadata/parameter/solutionQicpmsTAPP/reactionGasType> ;
    schema1:additionalType <https://www.wikidata.org/wiki/Q3099911>,
        "Collision Reaction Cell" ;
    schema1:name "N/A" .

