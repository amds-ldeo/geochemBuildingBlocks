@prefix ada: <https://ada.astromat.org/metadata/> .
@prefix bios: <https://bioschemas.org/> .
@prefix ex: <https://example.org/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix schema1: <http://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:icTAPP-P0 a schema1:Action,
        schema1:HowTo,
        prov:Plan,
        ada:TAPPDefinition,
        bios:LabProtocol ;
    schema1:actionProcess [ a schema1:HowTo ;
            schema1:name "Ion Chromatography analytical workflow" ;
            schema1:step [ a schema1:Action,
                        schema1:HowToStep ;
                    schema1:additionalType bios:LabProcess ;
                    schema1:description "no value available: schema:description" ;
                    schema1:name "Sample preparation" ;
                    schema1:position 1 ] ] ;
    schema1:creator [ a schema1:Person ;
            schema1:name "Peretyazhko, Tanya" ] ;
    schema1:datePublished "no value available: schema:datePublished" ;
    schema1:description "icTAPP instance derived from ADA n=2 | Peretyazhko, Tanya | NASA Johnson Space Center | DIONEX Integrion IC (publication column of IC_TAPP_draft_v2.csv). Reported detail: ada:instrumentManufacturer = DIONEX." ;
    schema1:funding [ a schema1:MonetaryGrant ;
            schema1:name "This material is supported by NASA under contract NNM10AA11C issued through the New Frontiers program." ] ;
    schema1:location [ a schema1:Place ;
            schema1:name "NASA Johnson Space Center" ] ;
    schema1:measurementTechnique [ a schema1:DefinedTerm ;
            schema1:termCode "Ion Chromatography" ] ;
    schema1:name "ic protocol — P0" ;
    schema1:variableMeasured [ schema1:defaultValue "no value available: schema:defaultValue" ;
            schema1:name "Calibration Factor and Determination Method" ] ;
    ada:constantsAndReferenceValuesUsedDefault "no value available: ada:constantsAndReferenceValuesUsedDefault" ;
    ada:instrumentManufacturer "Unknown" ;
    ada:instrumentModel "DIONEX Integrion IC" ;
    ada:reportedPropertyTemplate [ ada:defaultReportedProperties "Amount",
                "area",
                "height",
                "retention time",
                "sample name",
                "sample number" ;
            ada:reportedPropertyColumns [ schema1:name "no value available: schema:name" ;
                    schema1:readonlyValue true ;
                    schema1:valueName "reportedProperty" ;
                    schema1:valueRequired true ;
                    ada:cdifPropertyPath "#/schema:variableMeasured/schema:name" ;
                    ada:dataType "string" ;
                    ada:tier "M" ] ] ;
    ada:samplingUnitSelectionCriteriaDefault "no value available: ada:samplingUnitSelectionCriteriaDefault" ;
    ada:samplingUnitType "no value available: ada:samplingUnitType" ;
    ada:targetMaterial "missing" .

