    schema1:propertyID <https://ada.astromat.org/metadata/parameter/solutionSficpmsTAPP/interfaceConeConfiguration> ;
    schema1:value "Ni/Cu sampler (Spectron Inc.) + Ni skimmer (Spectron Inc.; Table 2)" .

