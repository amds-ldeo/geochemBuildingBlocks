      "schema:name": "ISO-Compass software (Zhang et al. 2020, J. Anal. At. Spectrom. 35, 1087\u20131096)"
    }
  ],
  "ada:ablationSamplingMode": [
    "Transect (continuous line scan at 2\u20136 \u00b5m s\u207b\u00b9)"
  ],
  "ada:analyteTemplate": {
