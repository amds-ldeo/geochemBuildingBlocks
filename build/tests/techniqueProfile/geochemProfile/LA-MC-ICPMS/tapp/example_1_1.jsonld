      "L1 (\u2078\u2075Rb)",
      "C (\u2078\u2076Sr)",
      "H1 (\u00b9\u2077\u00b3Yb\u00b2\u207a)",
      "H2 (\u2078\u2077Sr)",
      "H3 (\u2078\u2078Sr) (7 cups monitoring Kr, Rb, Er, Yb, Sr)"
    ],
