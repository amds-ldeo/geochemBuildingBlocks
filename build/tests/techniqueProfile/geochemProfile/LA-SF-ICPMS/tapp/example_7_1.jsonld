      "ada:dataType": "number",
      "ada:fieldScope": "session",
      "schema:defaultValue": 2,
      "schema:description": "Ar makeup gas, combined via a T-piece near the torch; Table 2 lists a nebulizer gas flow rate of 1.1 L/min \u2014 Table 2"
    },
