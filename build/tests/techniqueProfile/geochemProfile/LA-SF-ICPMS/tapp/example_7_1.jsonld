      "schema:name": "Transect Rate Mapping Rate or Step Size",
      "ada:dataType": "string",
      "ada:fieldScope": "session",
      "schema:defaultValue": "all: 10 \u00b5m/s \u2014 'scanning at a speed of 10 \u03bcm s\u22121'"
    },
