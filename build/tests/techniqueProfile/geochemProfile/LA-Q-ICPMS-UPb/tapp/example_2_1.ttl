    ada:dataType "string" .

<https://ada.astromat.org/metadata/targetSpeciesColumn/laQicpmsUPbTAPP/countingStatisticsError> a schema1:PropertyValueSpecification ;
    schema1:name "Counting Statistics Error" ;
