                        <https://example.org/laQicpmsUPbTAPP-detail-Liu2016/instrument/Laser-Ablation-System> ],
                [ bios:reagent [ a schema1:DefinedTerm ;
                            schema1:name "N — not stated" ;
                            ada:reagentRole "referenceMaterial" ] ] ;
