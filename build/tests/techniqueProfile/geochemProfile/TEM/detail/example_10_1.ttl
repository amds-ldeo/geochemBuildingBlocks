                                schema1:HowToStep ;
                            schema1:additionalProperty <https://ada.astromat.org/metadata/parameter/temTAPP/samplePreparationDetails> ;
                            schema1:description "FIB lift-out (Ga+)" ;
                            schema1:name "Sample preparation" ;
