      "schema:additionalProperty": [
        {
          "schema:name": "Target Material",
          "schema:value": [
            "Oxide (synthetic magnetite Fe3O4, 99.9% purity, Sigma Aldrich; dry-sieved <45 \u00b5m; pressed into pellets at 1500 psi)"
          ]
        }
      ]
    }
  ],
  "schema:actionProcess": {
