@prefix ada: <https://ada.astromat.org/metadata/> .
@prefix bios: <https://bioschemas.org/> .
@prefix ex: <https://example.org/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix schema1: <http://schema.org/> .
@prefix wd: <https://www.wikidata.org/entity/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:stemTAPP-P1 a schema1:Action,
        schema1:HowTo,
        prov:Plan,
        ada:TAPPDefinition,
        bios:LabProtocol ;
    schema1:actionProcess [ a schema1:HowTo ;
            schema1:name "Scanning Transmission Electron Microscopy analytical workflow" ;
            schema1:step [ a schema1:Action,
                        schema1:HowToStep ;
                    schema1:additionalType bios:LabProcess ;
                    schema1:description "no value available: schema:description" ;
                    schema1:name "Sample preparation" ;
                    schema1:position 1 ] ] ;
    schema1:creator [ a schema1:Person ;
            schema1:description "Draft generated by Claude (Anthropic) under human review, from analysis of ADA metadata records and the instrumentMetadata exports attached to them. Parameter values and tier assignments are derived, not authored by the laboratory." ;
            schema1:name "Claude assisted" ] ;
    schema1:datePublished "2023-12-07" ;
    schema1:description "stemTAPP instance derived from ADA n=694 | no named analyst | Lawrence Berkeley National Laboratory | FEI TitanX TEM (78 instrumentMetadata exports, dimensions only) (publication column of STEM_TAPP_draft_v2.csv). Reported detail: ada:instrumentManufacturer = FEI." ;
    schema1:instrument <https://example.org/stemTAPP-P1/instrument/STEM> ;
    schema1:location [ a schema1:Place ;
            schema1:identifier "https://ror.org/02jbv0t02" ;
            schema1:name "Lawrence Berkeley National Laboratory" ] ;
    schema1:measurementTechnique [ a schema1:DefinedTerm ;
            schema1:termCode "Scanning Transmission Electron Microscopy" ] ;
    schema1:name "stem protocol — P1" ;
    ada:analyticalMode "STEM" ;
    ada:constantsAndReferenceValuesUsedDefault "no value available: ada:constantsAndReferenceValuesUsedDefault" ;
    ada:instrumentManufacturer "Unknown" ;
    ada:instrumentModel "TitanX TEM" ;
    ada:samplingUnitSelectionCriteriaDefault "no value available: ada:samplingUnitSelectionCriteriaDefault" ;
    ada:samplingUnitType "no value available: ada:samplingUnitType" ;
    ada:targetMaterial "missing" .

<https://example.org/stemTAPP-P1/instrument/STEM> a schema1:Product,
        schema1:Thing ;
    schema1:additionalType wd:Q3099911,
        "STEM" ;
    schema1:name "missing" ;
    ada:acceleratingVoltage -9999 .

