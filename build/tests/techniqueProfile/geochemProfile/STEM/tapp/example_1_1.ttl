@prefix ada: <https://ada.astromat.org/metadata/> .
@prefix bios: <https://bioschemas.org/> .
@prefix cdi: <http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix schema1: <http://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<ex:stemTAPP-HF5000> a cdi:Activity,
        schema1:Action,
        prov:Plan,
        ada:TAPPDefinition,
        bios:LabProtocol ;
    schema1:actionProcess [ a schema1:HowTo ;
            schema1:name "missing" ;
            schema1:step [ a cdi:Activity,
                        schema1:Action,
                        schema1:HowToStep ;
                    schema1:additionalType bios:LabProcess ;
                    schema1:description "test value schema:description" ;
                    schema1:name "Sample preparation" ;
                    schema1:position 1 ] ] ;
    schema1:creator [ a schema1:Person ;
            schema1:description "Draft generated by Claude (Anthropic) under human review, from analysis of ADA metadata records and the instrumentMetadata exports attached to them. Parameter values and tier assignments are derived, not authored by the laboratory." ;
            schema1:name "Claude assisted" ] ;
    schema1:datePublished "2024-05-16" ;
    schema1:description "stemTAPP instance derived from ADA n=365 | Maizey, Beau | University of Arizona | Hitachi HF5000 (25 instrumentMetadata exports) (publication column of STEM_TAPP_draft_v2.csv). Reported detail: ada:instrumentManufacturer = Hitachi." ;
    schema1:instrument <ex:instrument/STEM> ;
    schema1:location [ a schema1:Place ;
            schema1:identifier "https://ror.org/03m2x1q45" ;
            schema1:name "University of Arizona" ] ;
    schema1:measurementTechnique [ a schema1:DefinedTerm ;
            schema1:termCode "Scanning Transmission Electron Microscopy" ] ;
    schema1:name "stem protocol — HF5000" ;
    ada:analyticalMode "STEM" ;
    ada:constantsAndReferenceValuesUsedDefault "missing" ;
    ada:instrumentManufacturer "Unknown" ;
    ada:instrumentModel "HF5000" ;
    ada:samplingUnitSelectionCriteriaDefault "missing" ;
    ada:samplingUnitType "missing" ;
    ada:targetMaterial "missing" .

<ex:instrument/STEM> a schema1:Product,
        schema1:Thing ;
    schema1:additionalType <https://www.wikidata.org/wiki/Q3099911>,
        "STEM" ;
    schema1:name "example instrumentName" ;
    ada:acceleratingVoltage "200 kV" .

