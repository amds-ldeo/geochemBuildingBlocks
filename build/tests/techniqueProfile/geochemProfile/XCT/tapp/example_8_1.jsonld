        "schema:PropertyValue"
      ],
      "schema:propertyID": [
        {
          "@id": "ada:parameter/labxctTAPP/detectorArraySize"
        }
      ],
      "schema:name": "Detector Array Size",
      "schema:value": "2000 \u00d7 2000 pixels"
    },
    {
