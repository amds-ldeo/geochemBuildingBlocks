            "@id": "ada:parameter/solutionMcicpmsTAPP/guardElectrode",
            "@type": [
              "schema:PropertyValue"
            ],
            "schema:propertyID": [
              {
                "@id": "ada:parameter/solutionMcicpmsTAPP/guardElectrode"
              }
            ],
            "schema:name": "Guard Electrode",
            "schema:value": "\"Pt-guard electrode: On, grounded\""
          }
        ],
        "@type": [
          "cdi:Activity",
          "schema:Action"
        ],
        "schema:additionalType": [
          "bios:LabProcess"
        ],
        "schema:position": 2
      },
      {
        "schema:name": "Data reduction",
