      "schema:name": "Number of Cycles per Block",
      "ada:dataType": "integer",
      "ada:fieldScope": "session",
      "schema:defaultValue": 40,
      "schema:description": "40 cycles in the main configuration; the subconfiguration measured twice"
    },
    {
