  "schema:name": "semFibsem protocol \u2014 Zega2025-8",
  "schema:description": "Multi-step milling: e-beam C deposition then FIB C capping, 30 kV \u2192 16 kV \u2192 5 kV; Pt weld to Cu half grids",
  "schema:object": [
    {
      "@type": [
