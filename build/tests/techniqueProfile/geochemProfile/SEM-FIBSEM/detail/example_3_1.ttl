                            schema1:description "Cuboidal samples (~0.5×1×1 cm) polished with dry emery paper and argon ion polishing; high-pressure freezing and freeze-drying; glued onto sample holder" ;
                            schema1:name "Sample preparation" ;
                            schema1:position 1 ],
                        [ a cdi:Activity,
