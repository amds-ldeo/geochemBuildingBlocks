@prefix ada: <https://ada.astromat.org/metadata/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix schema1: <http://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] prov:wasGeneratedBy [ prov:used [ schema1:additionalType "example value" ;
                    ada:laserFluence 1 ;
                    ada:laserRepetitionRate 1 ;
                    ada:laserSpotGeometry "example value" ] ;
            ada:ablationPitDepthRate "example value" ;
            ada:ablationSpotDuration 1 ;
            ada:rasterLineSpacing "example value" ] ;
    ada:spotDiameterMeasured 1 .

