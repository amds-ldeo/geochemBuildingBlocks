{
  "@context": [
    {
      "ada": "https://ada.astromat.org/metadata/",
      "bios": "https://bioschemas.org/",
      "schema": "http://schema.org/"
    },
    "https://raw.githubusercontent.com/amds-ldeo/geochemBuildingBlocks/undefined/build/annotated/BaseSchema/modules/solutionIntroduction/context.jsonld"
  ],
  "schema:object": [
    {
      "@type": "example value",
      "schema:additionalProperty": [
        {
          "schema:name": "Sample Aliquot Mass or Volume",
          "schema:defaultValue": 1
        }
      ]
    }
  ],
  "schema:actionProcess": {
    "schema:step": [
      {
        "schema:name": "sampleDigestion",
        "schema:additionalProperty": [
          {
            "schema:name": "Number of Digestion Steps",
            "schema:value": 1
          },
          {
            "schema:name": "Digestion Vessel Type",
            "schema:value": "example value"
          },
          {
            "schema:name": "Digestion Temperature",
            "schema:defaultValue": 1
          },
          {
            "schema:name": "Digestion Duration",
            "schema:defaultValue": "example value"
          }
        ],
        "bios:reagent": [
          {
            "schema:name": "example value"
          }
        ]
      }
    ]
  },
  "ada:chromatographicSeparationApplied": "example value",
  "ada:isotopeDilutionSpike": "example value",
  "ada:finalSolutionMatrix": "example value",
  "schema:instrument": [
    {
      "schema:additionalType": "example value",
      "schema:hasPart": [
        {
          "schema:additionalType": "example value",
          "schema:additionalProperty": [
            {
              "schema:name": "Nebulizer Type",
              "schema:value": "example value"
            },
            {
              "schema:name": "Spray Chamber Type and Cooling Temperature",
              "schema:value": "example value"
            },
            {
              "schema:name": "Sample Uptake Rate",
              "schema:defaultValue": 1
            },
            {
              "schema:name": "Nebulizer Gas Flow Rate",
              "schema:defaultValue": 1
            }
          ]
        }
      ]
    }
  ],
  "schema:additionalProperty": [
    {
      "schema:name": "Desolvation System",
      "schema:value": "example value"
    },
    {
      "schema:name": "Internal Standard Concentration",
      "schema:value": 1
    }
  ],
  "ada:washTimeBetweenSamples": 1
}