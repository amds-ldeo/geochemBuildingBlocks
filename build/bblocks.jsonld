    {
      "itemIdentifier": "ogch.BaseSchema.modules.analyte",
      "$schema": "metaschema.yaml",
      "name": "TAPP Composition Module: Analyte",
      "abstract": "The shared Analyte block of the 2026-08-11 TAPP library, composed by 13 of the sixteen delivery tables. 1 owned fields over 1 schema paths, split into the procedure and analysis halves a TAPP schema and a technique detail compose respectively. A profile over existing tappDefinition/adaProduct properties, not a new vocabulary. Generated from the module CSV and its schema-path sidecar.",
      "status": "under-development",
      "dateTimeAddition": "2026-08-13T00:00:00Z",
      "itemClass": "schema",
      "register": "cdif-building-block-register",
      "version": "0.1",
      "dateOfLastChange": "2026-09-12",
      "link": "https://github.com/amds-ldeo/geochemBuildingBlocks",
      "maturity": "draft",
      "scope": "unstable",
      "tags": [
        "ada",
        "astromat",
        "tapp",
        "composition-module",
        "profile",
        "analyte"
      ],
      "sources": [
        {
          "title": "TAPP Module Analyte (2026-08-11 library)",
          "link": "https://github.com/amds-ldeo/geochemBuildingBlocks"
