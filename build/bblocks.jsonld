    {
      "itemIdentifier": "ogch.techniqueProfile.geochemProfile.XANES.tapp",
      "$schema": "metaschema.yaml",
      "name": "XANES Technique-Aligned Procedure Profile (xanesTAPP)",
      "abstract": "X-ray absorption near edge structure spectroscopy extension of the base TAPP definition. CORE-ONLY DRAFT: the native technique layer is empty. XANES has no ADA detail schema and no technique property in any of its 241 ADA records, so there was nothing to seed one from and none was invented - no beamline energy range, monochromator or dwell time appears here. This registers the procedure skeleton and needs Phase 0 seed papers before it says anything XANES-specific. Generated from draftTAPPs/XANES_TAPP_draft_v2.csv by tools/build_tapp.py.",
      "status": "under-development",
      "dateTimeAddition": "2026-06-07T00:00:00Z",
