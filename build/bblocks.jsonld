    {
      "itemIdentifier": "ogch.techniqueProfile.geochemProfile.SEM-Imaging.detail",
      "$schema": "metaschema.yaml",
      "name": "SEM Imaging Analysis Detail",
      "abstract": "Detail block for SEM imaging hasPart items. Discriminates on ada:componentType, carries analysis-level required properties and an @id reference to a registered semImagingTAPP definition, and per-dataset schema:additionalProperty entries constrained via $refs to the parameterValues registry plus a catch-all. Generated by tools/build_tapp.py.",
      "status": "under-development",
      "dateTimeAddition": "2026-06-07T00:00:00Z",
      "itemClass": "schema",
      "register": "cdif-building-block-register",
      "version": "0.1",
      "dateOfLastChange": "2026-09-12",
      "link": "https://github.com/amds-ldeo/geochemBuildingBlocks",
      "maturity": "draft",
      "scope": "unstable",
      "tags": [
        "ada",
        "astromat",
        "instrument",
        "semimaging"
      ],
      "sources": [
        {
          "title": "SEM_Imaging_TAPP_v4.xlsx (TAPP worksheet)",
          "link": "https://github.com/amds-ldeo/geochemBuildingBlocks/tree/main/docs"
        }
      ],
      "shaclShapes": [
        {
          "prof:hasArtifact": [
            "https://amds-ldeo.github.io/geochemBuildingBlocks/_sources/BaseSchema/instrument/rules.shacl"
          ],
          "rdfs:seeAlso": "bblocks://ogch.BaseSchema.instrument",
          "prof:hasRole": "role:validation",
          "dct:format": "text/turtle",
          "dct:conformsTo": "shacl:"
