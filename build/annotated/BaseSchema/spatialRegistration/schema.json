{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spatial Registration Type",
  "description": "Defines pixel coordinate system registration including origin coordinates, pixel scales, and coordinate definition type for spatially registered images and maps.",
  "type": "object",
  "properties": {
    "ada:basemap": {
      "type": "string",
      "description": "link to appropriate basemap image map",
      "x-jsonld-id": "https://ada.astromat.org/metadata/basemap"
    },
    "ada:originX": {
      "type": "number",
      "x-jsonld-id": "https://ada.astromat.org/metadata/originX"
    },
    "ada:originY": {
      "type": "number",
      "x-jsonld-id": "https://ada.astromat.org/metadata/originY"
    },
    "ada:originZ": {
      "type": "number",
      "x-jsonld-id": "https://ada.astromat.org/metadata/originZ"
    },
    "ada:coordDef": {
      "type": "string",
      "description": "Whether coordinates are stage-defined or pixel-defined. If pixel-defined, are coordinates from stage, upperleftPixel, or centerPixel.",
      "x-jsonld-id": "https://ada.astromat.org/metadata/coordDef"
    },
    "ada:coordUnits": {
      "type": "string",
      "x-jsonld-id": "https://ada.astromat.org/metadata/coordUnits"
    },
    "ada:pixelUnits": {
      "type": "string",
      "x-jsonld-id": "https://ada.astromat.org/metadata/pixelUnits"
    },
    "ada:pixelScaleX": {
      "type": "number",
      "x-jsonld-id": "https://ada.astromat.org/metadata/pixelScaleX"
    },
    "ada:pixelScaleY": {
      "type": "number",
      "x-jsonld-id": "https://ada.astromat.org/metadata/pixelScaleY"
    },
    "ada:originLocation": {
      "type": "string",
      "description": "The location of the origin pixel of an image. Range: upperLeft, upperRight, lowerLeft, lowerRight, center",
      "x-jsonld-id": "https://ada.astromat.org/metadata/originLocation"
    }
  },
  "required": [
    "ada:originX",
    "ada:originY",
    "ada:pixelScaleX",
    "ada:pixelScaleY",
    "ada:pixelUnits",
    "ada:originLocation",
    "ada:coordDef"
  ],
  "x-jsonld-prefixes": {
    "ada": "https://ada.astromat.org/metadata/"
  }
}