{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TAPP Composition Module: SolutionIntroduction",
  "description": "The shared SolutionIntroduction block of the 2026-08-11 TAPP library (Claude Skills for TAPP/Module_SolutionIntroduction.csv), composed by 3 of the sixteen delivery tables. 16 owned fields over 5 schema paths.\n\nGENERATED by tools/build_module_bb.py from the module's CSV and its schema-path sidecar \u2014 edit those, not this file. Requiredness follows the TAPP tier matrix: a field Basic on a side is required there, Advanced is permitted, N/A is absent from that side entirely.\n\nThis is a PROFILE, not a vocabulary: it asserts which properties a conforming procedure or analysis carries. Column F (Example / Allowed Content) is consumer-owned per the module manifest, so no enum is pinned here \u2014 a consuming TAPP may narrow a value space, never widen it.",
  "$defs": {
    "ProcedureIdentification": {
      "title": "SolutionIntroduction on the procedure",
      "description": "Composed into a TAPP (prov:Plan) schema: what the procedure asserts once, for every analysis that follows it.",
      "type": "object",
      "properties": {
        "schema:actionProcess": {
          "type": "object",
          "properties": {
            "schema:step": {
              "type": "array",
              "items": {
                "type": "object",
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "schema:name": {
                          "const": "Sample digestion"
                        }
                      },
                      "required": [
                        "schema:name"
                      ]
                    },
                    "then": {
                      "properties": {
                        "bios:reagent": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "schema:name": {
                                "description": "Acid mixture used for sample dissolution. Record acid type(s) and concentration(s) where known (e.g., concentrated HF\u2013HNO3 in Parr bombs is standard for silicate dissolution). For isotope-ratio work, complete matrix dissolution is required to avoid isotopic fractionation during partial dissolution.",
                                "type": "string",
                                "x-jsonld-id": "http://schema.org/name"
                              }
                            }
                          },
                          "x-jsonld-id": "https://bioschemas.org/reagent"
                        }
                      }
                    }
                  }
                ]
              },
              "allOf": [
                {
                  "contains": {
                    "properties": {
                      "schema:name": {
                        "const": "Sample digestion"
                      }
                    },
                    "required": [
                      "schema:name"
                    ]
                  }
                }
              ],
              "x-jsonld-id": "http://schema.org/step"
            }
          },
          "x-jsonld-id": "http://schema.org/actionProcess"
        },
        "ada:chromatographicSeparationApplied": {
          "description": "Whether chromatographic separation of element groups (e.g., using ion exchange resin) was performed prior to analysis. Separation may be required to remove matrix elements that cause variable mass bias, to eliminate isobaric interferences, or to isolate an element group before measurement (e.g., Fe and Cu\u2013Zn for isotope dilution, Hf separation from REE, removal of Cr and Ni from Fe fractions). It is usually mandatory for isotope-ratio procedures and optional for concentration measurement. Record resin type and elution matrix conditions if applied. Record 'None' if the direct digestion solution is analyzed.",
          "type": "string",
          "x-jsonld-id": "https://ada.astromat.org/metadata/chromatographicSeparationApplied"
        },
        "ada:isotopeDilutionSpike": {
          "description": "Isotopic spike material added to the sample before or during digestion for isotope dilution (ID) analysis or double-spike mass bias correction. For double-spike procedures, the spike must be added and equilibrated before digestion to correct for any isotopic fractionation during dissolution and column chemistry. For concentration ID, the spike must be added before digestion for complete equilibration. Record spike name or certificate reference, spike isotopes, and whether added pre- or post-digestion. Record 'None' if ID or double-spike technique is not used.",
          "type": "string",
          "x-jsonld-id": "https://ada.astromat.org/metadata/isotopeDilutionSpike"
        },
        "ada:finalSolutionMatrix": {
          "description": "Acid type and concentration of the final dissolved sample solution introduced to the instrument. Directly affects instrument response and ion transmission. For isotope-ratio procedures, acid molarity must be precisely matched between samples and bracketing standards to avoid matrix-induced mass bias offsets. Procedures targeting HFSE may add trace HF to the final solution to keep those elements in solution.",
          "type": "string",
          "x-jsonld-id": "https://ada.astromat.org/metadata/finalSolutionMatrix"
        },
        "ada:washTimeBetweenSamples": {
          "description": "Duration of instrument rinse between successive sample solutions (seconds). Controls carryover and memory effects. For isotope-ratio work, complete washout is critical to prevent cross-contamination between samples with differing isotopic compositions.",
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "x-jsonld-id": "https://ada.astromat.org/metadata/washTimeBetweenSamples"
        }
      },
      "required": [
        "ada:chromatographicSeparationApplied",
        "ada:finalSolutionMatrix",
        "ada:isotopeDilutionSpike",
        "ada:washTimeBetweenSamples"
      ]
    },
