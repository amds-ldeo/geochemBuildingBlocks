                        {
                          "type": "string"
                        },
                        {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      ],
                      "x-jsonld-id": "https://ada.astromat.org/metadata/laserType"
                    },
                    "schema:name": {
                      "description": "Type, design origin, and internal volume of the ablation cell.",
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      ],
                      "x-jsonld-id": "http://schema.org/name"
                    },
                    "ada:laserSpotGeometryDefault": {
                      "description": "Shape and dimensions of the laser ablation spot in micrometres registered by the procedure. For circular spots, report diameter; for square or rectangular spots, report width \u00d7 length.",
