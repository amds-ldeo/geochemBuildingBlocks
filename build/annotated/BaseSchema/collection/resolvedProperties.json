{"defs":{},"properties":[{"path":["ada:componentType"],"id":"https://ada.astromat.org/metadata/componentType","description":"ADA componentType for a collection, as a single string. Allowed values are constrained at the technique-profile level (each adaProfile's schema:hasPart anyOf enumerates the allowed values for that technique, either inline or via a $ref to a detail<Tech> schema). No enum here so that profile-specific componentTypes (e.g. ada:XANESCollection, ada:LIT2DDataCollection) do not require updates to this branch schema.","schema_type":"string","enum":["ada:EAIRMSCollection","ada:EMPAImageCollection","ada:GCMSCollection","ada:LCMSCollection","ada:NanoSIMSCollection","ada:PSFDShapeFile","ada:QRISCalibratedCollection","ada:SEMImageCollection","ada:TOFSIMSCollection","ada:XCTImageCollection","ada:shapefile"],"sources":["bblocks://ogch.BaseSchema.collection"],"effectiveId":"https://ada.astromat.org/metadata/componentType"},{"path":["ada:memberTypes"],"id":"https://ada.astromat.org/metadata/memberTypes","description":"List of the component types in the collection","sources":["bblocks://ogch.BaseSchema.collection"],"effectiveId":"https://ada.astromat.org/metadata/memberTypes"},{"path":["ada:nFiles"],"id":"https://ada.astromat.org/metadata/nFiles","description":"Number of files in the collection, including metadata files","schema_type":"integer","sources":["bblocks://ogch.BaseSchema.collection"],"effectiveId":"https://ada.astromat.org/metadata/nFiles"},{"path":["ada:filelist"],"id":"https://ada.astromat.org/metadata/filelist","schema_type":"array","sources":["bblocks://ogch.BaseSchema.collection"],"effectiveId":"https://ada.astromat.org/metadata/filelist"},{"path":["ada:filelist","ada:fileName"],"id":"https://ada.astromat.org/metadata/fileName","description":"Full path to file in container object","schema_type":"string","sources":["bblocks://ogch.BaseSchema.collection"],"effectiveId":"https://ada.astromat.org/metadata/fileName"},{"path":["ada:filelist","ada:fileNamePattern"],"id":"https://ada.astromat.org/metadata/fileNamePattern","description":"Pattern for collection members with differentiating suffix at '*'","schema_type":"string","sources":["bblocks://ogch.BaseSchema.collection"],"effectiveId":"https://ada.astromat.org/metadata/fileNamePattern"},{"path":["ada:filelist","ada:componentType"],"id":"https://ada.astromat.org/metadata/componentType","description":"componentType of an individual file within the collection. Not constrained to the collection-level enum, since a collection holds heterogeneous files (each carrying its own file-type componentType).","schema_type":"string","sources":["bblocks://ogch.BaseSchema.collection"],"effectiveId":"https://ada.astromat.org/metadata/componentType"},{"path":["ada:filelist","schema:encodingFormat"],"id":"http://schema.org/encodingFormat","description":"MIME type with extension","schema_type":"array","sources":["bblocks://ogch.BaseSchema.collection"],"effectiveId":"http://schema.org/encodingFormat"}]}