{"defs":{"0":[{"path":["schema:additionalType"],"id":"http://schema.org/additionalType","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.organization"],"effectiveId":"http://schema.org/additionalType"},{"path":["schema:alternateName"],"id":"http://schema.org/alternateName","description":"other labels by which the organization might be known","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.organization"],"effectiveId":"http://schema.org/alternateName"},{"path":["schema:description"],"id":"http://schema.org/description","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.organization"],"effectiveId":"http://schema.org/description"},{"path":["schema:identifier"],"id":"http://schema.org/identifier","description":"identifier for organization","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.organization"],"effectiveId":"http://schema.org/identifier"},{"path":["schema:name"],"id":"http://schema.org/name","description":"string label for organization that is meaningful for human users","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.organization"],"effectiveId":"http://schema.org/name"},{"path":["schema:sameAs"],"id":"http://schema.org/sameAs","description":"other identifiers for the organization","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.organization"],"effectiveId":"http://schema.org/sameAs"}]},"properties":[{"path":["schema:additionalType"],"id":"http://schema.org/additionalType","description":"Domain-specific type classifications. Should include a scientific instrument type URI (e.g. wd:Q3099911 for Wikidata scientific instrument).","required":true,"schema_type":"array","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.instrument","bblocks://ogch.BaseSchema.instrument"],"effectiveId":"http://schema.org/additionalType"},{"path":["schema:name"],"id":"http://schema.org/name","description":"Human-readable name for this instrument.","required":true,"schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.instrument"],"effectiveId":"http://schema.org/name"},{"path":["schema:description"],"id":"http://schema.org/description","description":"Text description of this instrument, its purpose, and capabilities.","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.instrument"],"effectiveId":"http://schema.org/description"},{"path":["schema:alternateName"],"id":"http://schema.org/alternateName","description":"Alternate name(s), e.g. specific make/model designation, common abbreviation.","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.instrument"],"effectiveId":"http://schema.org/alternateName"},{"path":["schema:identifier"],"id":"http://schema.org/identifier","description":"Formal identifier(s) for this instrument. Use PropertyValue for structured identifiers (e.g. PIDINST, serial number, inventory number).","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.instrument"],"effectiveId":"http://schema.org/identifier"},{"path":["schema:url"],"id":"http://schema.org/url","description":"Landing page URL for this instrument.","schema_type":"string","format":"uri","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.instrument"],"effectiveId":"http://schema.org/url"},{"path":["schema:manufacturer"],"id":"http://schema.org/manufacturer","description":"Organization that manufactured this instrument.","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.instrument"],"ref":"0","effectiveId":"http://schema.org/manufacturer"},{"path":["schema:model"],"id":"http://schema.org/model","description":"Product model information for this instrument.","schema_type":"object","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.instrument"],"effectiveId":"http://schema.org/model"},{"path":["schema:model","schema:name"],"id":"http://schema.org/name","description":"Model name or number.","required":true,"schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.instrument"],"effectiveId":"http://schema.org/name"},{"path":["schema:model","schema:identifier"],"id":"http://schema.org/identifier","description":"Model identifier.","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.instrument"],"effectiveId":"http://schema.org/identifier"},{"path":["schema:category"],"id":"http://schema.org/category","description":"Instrument type classification(s) from a controlled vocabulary.","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.instrument"],"effectiveId":"http://schema.org/category"},{"path":["schema:owner"],"id":"http://schema.org/owner","description":"Organization that owns this instrument.","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.instrument"],"ref":"0","effectiveId":"http://schema.org/owner"},{"path":["schema:contributor"],"id":"http://schema.org/contributor","description":"Agents associated with this instrument in specific roles (e.g. operator, custodian, principal investigator). Use schema:owner for the owning organization.","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.instrument"],"effectiveId":"http://schema.org/contributor"},{"path":["schema:contributor","schema:roleName"],"id":"http://schema.org/roleName","required":true,"sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.agentInRole"],"effectiveId":"http://schema.org/roleName"},{"path":["schema:contributor","schema:contributor"],"id":"http://schema.org/contributor","required":true,"sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.agentInRole"],"effectiveId":"http://schema.org/contributor"},{"path":["schema:additionalProperty"],"id":"http://schema.org/additionalProperty","description":"Instrument-specific properties (measured variables, detection limits, calibration information, operating parameters, etc.). On a procedure / plan instrument (e.g. an instrument named directly on an ada:TAPPDefinition) these are schema:PropertyValueSpecification parameter templates (an overridable default); on a prov:used analysis-event instrument they are schema:PropertyValue concrete values. The JSON Schema accepts both; a profile SHACL rule pins which form applies in which context.","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.instrument"],"effectiveId":"http://schema.org/additionalProperty"},{"path":["schema:validFrom"],"id":"http://schema.org/validFrom","description":"Date the instrument was commissioned (ISO 8601).","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.instrument"],"effectiveId":"http://schema.org/validFrom"},{"path":["schema:validThrough"],"id":"http://schema.org/validThrough","description":"Date the instrument was decommissioned (ISO 8601). Absent if still operational.","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.instrument"],"effectiveId":"http://schema.org/validThrough"},{"path":["schema:hasPart"],"id":"http://schema.org/hasPart","description":"Sub-components of this instrument system. Each item is either an inline instrument description or an @id reference.","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.instrument","bblocks://ogch.BaseSchema.instrument"],"effectiveId":"http://schema.org/hasPart"},{"path":["schema:relatedLink"],"id":"http://schema.org/relatedLink","description":"Links to related resources (manuals, datasheets, calibration records, related instruments), each naming how the target relates to the instrument. Uses the same linkRole block as cdifCore; before 2026-09-23 this property was a labeled link here and a LinkRole there.","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.instrument"],"effectiveId":"http://schema.org/relatedLink"},{"path":["schema:relatedLink","schema:linkRelationship"],"id":"http://schema.org/linkRelationship","description":"How the target relates to the subject, as a controlled-vocabulary value or a plain string label. Required: a typed link whose relationship is unstated carries no more information than a bare URL, which is what schemaorgProperties/labeledLink is for.","required":true,"sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.linkRole"],"effectiveId":"http://schema.org/linkRelationship"},{"path":["schema:relatedLink","schema:target"],"id":"http://schema.org/target","description":"The entry point being linked to. Deliberately not sealed: real targets also carry schema:httpMethod, schema:urlTemplate, schema:contentType and domain-specific properties, and JSON-LD is open-world.","schema_type":"object","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.linkRole"],"effectiveId":"http://schema.org/target"},{"path":["schema:relatedLink","schema:target","schema:name"],"id":"http://schema.org/name","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.linkRole"],"effectiveId":"http://schema.org/name"},{"path":["schema:relatedLink","schema:target","schema:url"],"id":"http://schema.org/url","schema_type":"string","format":"uri","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.linkRole"],"effectiveId":"http://schema.org/url"},{"path":["schema:relatedLink","schema:target","schema:encodingFormat"],"id":"http://schema.org/encodingFormat","description":"registered MIME types are expected","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.linkRole"],"effectiveId":"http://schema.org/encodingFormat"},{"path":["schema:subjectOf"],"id":"http://schema.org/subjectOf","description":"Catalog record metadata-about-metadata for this instrument description.","schema_type":"object","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.instrument"],"effectiveId":"http://schema.org/subjectOf"},{"path":["schema:subjectOf","schema:dateModified"],"id":"http://schema.org/dateModified","description":"Date this metadata record was last modified (ISO 8601).","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.instrument"],"effectiveId":"http://schema.org/dateModified"},{"path":["schema:subjectOf","schema:about"],"id":"http://schema.org/about","schema_type":"object","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.instrument"],"effectiveId":"http://schema.org/about"},{"path":["schema:subjectOf","dcterms:conformsTo"],"description":"Schema or profile this metadata record conforms to.","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.instrument"]},{"path":["schema:contributor","schema:contributor","schema:sameAs"],"id":"http://schema.org/sameAs","description":"other identifiers for the person","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.person"],"effectiveId":"http://schema.org/sameAs"},{"path":["schema:contributor","schema:contributor","schema:contactPoint"],"id":"http://schema.org/contactPoint","description":"restrict to email only. Schema.org allows telephone and postal contacts as well","schema_type":"object","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.person"],"effectiveId":"http://schema.org/contactPoint"},{"path":["schema:contributor","schema:contributor","schema:contactPoint","schema:email"],"id":"http://schema.org/email","required":true,"schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.person"],"effectiveId":"http://schema.org/email"},{"path":["schema:contributor","schema:contributor","schema:affiliation"],"id":"http://schema.org/affiliation","description":"if affiliation is present, value must be a schema:Organization.","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.person"],"effectiveId":"http://schema.org/affiliation"},{"path":["schema:contributor","schema:contributor","schema:alternateName"],"id":"http://schema.org/alternateName","description":"other labels by which the person might be known","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.person"],"effectiveId":"http://schema.org/alternateName"},{"path":["schema:contributor","schema:contributor","schema:identifier"],"id":"http://schema.org/identifier","description":"identifier for person, recommend ORCID","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.person"],"effectiveId":"http://schema.org/identifier"},{"path":["schema:contributor","schema:contributor","schema:description"],"id":"http://schema.org/description","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.person"],"effectiveId":"http://schema.org/description"},{"path":["schema:contributor","schema:contributor","schema:name"],"id":"http://schema.org/name","description":"string label for person that is meaningful for human users, should format consistently. Recommend 'Family Name, Given name' format.","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.person"],"effectiveId":"http://schema.org/name"},{"path":["schema:additionalType","_anyOf","2"],"title":"a","sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"keyword":"branch"},{"path":["schema:additionalType","_anyOf","2","skos:narrower"],"id":"http://www.w3.org/2004/02/skos/core#narrower","description":"Narrower (child) concepts in the hierarchy. Items are inline concept objects or @id references.","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#narrower"},{"path":["schema:additionalType","_anyOf","2","skos:broader"],"id":"http://www.w3.org/2004/02/skos/core#broader","description":"Broader (parent) concepts in the hierarchy. Items are inline concept objects or @id references.","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#broader"},{"path":["schema:additionalType","_anyOf","2","skos:topConceptOf"],"id":"http://www.w3.org/2004/02/skos/core#topConceptOf","description":"Concept scheme(s) for which this is a top concept.","sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#topConceptOf"},{"path":["schema:additionalType","_anyOf","2","skos:inScheme"],"id":"http://www.w3.org/2004/02/skos/core#inScheme","description":"Concept scheme(s) this concept belongs to.","required":true,"sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#inScheme"},{"path":["schema:additionalType","_anyOf","2","skos:editorialNote"],"id":"http://www.w3.org/2004/02/skos/core#editorialNote","description":"Note for editors and maintainers.","sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#editorialNote"},{"path":["schema:additionalType","_anyOf","2","skos:changeNote"],"id":"http://www.w3.org/2004/02/skos/core#changeNote","description":"Note documenting a change.","sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#changeNote"},{"path":["schema:additionalType","_anyOf","2","skos:historyNote"],"id":"http://www.w3.org/2004/02/skos/core#historyNote","description":"Note about past state or use.","sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#historyNote"},{"path":["schema:additionalType","_anyOf","2","skos:note"],"id":"http://www.w3.org/2004/02/skos/core#note","description":"General note about this concept.","sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#note"},{"path":["schema:additionalType","_anyOf","2","skos:scopeNote"],"id":"http://www.w3.org/2004/02/skos/core#scopeNote","description":"Note clarifying meaning and/or intended use.","sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#scopeNote"},{"path":["schema:additionalType","_anyOf","2","skos:definition"],"id":"http://www.w3.org/2004/02/skos/core#definition","description":"Formal explanation of the meaning of this concept.","required":true,"sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#definition"},{"path":["schema:additionalType","_anyOf","2","skos:notation"],"id":"http://www.w3.org/2004/02/skos/core#notation","description":"Classification code for this concept within a scheme (a single notation string, consistent with CdifCodelistConcept).","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#notation"},{"path":["schema:additionalType","_anyOf","2","skos:prefLabel"],"id":"http://www.w3.org/2004/02/skos/core#prefLabel","description":"Preferred lexical label for this concept. A single string, a single language-tagged value, or an array of language-tagged values. Each language should appear at most once.","required":true,"sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#prefLabel"},{"path":["schema:additionalType","_anyOf","1","schema:termCode"],"id":"http://schema.org/termCode","description":"A representative code for this keyword in the controlled vocabulary. Analogous to skos:Notation","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.definedTerm"],"effectiveId":"http://schema.org/termCode"},{"path":["schema:additionalType","_anyOf","1","schema:inDefinedTermSet"],"id":"http://schema.org/inDefinedTermSet","description":"The controlled vocabulary responsible for this keyword, as EITHER a plain URI string identifying the vocabulary, OR an object reference ({\"@id\": \"<uri>\"}) to a vocabulary defined elsewhere in the document. Both forms are already in use across CDIF profiles and downstream ADA building blocks; permitting only the string form made the object form - the natural JSON-LD spelling of a reference - invalid, while this class's own union-type policy above explicitly anticipates both.","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.definedTerm"],"effectiveId":"http://schema.org/inDefinedTermSet"},{"path":["schema:additionalType","_anyOf","1","schema:identifier"],"id":"http://schema.org/identifier","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.definedTerm"],"effectiveId":"http://schema.org/identifier"},{"path":["schema:additionalType","_anyOf","1","schema:identifier","schema:propertyID"],"id":"http://schema.org/propertyID","description":"In this context for the schema:PropertyValue, this field is an identifier for the identifier schema, e.g. DOI, ARK.  Get values from https://registry.identifiers.org/registry/ for interoperability. URI-shape values MUST be serialized as JSON-LD IRI references ({\"@id\":\"...\"}) so they participate in RDF entailment; free-label strings remain valid as strings.","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.identifier"],"effectiveId":"http://schema.org/propertyID"},{"path":["schema:additionalType","_anyOf","1","schema:identifier","schema:value"],"id":"http://schema.org/value","description":"the identifier string. E.g. 10.5066/F7VX0DMQ","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.identifier"],"effectiveId":"http://schema.org/value"},{"path":["schema:additionalType","_anyOf","1","schema:identifier","schema:url"],"id":"http://schema.org/url","description":"web-resolveable string for the identifier; host name part is location of a resolver that will return some representation for the given identifier value. E.g. https://doi.org/10.5066/F7VX0DMQ ","schema_type":"string","format":"uri","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.identifier"],"effectiveId":"http://schema.org/url"},{"path":["schema:additionalType","_anyOf","1","schema:name"],"id":"http://schema.org/name","description":"text label for the term that is useful to human user","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.definedTerm"],"effectiveId":"http://schema.org/name"},{"path":["schema:additionalProperty","schema:name"],"id":"http://schema.org/name","required":true,"schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.additionalProperty","bblocks://cdif.bbr.metadata.schemaorgProperties.instrument"],"effectiveId":"http://schema.org/name"},{"path":["schema:additionalProperty","schema:unitText"],"id":"http://schema.org/unitText","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.additionalProperty"],"effectiveId":"http://schema.org/unitText"},{"path":["schema:additionalProperty","schema:unitCode"],"id":"http://schema.org/unitCode","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.additionalProperty"],"effectiveId":"http://schema.org/unitCode"},{"path":["schema:additionalProperty","schema:value"],"id":"http://schema.org/value","required":true,"sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.additionalProperty"],"effectiveId":"http://schema.org/value"},{"path":["schema:additionalProperty","schema:propertyID"],"id":"http://schema.org/propertyID","description":"identifier or name for the property concept quantified by the values in this variable slot. Multiple values can specify the property at different levels of granularity.","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.additionalProperty"],"effectiveId":"http://schema.org/propertyID"},{"path":["schema:hasPart","ada:collectors"],"description":"The collector table. One member per position when ada:collectorConfiguration parses into positions, and ONE member carrying the text as written when it does not -- the N=1 form of the flattening fallback that TAPP-keyed-values-design.md Decision 6 settles for every keyed axis: \"rather than admit two shapes, always emit the table: a declaration that does not parse into members yields a one-row table whose row key is the text as written. The fallback is then not a separate branch but N=1.\"\nSo a consumer reads one shape either way. In the N=1 form schema:name is a fixed label rather than a cup ('Collector configuration description'), schema:description carries the unparsed string, and the per-item values ride in schema:additionalProperty as name/value pairs. Parsing these strings to individual collectors is not tractable in general -- they are written for a person to read -- so N=1 is expected to be the common case, not the exception.\nThis exists because a cup label has to be referenceable WHEN there is one. A per-cup quantity (a baseline, a gain factor) and a monitored property that names the position reporting it both need something to point AT, and a label buried in a sentence is not something a consumer can join to. schema:name is that anchor.\nWhat a collector does NOT carry is which monitored property it measures. That assignment is procedure configuration, not hardware -- the same physical array is wired differently by another procedure, and an analysis may override it -- so it lives as the 'collector' column of ada:monitoredPropertyColumns on the method definition, whose values are these schema:names. Putting it here would invert the dependency and make the instrument description procedure-specific.\nNote what an N=1 member does NOT assert: it names no cup, so it makes no per-cup claim. That matters because the resistor values are attested per MASS, not per cup (Proposal_Monitored_Property_2026-09-10 \u00a710), and the fallback must not quietly move them onto the collector axis.","schema_type":"array","sources":["bblocks://ogch.BaseSchema.instrument"]},{"path":["schema:hasPart","ada:collectors","schema:additionalProperty"],"id":"http://schema.org/additionalProperty","description":"Quantities carried on this member as name/value pairs. In the parsed form these are per-position quantities that cannot be restated per mass -- a baseline, a gain factor. In the N=1 form they are the source fields themselves, each as its item name and the text as written, which is how an unparseable per-collector statement is preserved without inventing an assignment it does not make.","schema_type":"array","sources":["bblocks://ogch.BaseSchema.instrument"],"effectiveId":"http://schema.org/additionalProperty"},{"path":["schema:hasPart","ada:collectors","schema:additionalProperty","schema:value"],"id":"http://schema.org/value","description":"The value, as written when it did not parse.","sources":["bblocks://ogch.BaseSchema.instrument"],"effectiveId":"http://schema.org/value"},{"path":["schema:hasPart","ada:collectors","schema:additionalProperty","schema:name"],"id":"http://schema.org/name","description":"The item name, e.g. 'Faraday Cup Amplifier Resistor Values'.","required":true,"schema_type":"string","sources":["bblocks://ogch.BaseSchema.instrument"],"effectiveId":"http://schema.org/name"},{"path":["schema:hasPart","ada:collectors","schema:description"],"id":"http://schema.org/description","schema_type":"string","sources":["bblocks://ogch.BaseSchema.instrument"],"effectiveId":"http://schema.org/description"},{"path":["schema:hasPart","ada:collectors","schema:name"],"id":"http://schema.org/name","description":"The collector position label as the instrument names it -- L5..L1, C or Ax, H1..H5, IC1..IC8 on a Neptune-class multicollector. This is the identifier other properties reference. In the N=1 fallback there is no position to name, so it is the fixed label 'Collector configuration description' and nothing should join to it.","required":true,"schema_type":"string","sources":["bblocks://ogch.BaseSchema.instrument"],"effectiveId":"http://schema.org/name"},{"path":["schema:hasPart","ada:collectorConfiguration"],"description":"How masses are assigned to collector positions for this procedure, AS THE SOURCE STATES IT. Free text on purpose: submitters write this as prose or as a semicolon-separated list in no agreed syntax (\"L3=116Sn (Sn); L2=117Sn (Sn); Ax=120Sn ...\"), and in many cases it cannot be parsed at all. Recording the statement verbatim is what can always be done; ada:collectors below is what can sometimes be done as well. Meaningful on a component whose schema:additionalType includes 'Collector'.","schema_type":"string","sources":["bblocks://ogch.BaseSchema.instrument"]},{"path":["schema:hasPart","schema:model"],"id":"http://schema.org/model","schema_type":"object","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.instrument"],"effectiveId":"http://schema.org/model"},{"path":["schema:hasPart","schema:model","schema:identifier"],"id":"http://schema.org/identifier","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.instrument"],"effectiveId":"http://schema.org/identifier"},{"path":["schema:hasPart","schema:model","schema:name"],"id":"http://schema.org/name","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.instrument"],"effectiveId":"http://schema.org/name"},{"path":["schema:hasPart","schema:manufacturer"],"id":"http://schema.org/manufacturer","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.instrument"],"effectiveId":"http://schema.org/manufacturer"},{"path":["schema:hasPart","schema:additionalProperty"],"id":"http://schema.org/additionalProperty","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.instrument"],"effectiveId":"http://schema.org/additionalProperty"},{"path":["schema:hasPart","schema:additionalType"],"id":"http://schema.org/additionalType","description":"Component type classification.","required":true,"schema_type":"array","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.instrument","bblocks://ogch.BaseSchema.instrument"],"effectiveId":"http://schema.org/additionalType"},{"path":["schema:hasPart","schema:identifier"],"id":"http://schema.org/identifier","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.instrument"],"effectiveId":"http://schema.org/identifier"},{"path":["schema:hasPart","schema:alternateName"],"id":"http://schema.org/alternateName","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.instrument"],"effectiveId":"http://schema.org/alternateName"},{"path":["schema:hasPart","schema:description"],"id":"http://schema.org/description","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.instrument"],"effectiveId":"http://schema.org/description"},{"path":["schema:hasPart","schema:name"],"id":"http://schema.org/name","required":true,"schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.instrument","bblocks://ogch.BaseSchema.instrument"],"effectiveId":"http://schema.org/name"}]}