{"defs":{},"properties":[{"path":["ada:acquisitionTime"],"id":"https://ada.astromat.org/metadata/acquisitionTime","schema_type":"string","sources":["bblocks://ogch.BaseSchema.image"],"effectiveId":"https://ada.astromat.org/metadata/acquisitionTime"},{"path":["ada:componentType"],"id":"https://ada.astromat.org/metadata/componentType","description":"ADA componentType for an image, as a single string. Allowed values are constrained at the technique-profile level.","required":true,"schema_type":"string","enum":["ada:AIVAImage","ada:BSEImage","ada:CLImage","ada:CPDImage","ada:EPMAESPCPlot","ada:EPMAImage","ada:FIBSEMImage","ada:GCMSChromatogram","ada:GCMSSpectraPlot","ada:L2MSOverviewImage","ada:L2MSSpectraPlot","ada:LAICPMSImage","ada:LCMSChromatogram","ada:LCMSVisualization","ada:LITImage","ada:NanoIRBackground","ada:NanoSIMSImage","ada:PSFDContextImage","ada:QRISCalibrated","ada:QRISCalibratedImage","ada:QRISFlatFieldImage","ada:QRISRaw","ada:QRISRawImage","ada:SEMEDSPointSpectraPlot","ada:SEMFIBIonImage","ada:SEMHRCLimage","ada:SEMImage","ada:SIMSProcessedImage","ada:SLSShapeModelImage","ada:STEMEDSSpectraPlot","ada:STEMEELSSpectraPlot","ada:STEMImage","ada:SVRUECWaveformPlot","ada:SXRF2DImage","ada:TEMDiffractionPattern","ada:TEMImage","ada:TEMPatternsImage","ada:TOFSIMSIonImages","ada:TOFSIMSMassSpectrumPlot","ada:UVFMImage","ada:VLMImage","ada:VNMIROverviewImage","ada:VNMIRSpectraPlot","ada:XANESImageStack","ada:XANESStackOverviewImage","ada:XRDDiffractionPattern","ada:XRDIndexedImage","ada:plot","ada:analysisLocation","ada:annotatedImage","ada:areaOfInterest","ada:basemap","ada:calibrationFile","ada:code","ada:contextPhotography","ada:contextVideo","ada:inputFile","ada:instrumentMetadata","ada:logFile","ada:methodDescription","ada:other","ada:processingMethod","ada:quickLook","ada:report","ada:samplePreparation","ada:shapefile","ada:supplementalBasemap","ada:supplementaryImage","ada:worldFile","nil:missing"],"sources":["bblocks://ogch.BaseSchema.image"],"effectiveId":"https://ada.astromat.org/metadata/componentType"},{"path":["ada:channel1"],"id":"https://ada.astromat.org/metadata/channel1","schema_type":"string","sources":["bblocks://ogch.BaseSchema.image"],"effectiveId":"https://ada.astromat.org/metadata/channel1"},{"path":["ada:channel2"],"id":"https://ada.astromat.org/metadata/channel2","schema_type":"string","sources":["bblocks://ogch.BaseSchema.image"],"effectiveId":"https://ada.astromat.org/metadata/channel2"},{"path":["ada:channel3"],"id":"https://ada.astromat.org/metadata/channel3","schema_type":"string","sources":["bblocks://ogch.BaseSchema.image"],"effectiveId":"https://ada.astromat.org/metadata/channel3"},{"path":["ada:pixelSize"],"id":"https://ada.astromat.org/metadata/pixelSize","schema_type":"string","sources":["bblocks://ogch.BaseSchema.image"],"effectiveId":"https://ada.astromat.org/metadata/pixelSize"},{"path":["ada:illuminationType"],"id":"https://ada.astromat.org/metadata/illuminationType","description":"Type of illumination used to create the image. Examples include Visible light, Cross-polarized visible light, ultraviolet light, Electron beam, X-ray.","schema_type":"string","sources":["bblocks://ogch.BaseSchema.image"],"effectiveId":"https://ada.astromat.org/metadata/illuminationType"},{"path":["ada:imageType"],"id":"https://ada.astromat.org/metadata/imageType","description":"Specifies the nature of the sample's response to the illumination that was detected and measured.","schema_type":"string","sources":["bblocks://ogch.BaseSchema.image"],"effectiveId":"https://ada.astromat.org/metadata/imageType"},{"path":["ada:spatialRegistration"],"id":"https://ada.astromat.org/metadata/spatialRegistration","description":"Pixel size and its units. SCALING ONLY -- the half of a spatial registration an unregistered image can state. A plain image has a pixel size, and ada:pixelScaleX on an ada:EPMAImage is a well-formed statement, but an image does not say where it sits on the sample or how its axes relate to the sample axes. The imageMap block references the full shape, which adds the origin, the origin corner, the coordinate definition and the two rotation terms, and whose required list demands them.\nSame property NAME on both branches on purpose: a placement path such as schema:hasPart[@type=ada:image|ada:imageMap].ada:spatialRegistration.ada:pixelScaleX then resolves through either, which is what the subject-key register and the TAPP sidecars both target. Before this, the image branch declared no spatialRegistration at all -- not because a pixel scale is meaningless on an image, but because the only available shape required an origin and a corner, so an image could not use it without asserting a registration it does not have.","sources":["bblocks://ogch.BaseSchema.image"],"effectiveId":"https://ada.astromat.org/metadata/spatialRegistration"},{"path":["ada:spatialRegistration","ada:pixelUnits"],"id":"https://ada.astromat.org/metadata/pixelUnits","description":"Units of ada:pixelScaleX/Y, e.g. nm, um, mm. Normalise before comparing values.","schema_type":"string","sources":["bblocks://ogch.BaseSchema.spatialRegistration"],"effectiveId":"https://ada.astromat.org/metadata/pixelUnits"},{"path":["ada:spatialRegistration","ada:pixelScaleX"],"id":"https://ada.astromat.org/metadata/pixelScaleX","description":"CRS units per column step (world-file A).","schema_type":"number","sources":["bblocks://ogch.BaseSchema.spatialRegistration"],"effectiveId":"https://ada.astromat.org/metadata/pixelScaleX"},{"path":["ada:spatialRegistration","ada:pixelScaleY"],"id":"https://ada.astromat.org/metadata/pixelScaleY","description":"CRS units per row step (world-file E). A world file conventionally makes this NEGATIVE to encode the y-axis flip; here the sense is carried by ada:originLocation, so this is a magnitude.","schema_type":"number","sources":["bblocks://ogch.BaseSchema.spatialRegistration"],"effectiveId":"https://ada.astromat.org/metadata/pixelScaleY"}]}