{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ADA AMS Product Profile",
  "description": "Technique-specific profile for Accelerator Mass Spectrometry (AMS) products. Extends the base ADA product profile with constraints on valid AMS component types.",
  "allOf": [
    {
      "$ref": "https://amds-ldeo.github.io/geochemBuildingBlocks/build/annotated/profiles/adaProfiles/adaProduct/schema.json"
    },
    {
      "type": "object",
      "properties": {
        "schema:additionalType": {
          "description": "Must include a AMS product type identifier.",
          "contains": {
            "enum": [
              "Accelerator Mass Spectrometry (AMS)",
              "Accelerator Mass Spectrometry"
            ]
          },
          "x-jsonld-id": "http://schema.org/additionalType"
        },
        "schema:distribution": {
          "description": "Distribution items for adaAMS. Archive hasPart items must have ada:componentType from technique-specific or universal values.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "schema:hasPart": {
                "items": {
                  "type": "object",
                  "anyOf": [
                    {
                      "$ref": "https://amds-ldeo.github.io/geochemBuildingBlocks/build/annotated/profiles/adaProfiles/adaProduct/schema.json#/$defs/universalComponentTypeBranch"
                    },
                    {
                      "properties": {
                        "ada:componentType": {
                          "type": "string",
                          "enum": [
                            "ada:AMSRawData",
                            "ada:AMSProcessedData"
                          ]
                        }
                      },
                      "required": [
                        "ada:componentType"
                      ]
                    }
                  ]
                },
                "x-jsonld-id": "http://schema.org/hasPart"
              }
            }
          },
          "x-jsonld-id": "http://schema.org/distribution"
        },
        "schema:subjectOf": {
          "properties": {
            "dcterms:conformsTo": {
              "contains": {
                "type": "object",
                "properties": {
                  "@id": {
                    "const": "https://w3id.org/geochem/metadata/profiles/adaAMS"
                  }
                }
              },
              "x-jsonld-id": "http://purl.org/dc/terms/conformsTo"
            }
          },
          "x-jsonld-id": "http://schema.org/subjectOf"
        }
      }
    }
  ],
  "x-jsonld-prefixes": {
    "schema": "http://schema.org/",
    "ada": "https://ada.astromat.org/metadata/",
    "cdi": "http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/",
    "csvw": "http://www.w3.org/ns/csvw#",
    "prov": "http://www.w3.org/ns/prov#",
    "spdx": "http://spdx.org/rdf/terms#",
    "nxs": "http://purl.org/nexusformat/definitions/",
    "dcterms": "http://purl.org/dc/terms/",
    "geosparql": "http://www.opengis.net/ont/geosparql#"
  }
}