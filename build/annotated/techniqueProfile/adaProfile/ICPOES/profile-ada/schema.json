{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ADA ICP-OES Product Profile",
  "description": "Technique-specific profile for Inductively Coupled Plasma Optical Emission Spectrometry (ICP-OES) products. Extends the base ADA product profile with constraints on valid ICP-OES component types and detailICPOES requirements.",
  "allOf": [
    {
      "$ref": "https://amds-ldeo.github.io/geochemBuildingBlocks/build/annotated/BaseSchema/adaProduct/schema.json"
    },
    {
      "type": "object",
      "properties": {
        "schema:additionalType": {
          "description": "Must include a ICP-OES product type identifier.",
          "contains": {
            "enum": [
              "Inductively Coupled Plasma - Optical Emission Spectroscopy (ICPOES) Raw",
              "Inductively Coupled Plasma - Optical Emission Spectroscopy (ICPOES) Intermediate",
              "Inductively Coupled Plasma - Optical Emission Spectroscopy (ICPOES) Processed",
              "Inductively coupled plasma - optical emission spectrometry"
            ]
          },
          "x-jsonld-id": "http://schema.org/additionalType"
        },
        "schema:distribution": {
          "description": "Distribution items for adaICPOES. Archive hasPart items must have ada:componentType from technique-specific or universal values.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "schema:hasPart": {
                "items": {
                  "type": "object",
                  "anyOf": [
                    {
                      "$ref": "https://amds-ldeo.github.io/geochemBuildingBlocks/build/annotated/BaseSchema/adaProduct/schema.json#/$defs/universalComponentTypeBranch"
                    },
                    {
                      "$ref": "https://amds-ldeo.github.io/geochemBuildingBlocks/build/annotated/techniqueProfile/adaProfile/ICPOES/detail/schema.json"
                    }
                  ]
                },
                "x-jsonld-id": "http://schema.org/hasPart"
              }
            }
          },
          "x-jsonld-id": "http://schema.org/distribution"
        },
        "schema:subjectOf": {
          "properties": {
            "dcterms:conformsTo": {
              "contains": {
                "type": "object",
                "required": [
                  "@id"
                ],
                "additionalProperties": false,
                "properties": {
                  "@id": {
                    "const": "https://w3id.org/geochem/metadata/profiles/adaICPOES"
                  }
                }
              },
              "x-jsonld-id": "http://purl.org/dc/terms/conformsTo"
            }
          },
          "x-jsonld-id": "http://schema.org/subjectOf"
        }
      }
    }
  ],
  "x-jsonld-prefixes": {
    "schema": "http://schema.org/",
    "ada": "https://ada.astromat.org/metadata/",
    "cdi": "http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/",
    "csvw": "http://www.w3.org/ns/csvw#",
    "prov": "http://www.w3.org/ns/prov#",
    "spdx": "http://spdx.org/rdf/terms#",
    "nxs": "https://manual.nexusformat.org/classes/",
    "dcterms": "http://purl.org/dc/terms/",
    "geosparql": "http://www.opengis.net/ont/geosparql#"
  }
}