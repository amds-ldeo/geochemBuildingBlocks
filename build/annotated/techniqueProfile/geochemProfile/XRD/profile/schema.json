{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ADA XRD Product Profile",
  "description": "Path-driven technique-specific profile for ADA XRD Product Profile. Extends the base ADA product profile with the XRD analysis-instance detail on the schema:Dataset root, and pins the product type and the profile it declares conformance to.",
  "allOf": [
    {
      "$ref": "https://amds-ldeo.github.io/geochemBuildingBlocks/build/annotated/BaseSchema/geochemProduct/schema.json"
    },
    {
      "$ref": "https://amds-ldeo.github.io/geochemBuildingBlocks/build/annotated/techniqueProfile/geochemProfile/XRD/detail/schema.json"
    },
    {
      "type": "object",
      "properties": {
        "schema:additionalType": {
          "description": "Must include a XRD product type identifier.",
          "contains": {
            "enum": [
              "X-ray diffraction",
              "X-ray Diffraction (XRD) Tabular"
            ]
          },
          "title": "Product Type"
        },
        "schema:subjectOf": {
          "properties": {
            "dcterms:conformsTo": {
              "contains": {
                "type": "object",
                "properties": {
                  "@id": {
                    "const": "https://w3id.org/geochem/metadata/profiles/adaXRD"
                  }
                }
              }
            }
          },
          "title": "About This Record"
        }
      }
    }
  ],
  "x-bblocks-metadata": {
    "itemIdentifier": "ogch.techniqueProfile.geochemProfile.XRD.profile",
    "register": "https://amds-ldeo.github.io/geochemBuildingBlocks/build/register.json",
    "version": "0.1",
    "dateOfLastChange": "2026-11-11"
  }
}