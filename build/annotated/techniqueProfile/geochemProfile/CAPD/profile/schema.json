{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ADA Capacitance Dilatometry Product Profile",
  "description": "Path-driven technique-specific profile for ADA Capacitance Dilatometry Product Profile. Extends the base ADA product profile with the CAPD analysis-instance detail on the schema:Dataset root, and pins the product type and the profile it declares conformance to.",
  "allOf": [
    {
      "$ref": "https://amds-ldeo.github.io/geochemBuildingBlocks/build/annotated/BaseSchema/geochemProduct/schema.json"
    },
    {
      "$ref": "https://amds-ldeo.github.io/geochemBuildingBlocks/build/annotated/techniqueProfile/geochemProfile/CAPD/detail/schema.json"
    },
    {
      "type": "object",
      "properties": {
        "schema:additionalType": {
          "description": "Must include a CAPD product type identifier.",
          "contains": {
            "enum": [
              "Capacitance Dilatometry",
              "Capacitance Dilatometry (CAPD)"
            ]
          },
          "title": "Product Type"
        },
        "schema:subjectOf": {
          "properties": {
            "dcterms:conformsTo": {
              "contains": {
                "type": "object",
                "properties": {
                  "@id": {
                    "const": "https://w3id.org/geochem/metadata/profiles/adaCAPD"
                  }
                }
              }
            }
          },
          "title": "About This Record"
        }
      }
    }
  ],
  "x-bblocks-metadata": {
    "itemIdentifier": "ogch.techniqueProfile.geochemProfile.CAPD.profile",
    "register": "https://amds-ldeo.github.io/geochemBuildingBlocks/build/register.json",
    "version": "0.1",
    "dateOfLastChange": "2026-11-12"
  }
}