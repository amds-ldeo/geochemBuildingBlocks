    "ada:sourceToDetectorDistance": {
      "type": "string",
      "x-jsonld-id": "https://ada.astromat.org/metadata/sourceToDetectorDistance"
    },
    "ada:sourceToObjectDistance": {
      "type": "number",
      "x-jsonld-id": "https://ada.astromat.org/metadata/sourceToObjectDistance"
