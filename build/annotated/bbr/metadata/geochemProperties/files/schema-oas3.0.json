            "ada:TEMPatternsImage",
            "ada:TOFSIMSIonImages",
            "ada:TOFSIMSMassSpectrumPlot",
            "ada:UVFMImage",
            "ada:VLMImage",
            "ada:VNMIRSpectraPlot",
            "ada:XANESImageStack",
            "ada:XANESStackOverviewImage",
            "ada:XRDDiffractionPattern",
            "ada:XRDIndexedImage",
            "ada:plot"
