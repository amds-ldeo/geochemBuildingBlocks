{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NanoSIMS Instrument Detail",
  "description": "Nano Secondary Ion Mass Spectrometry with isotope tracking",
  "type": "object",
  "properties": {
    "ada:componentType": {
      "anyOf": [
        {
          "const": "ada:NanoSIMSCollection"
        },
        {
          "const": "ada:NanoSIMSImageCollection"
        },
        {
          "const": "ada:NanoSIMSTabular"
        },
        {
          "const": "ada:NanoSIMSMap"
        }
      ]
    },
    "ada:phaseAnalyzed": {
      "$ref": "https://usgin.github.io/geochemBuildingBlocks/build/annotated/bbr/metadata/geochemProperties/stringArray/schema.json"
    },
    "ada:isotopeAnalyzed": {
      "$ref": "https://usgin.github.io/geochemBuildingBlocks/build/annotated/bbr/metadata/geochemProperties/stringArray/schema.json"
    }
  },
  "required": [
    "ada:componentType"
  ],
  "x-jsonld-prefixes": {
    "schema": "http://schema.org/",
    "ada": "https://ada.astromat.org/metadata/"
  }
}