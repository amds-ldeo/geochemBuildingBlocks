rData"],"effectiveId":"http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/isDelimited"},{"path":["_anyOf","2","_oneOf","0","cdi:isFixedWidth"],"id":"http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/isFixedWidth","const":false,"sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifTabularData"],"effectiveId":"http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/isFixedWidth"},{"path":["_anyOf","2","_oneOf","1"],"title":"b","sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifTabularData"],"keyword":"branch"},{"path":["_anyOf","2","_oneOf","1","cdi:isDelimited"],"id":"http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/isDelimited","const":false,"sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifTabularData"],"effectiveId":"http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/isDelimited"},{"path":["_anyOf","2","_oneOf","1","cdi:isFixedWidth"],"id":"http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/isFixedWidth","required":true,"const":true,"sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifTabularData"],"effectiveId":"http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/isFixedWidth"},{"path":["_anyOf","2","cdi:arrayBase"],"id":"http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/arrayBase","schema_type":"integer","sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifTabularData"],"effectiveId":"http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/arrayBase"},{"path":["_anyOf","2","csvw:commentPrefix"],"description":"An atomic property that sets the comment prefix flag to the single provided value, which MUST be a string. The default is '#'.","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifTabularData"]},{"path":["_anyOf","2","csvw:delimiter"],"description":"Sets the delimiter flag to the single provided value, which MUST be a string. The default is ','.","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifTabularData"]},{"path":["_anyOf","2","csvw:header"],"description":"If true, sets the header row count flag to 1, and if false to 0, unless headerRowCount is provided, in which case the value provided for the header property is ignored. The default is true.","schema_type":"boolean","sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifTabularData"]},{"path":["_anyOf","2","csvw:headerRowCount"],"description":"A numeric atomic property that sets the header row count flag to the single provided value, which MUST be a non-negative integer.","schema_type":"integer","sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifTabularData"]},{"path":["_anyOf","2","cdi:isDelimited"],"id":"http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/isDelimited","description":"Schema constraint is that one of {'isDelimited','isFixedWidth'} must be present with a True value; the other one may be present or omitted, but if present must have a false value.","schema_type":"boolean","sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifTabularData"],"effectiveId":"http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/isDelimited"},{"path":["_anyOf","2","cdi:isFixedWidth"],"id":"http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/isFixedWidth","schema_type":"boolean","sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifTabularData"],"effectiveId":"http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/isFixedWidth"},{"path":["_anyOf","2","csvw:lineTerminators"],"schema_type":"string","enum":["CRLF","LF","\r\n","\n"],"sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifTabularData"]},{"path":["_anyOf","2","csvw:quoteChar"],"description":"Same as DDI-CDI quoteCharacter. The string that is used around escaped cells.","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifTabularData"]},{"path":["_anyOf","2","csvw:skipBlankRows"],"schema_type":"boolean","sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifTabularData"]},{"path":["_anyOf","2","csvw:skipColumns"],"description":"The number of columns to skip at the beginning of each row.","schema_type":"integer","sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifTabularData"]},{"path":["_anyOf","2","csvw:skipInitialSpace"],"schema_type":"boolean","sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifTabularData"]},{"path":["_anyOf","2","csvw:skipRows"],"description":"The number of rows to skip at the beginning of the file, before a header row or tabular data.","schema_type":"integer","sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifTabularData"]},{"path":["_anyOf","2","cdi:escapeCharacter"],"id":"http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/escapeCharacter","description":"The character used to escape special characters in the data. From DDI-CDI PhysicalSegmentLayout.escapeCharacter.","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifTabularData"],"effectiveId":"http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/escapeCharacter"},{"path":["_anyOf","2","cdi:headerIsCaseSensitive"],"id":"http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/headerIsCaseSensitive","description":"Whether column header names are case-sensitive. From DDI-CDI PhysicalSegmentLayout.headerIsCaseSensitive.","schema_type":"boolean","sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifTabularData"],"effectiveId":"http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/headerIsCaseSensitive"},{"path":["_anyOf","2","cdi:treatConsecutiveDelimitersAsOne"],"id":"http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/treatConsecutiveDelimitersAsOne","description":"Whether consecutive delimiters should be treated as a single delimiter. From DDI-CDI PhysicalSegmentLayout.treatConsecutiveDelimitersAsOne.","schema_type":"boolean","sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifTabularData"],"effectiveId":"http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/treatConsecutiveDelimitersAsOne"},{"path":["_anyOf","2","csvw:tableDirection"],"description":"Indicates the direction of the table layout (left-to-right or right-