@prefix rdf:         <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:        <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:          <http://www.w3.org/ns/shacl#> .
@prefix xsd:         <http://www.w3.org/2001/XMLSchema#> .
@prefix schema:      <http://schema.org/> .
@prefix ada:         <https://ada.astromat.org/metadata/> .
@prefix cdi:         <http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/> .
@prefix cdifd: <https://cdif.org/validation/0.1/shacl#> .
@base <https://www.ogc.org/rules/template/> .

# Validates structured-data file nodes typed as ada:structuredData: they must also be
# typed cdi:PhysicalDataSet and describe their layout with cdi:isStructuredBy.
cdifd:structuredDataShape
    a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            PREFIX ada: <https://ada.astromat.org/metadata/>
            SELECT ?this
            WHERE {
                ?this a ada:structuredData .
            }
        """ ;
    ] ;
    sh:property [
        sh:path rdf:type ;
        sh:hasValue cdi:PhysicalDataSet ;
        sh:message "Structured-data file nodes must also be typed as cdi:PhysicalDataSet." ;
    ] ;
    sh:property [
        sh:path cdi:isStructuredBy ;
        sh:minCount 1 ;
        sh:message "A structured-data file must describe its layout with cdi:isStructuredBy." ;
    ] ;
    sh:message "Structured-data file nodes (ada:structuredData) must be typed cdi:PhysicalDataSet and carry cdi:isStructuredBy." ;
    .
