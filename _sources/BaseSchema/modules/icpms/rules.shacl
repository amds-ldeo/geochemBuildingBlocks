cdifd:iCPMSAnalysisIdentificationShape
    a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            SELECT ?this
            WHERE {
                ?this a <http://schema.org/Dataset> .
            }
        """ ;
    ] ;
    sh:property [
        sh:path dqv:hasQualityMeasurement ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "ICPMS requires dqv:hasQualityMeasurement on the analysis." ;
    ] ;
    sh:property [
        sh:path schema:variableMeasured ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "ICPMS requires schema:variableMeasured on the analysis." ;
    ] ;
    sh:message "ICPMS AnalysisIdentification required properties." ;
    .
