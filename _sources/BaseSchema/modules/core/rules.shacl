cdifd:coreAnalysisIdentificationShape
    a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            SELECT ?this
            WHERE {
                ?this a <http://schema.org/Dataset> .
            }
        """ ;
    ] ;
    sh:property [
        sh:path prov:wasGeneratedBy ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "Core requires prov:wasGeneratedBy on the analysis." ;
    ] ;
    sh:property [
        sh:path schema:contributor ;
        sh:minCount 1 ;
