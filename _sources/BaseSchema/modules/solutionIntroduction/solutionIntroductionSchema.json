{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "TAPP Composition Module: SolutionIntroduction",
    "description": "The shared SolutionIntroduction block of the 2026-08-11 TAPP library (Claude Skills for TAPP/Module_SolutionIntroduction.csv), composed by 3 of the sixteen delivery tables. 16 owned fields over 5 schema paths.\n\nGENERATED by tools/build_module_bb.py from the module's CSV and its schema-path sidecar — edit those, not this file. Requiredness follows the TAPP tier matrix: a field Basic on a side is required there, Advanced is permitted, N/A is absent from that side entirely.\n\nThis is a PROFILE, not a vocabulary: it asserts which properties a conforming procedure or analysis carries. Column F (Example / Allowed Content) is consumer-owned per the module manifest, so no enum is pinned here — a consuming TAPP may narrow a value space, never widen it.",
    "$defs": {
        "ProcedureIdentification": {
            "title": "SolutionIntroduction on the procedure",
            "description": "Composed into a TAPP (prov:Plan) schema: what the procedure asserts once, for every analysis that follows it.",
            "type": "object",
            "properties": {
                "schema:actionProcess": {
                    "type": "object",
                    "properties": {
                        "schema:step": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "allOf": [
                                    {
                                        "if": {
                                            "properties": {
                                                "schema:name": {
                                                    "const": "Sample digestion"
                                                }
                                            },
                                            "required": [
                                                "schema:name"
                                            ]
                                        },
                                        "then": {
                                            "properties": {
                                                "bios:reagent": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "object",
                                                        "properties": {
                                                            "schema:name": {
                                                                "description": "Acid mixture used for sample dissolution. Record acid type(s) and concentration(s) where known (e.g., concentrated HF–HNO3 in Parr bombs is standard for silicate dissolution).",
                                                                "type": "string"
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                ]
                            },
                            "allOf": [
                                {
                                    "contains": {
                                        "properties": {
                                            "schema:name": {
                                                "const": "Sample digestion"
                                            }
                                        },
                                        "required": [
                                            "schema:name"
                                        ]
                                    }
                                }
                            ]
                        }
                    }
                },
                "ada:chromatographicSeparationApplied": {
                    "description": "Whether chromatographic separation of element groups (e.g., using ion exchange resin) was performed prior to analysis. Record resin type and elution matrix conditions if applied. Record 'None' if the direct digestion solution is analyzed.",
                    "type": "string"
                },
                "ada:isotopeDilutionSpike": {
                    "description": "Isotopic spike material added to the sample before or during digestion for isotope dilution (ID) analysis or double-spike mass bias correction. For double-spike procedures, add and equilibrate the spike before digestion. For concentration ID, the spike must be added before digestion for complete equilibration. Record spike name or certificate reference, spike isotopes, and whether added pre- or post-digestion. Record 'None' if ID or double-spike technique is not used.",
                    "type": "string"
                },
                "ada:finalSolutionMatrix": {
                    "description": "Acid type and concentration of the final dissolved sample solution introduced to the instrument. For isotope-ratio procedures, match acid molarity precisely between samples and bracketing standards. Procedures targeting HFSE may add trace HF to the final solution to keep those elements in solution.",
                    "type": "string"
                },
                "ada:washTimeBetweenSamples": {
                    "description": "Duration of instrument rinse between successive sample solutions (seconds).",
                    "anyOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "string"
                        }
                    ]
                }
            },
            "required": [
                "ada:chromatographicSeparationApplied",
                "ada:finalSolutionMatrix",
                "ada:isotopeDilutionSpike",
                "ada:washTimeBetweenSamples"
            ]
        },
