cdifd:aggregationAnalysisIdentificationShape
    a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            SELECT ?this
            WHERE {
                ?this a <http://schema.org/Dataset> .
            }
        """ ;
    ] ;
    sh:property [
        sh:path dqv:hasQualityMeasurement ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "Aggregation requires dqv:hasQualityMeasurement on the analysis." ;
    ] ;
    sh:property [
        sh:path prov:wasGeneratedBy ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "Aggregation requires prov:wasGeneratedBy on the analysis." ;
    ] ;
    sh:message "Aggregation AnalysisIdentification required properties." ;
    .
