@prefix rdf:         <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:        <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:          <http://www.w3.org/ns/shacl#> .
@prefix xsd:         <http://www.w3.org/2001/XMLSchema#> .
@prefix schema:      <http://schema.org/> .
@prefix nxs:         <https://manual.nexusformat.org/classes/> .
@prefix cdifd: <https://cdif.org/validation/0.1/shacl#> .
@base <https://www.ogc.org/rules/template/> .

# Validates laboratory/facility nodes classified as nxs:BaseClass/NXsource.
#
# The classification lives in schema:additionalType, not in @type: the
# JSON schema types the node "schema:Place" and requires
# schema:additionalType to contain "nxs:BaseClass/NXsource". This shape
# targeted `?this a <.../BaseClass/NXsource>` -- rdf:type -- and so
# selected nothing in any of the 74 examples, and the name constraint
# below had never run.
#
# The value is a sealed reference ({"@id": ...}), so JSON-LD expands it
# and the target matches an IRI. It was a bare string until 2026-08-26,
# which JSON-LD keeps as a literal -- a value that looked like a URI and
# resolved to nothing.
cdifd:laboratoryShape
    a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            PREFIX schema: <http://schema.org/>
            SELECT ?this
            WHERE {
                ?this schema:additionalType <https://manual.nexusformat.org/classes/base_classes/NXsource.html> .
            }
        """ ;
    ] ;
    sh:property [
        sh:path schema:name ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Warning ;
        sh:message "A laboratory or facility should have a name (schema:name)." ;
    ] ;
    sh:message "Laboratory nodes (nxs:BaseClass/NXsource) should have a name." ;
    .
