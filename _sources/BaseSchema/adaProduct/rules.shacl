@prefix rdf:         <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:        <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:          <http://www.w3.org/ns/shacl#> .
@prefix xsd:         <http://www.w3.org/2001/XMLSchema#> .
@prefix schema:      <http://schema.org/> .
@prefix prov:        <http://www.w3.org/ns/prov#> .
@prefix ada:         <https://ada.astromat.org/metadata/> .
@prefix cdi:         <http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/> .
@prefix dcterms:     <http://purl.org/dc/terms/> .
@prefix cdifd: <https://cdif.org/validation/0.1/shacl#> .
@base <https://www.ogc.org/rules/template/> .

# ADA-specific constraints for product metadata.
# Does NOT duplicate inherited cdifCore rules (identifier, name, license, dateModified).
# Targets root Dataset+Product nodes only (excludes nested datasets like subjectOf).

cdifd:adaProductShape
    a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            PREFIX schema: <http://schema.org/>
            SELECT ?this
            WHERE {
                ?this a schema:Dataset .
                ?this a schema:Product .
                MINUS {
                    ?parent a schema:Dataset .
                    ?parent ?p ?this .
                    FILTER (?parent != ?this)
                    FILTER (?p != schema:about)
                }
            }
        """ ;
    ] ;
    sh:property [
        sh:path rdf:type ;
        sh:hasValue schema:Product ;
        sh:message "ADA product nodes must be typed as schema:Product." ;
    ] ;
    sh:property [
        sh:path schema:additionalType ;
        sh:minCount 1 ;
        sh:message "ADA products must have at least one schema:additionalType identifying the product type." ;
    ] ;
    sh:property [
        sh:path schema:creator ;
        sh:minCount 1 ;
        sh:message "ADA products must have at least one creator (schema:creator)." ;
    ] ;
    sh:property [
        sh:path prov:wasGeneratedBy ;
        sh:minCount 1 ;
        sh:message "ADA products must describe the analysis event(s) that generated the data (prov:wasGeneratedBy)." ;
    ] ;
    sh:property [
        sh:path schema:distribution ;
        sh:minCount 1 ;
        sh:message "ADA products must have at least one distribution (schema:distribution)." ;
    ] ;
    sh:message "ADA product metadata (Dataset + Product) must include additionalType, creator, wasGeneratedBy, and distribution." ;
    .

# Validates prov:Activity nodes linked from ADA products via prov:wasGeneratedBy.
cdifd:adaActivityShape
    a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            PREFIX schema: <http://schema.org/>
            PREFIX prov: <http://www.w3.org/ns/prov#>
            SELECT ?this
            WHERE {
                ?product a schema:Product .
                ?product prov:wasGeneratedBy ?this .
                ?this a prov:Activity .
            }
        """ ;
    ] ;
    sh:property [
        sh:path rdf:type ;
        sh:hasValue prov:Activity ;
        sh:message "Analysis event nodes must be typed as prov:Activity." ;
    ] ;
    # An activity must say what it acted on, in one of the three ways CDIF accepts.
    #
    # This replaced `sh:path prov:used ; sh:minCount 1`, retired by the 2026-11-11 CDIF
    # activity-used-resources change: schema:instrument became the ONE array holding
    # instruments, computational tools and reagents, told apart by a Wikidata kind term,
    # and geochemBaseProfile closes off the prov:used wrappers by name. The stale rule
    # demanded a property no conforming record is permitted to carry, so it fired on
    # every analysis event its target selected -- 38 of the corpus's 46 violations.
    #
    # The disjunction is CDIF's, copied from cdifProvActivity/rules.shacl rather than
    # restated: an sh:or over schema:instrument / schema:object / schema:actionProcess,
    # because not every activity is instrumental -- one may instead name the material it
    # acted on, or the procedure it followed. That is LOOSER than requiring
    # schema:instrument outright, and it costs nothing here: all 112 activities the
    # target selects carry schema:instrument and satisfy the first disjunct.
    #
    # NOTE this duplicates CDIF's own rule, which is tolerable only while CDIF's shapes
    # do not run here -- `vendor/shapes/` is empty, so 0 of its 69 rules.shacl load and
    # every run says so. Once they are vendored, cdifProvActivityShape targets exactly
    # the same 112 nodes (measured: gBB's product-rooted target and CDIF's dual-typed
    # one select the same set over this corpus), and this becomes a second home for one
    # fact. Delete it then, and let the upstream rule carry it.
    sh:or (
        [ sh:path schema:instrument ; sh:minCount 1 ]
        [ sh:path schema:object ; sh:minCount 1 ]
        [ sh:path schema:actionProcess ; sh:minCount 1 ]
    ) ;
    sh:message "ADA analysis events (prov:Activity) must say what they acted on: at least one of schema:instrument, schema:object or schema:actionProcess." ;
    .

# Validates variableMeasured nodes under ADA products.
# JSON schema requires dual typing (schema:PropertyValue + cdi:InstanceVariable),
# schema:name, and schema:description with minLength 10.
cdifd:adaVariableMeasuredShape
    a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            PREFIX schema: <http://schema.org/>
            SELECT ?this
            WHERE {
                ?product a schema:Product .
                ?product schema:variableMeasured ?this .
            }
        """ ;
    ] ;
    sh:property [
        sh:path rdf:type ;
        sh:hasValue schema:PropertyValue ;
        sh:message "Variable nodes must be typed as schema:PropertyValue." ;
    ] ;
    sh:property [
        sh:path rdf:type ;
        sh:hasValue <http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/InstanceVariable> ;
        sh:message "Variable nodes must also be typed as cdi:InstanceVariable." ;
    ] ;
    sh:property [
        sh:path schema:name ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Each variable must have a name (schema:name)." ;
    ] ;
    sh:property [
        sh:path schema:description ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:minLength 3 ;
        sh:message "Each variable must have a description (schema:description) of at least 3 characters." ;
    ] ;
    sh:property [
        sh:path schema:description ;
        sh:minLength 30 ;
        sh:severity sh:Info ;
        sh:message "Variable description is short; expanding it to at least 30 characters improves discoverability." ;
    ] ;
    sh:message "ADA variableMeasured nodes must have dual types (PropertyValue + InstanceVariable), a name, and a description." ;
    .
