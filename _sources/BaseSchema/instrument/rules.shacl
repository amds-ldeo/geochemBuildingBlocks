@prefix rdf:         <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:        <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:          <http://www.w3.org/ns/shacl#> .
@prefix xsd:         <http://www.w3.org/2001/XMLSchema#> .
@prefix schema:      <http://schema.org/> .
@prefix prov:        <http://www.w3.org/ns/prov#> .
@prefix nxs:         <https://manual.nexusformat.org/classes/> .
@prefix cdifd: <https://cdif.org/validation/0.1/shacl#> .
@base <https://www.ogc.org/rules/template/> .

# Validates ADA instrument nodes typed as schema:Product.
# Extends core instrument BB with additionalType requirement.
cdifd:adaInstrumentShape
    a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            PREFIX schema: <http://schema.org/>
            SELECT ?this
            WHERE {
                ?s schema:instrument ?this .
                ?this a schema:Product .
            }
        """ ;
    ] ;
    sh:property [
        sh:path schema:name ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "An instrument must have a name (schema:name)." ;
    ] ;
    sh:property [
        sh:path schema:identifier ;
        sh:minCount 1 ;
        sh:message "An instrument must have an identifier (schema:identifier)." ;
    ] ;
    sh:message "ADA instrument nodes (schema:Product used in prov:Activity) must have a name and identifier." ;
    .

# Context-dependent shape of instrument schema:additionalProperty entries.
# The JSON Schema accepts either schema:PropertyValue or schema:PropertyValueSpecification
# on an instrument; the intended form depends on where the instrument sits:
#
#   - On an ada:TAPPDefinition (a prov:Plan / procedure), instrument parameters are
#     PARAMETER TEMPLATES an analyst may override -> schema:PropertyValueSpecification
#     (the value is a schema:defaultValue).
#   - On a prov:used analysis-event instrument (the concrete run), instrument parameters
#     carry the ACTUAL value used -> schema:PropertyValue (the value is a schema:value).
#
# These two shapes pin the correct form per context.

cdifd:tappInstrumentParamSpecShape
    a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            PREFIX ada: <https://ada.astromat.org/metadata/>
            PREFIX schema: <http://schema.org/>
            SELECT ?this
            WHERE {
                ?tapp a ada:TAPPDefinition ;
                      schema:instrument ?this .
            }
        """ ;
    ] ;
    sh:property [
        sh:path schema:additionalProperty ;
        sh:class schema:PropertyValueSpecification ;
        sh:severity sh:Violation ;
        sh:message "On an ada:TAPPDefinition, an instrument's schema:additionalProperty entries must be schema:PropertyValueSpecification (overridable parameter templates), not schema:PropertyValue." ;
    ] ;
    .

cdifd:provUsedInstrumentParamValueShape
    a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            PREFIX prov: <http://www.w3.org/ns/prov#>
            PREFIX schema: <http://schema.org/>
            SELECT ?this
            WHERE {
                ?activity prov:used ?used .
                ?used schema:instrument ?this .
            }
        """ ;
    ] ;
    sh:property [
        sh:path schema:additionalProperty ;
        sh:class schema:PropertyValue ;
        sh:severity sh:Violation ;
        sh:message "On a prov:used analysis-event instrument, schema:additionalProperty entries must be schema:PropertyValue (concrete values), not schema:PropertyValueSpecification." ;
    ] ;
    .
