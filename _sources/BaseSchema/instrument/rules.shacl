@prefix rdf:         <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:        <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:          <http://www.w3.org/ns/shacl#> .
@prefix xsd:         <http://www.w3.org/2001/XMLSchema#> .
@prefix schema:      <http://schema.org/> .
@prefix prov:        <http://www.w3.org/ns/prov#> .
@prefix nxs:         <https://manual.nexusformat.org/classes/> .
@prefix cdifd: <https://cdif.org/validation/0.1/shacl#> .
@base <https://www.ogc.org/rules/template/> .

# Validates ADA instrument nodes typed as schema:Product.
# Extends core instrument BB with additionalType requirement.
cdifd:adaInstrumentShape
    a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            PREFIX schema: <http://schema.org/>
            SELECT ?this
            WHERE {
                ?s schema:instrument ?this .
                ?this a schema:Product .
            }
        """ ;
    ] ;
    sh:property [
        sh:path schema:name ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "An instrument must have a name (schema:name)." ;
    ] ;
    sh:property [
        sh:path schema:identifier ;
        sh:minCount 1 ;
        # Advisory, not a hard requirement. 1010 instrument nodes in the corpus
        # carry a real manufacturer and model but no schema:identifier, against
        # 237 that have one, and many are publication-derived: a paper naming
        # "JEOL JXA-8900 Superprobe" states no instrument ID, and there is none
        # to transcribe. A sh:Violation there asserts a completeness the sources
        # cannot supply, and the alternative -- padding a nil sentinel to clear
        # the check -- would satisfy the shape while asserting that an
        # identifiable instrument is unidentified.
        sh:severity sh:Warning ;
        sh:message "An instrument should have an identifier (schema:identifier)." ;
    ] ;
    sh:message "ADA instrument nodes (schema:Product used in prov:Activity) must have a name; an identifier is advisory." ;
    .

# Context-dependent shape of instrument schema:additionalProperty entries.
# The JSON Schema accepts either schema:PropertyValue or schema:PropertyValueSpecification
# on an instrument; the intended form depends on where the instrument sits:
#
#   - On an ada:TAPPDefinition (a prov:Plan / procedure), instrument parameters are
#     PARAMETER TEMPLATES an analyst may override -> schema:PropertyValueSpecification
#     (the value is a schema:defaultValue).
#   - On an analysis-event instrument, reached through prov:wasGeneratedBy (the concrete
#     run), instrument parameters carry the ACTUAL value used -> schema:PropertyValue
#     (the value is a schema:value).
#
# These two shapes pin the correct form per context.

cdifd:tappInstrumentParamSpecShape
    a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            PREFIX ada: <https://ada.astromat.org/metadata/>
            PREFIX schema: <http://schema.org/>
            SELECT ?this
            WHERE {
                ?tapp a ada:TAPPDefinition ;
                      schema:instrument ?this .
            }
        """ ;
    ] ;
    sh:property [
        sh:path schema:additionalProperty ;
        sh:class schema:PropertyValueSpecification ;
        sh:severity sh:Violation ;
        sh:message "On an ada:TAPPDefinition, an instrument's schema:additionalProperty entries must be schema:PropertyValueSpecification (overridable parameter templates), not schema:PropertyValue." ;
    ] ;
    .

# Renamed from cdifd:provUsedInstrumentParamValueShape, because its target walked the
# role-keyed prov:used wrapper that the 2026-11-11 CDIF activity-used-resources change
# retired -- it matched an activity's used resources through an intermediate node that
# no conforming record carries any more. Nothing in the corpus spells that property now,
# 0 of 658 examples, so the target selected NOTHING and the shape reported nothing, while
# the 581 run-side instrument nodes it exists to check went unchecked. This is the SILENT
# half of the same migration whose LOUD half was adaActivityShape in
# adaProduct/rules.shacl: one shape demanded a retired property and failed everything it
# saw, the other went looking for it and found nobody.
#
# check_shacl_targets.py --execute exists to catch exactly a target that selects nothing,
# and could not see this one: it tests a target against `example*.json` in the shape
# file's OWN directory, and instrument/ has none. 43 blocks are in that position,
# including every shared BaseSchema block and all 16 modules.
#
# The prov:wasGeneratedBy hop is what keeps this shape off the PLAN's instruments, which
# need the specification form instead: a plan is reached by schema:actionProcess and is
# never the object of prov:wasGeneratedBy, so the two targets stay disjoint. That
# disjointness is the whole reason there are two shapes rather than one.
cdifd:analysisInstrumentParamValueShape
    a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            PREFIX prov: <http://www.w3.org/ns/prov#>
            PREFIX schema: <http://schema.org/>
            SELECT ?this
            WHERE {
                ?product prov:wasGeneratedBy ?activity .
                ?activity schema:instrument ?this .
            }
        """ ;
    ] ;
    sh:property [
        sh:path schema:additionalProperty ;
        sh:class schema:PropertyValue ;
        sh:severity sh:Violation ;
        sh:message "On an analysis-event instrument (reached through prov:wasGeneratedBy), schema:additionalProperty entries must be schema:PropertyValue (concrete values), not schema:PropertyValueSpecification." ;
    ] ;
    .
