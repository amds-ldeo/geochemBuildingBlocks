                "const": "ada:parameter/empaTAPP/backgroundPosition"
              },
              "@type": {
                "const": [
                  "schema:PropertyValue"
                ]
              },
              "schema:propertyID": {
                "const": {
                  "@id": "ada:parameter/empaTAPP/backgroundPosition"
                }
              },
              "schema:name": {
                "const": "Background Position(s)"
              },
              "schema:value": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string"
                  }
                ]
              }
            },
            "required": [
              "@id",
              "@type",
              "schema:propertyID",
              "schema:name",
              "schema:value"
            ]
          },
          "minContains": 0,
