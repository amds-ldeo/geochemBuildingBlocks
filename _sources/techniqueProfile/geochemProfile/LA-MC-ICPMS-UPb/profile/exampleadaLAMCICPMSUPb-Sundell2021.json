      "ada:proceduralBlankLevel": "missing",
      "schema:actionProcess": {
        "@type": [
          "schema:HowTo"
        ],
        "schema:name": "Rapid zircon U-Pb geochronology by LA-MC-ICP-MS, Arizona LaserChron Center",
        "schema:description": "Sample-standard bracketed zircon U-Pb dating on a Nu Plasma HR multi-collector, at four acquisition rates from 120 to 1200 analyses per hour, with U, Th and the three radiogenic Pb masses on Faradays and 204Pb and 202(Hg+Pb) on ion counters.",
        "schema:step": [
          {
            "@type": [
              "schema:HowToStep"
            ],
            "schema:position": 1,
            "schema:name": "Sample preparation",
            "schema:description": "Unknown zircons (sandstone CP40) mounted in a single epoxy mount with the primary and secondary reference materials FC-1 and R33, with spots assigned at random. Before each session every selected spot received a three-pulse cleaning shot at 50 um beam diameter to remove common Pb and surface contaminants from the mount; the paper calls this critical for the rapid acquisition rates."
          },
          {
            "@type": [
              "schema:HowToStep"
            ],
            "schema:position": 2,
            "schema:name": "Data acquisition",
            "schema:description": "Four acquisition rates: 120, 300, 600 and 1200 analyses per hour, i.e. 30, 12, 6 and 3 s per analysis, equating to 15, 7, 3 and 1 s of sample integration. Each was optimised to maximise on-peak time while minimising background and washout. For the 120 per hour rate fifty indexes (10 s) of background are measured and subtracted, bringing the standard error on 238U below 1%. Fractionation from instrument drift, mass bias and laser-induced fractionation is handled by bracketing five unknowns to one primary reference analysis."
          },
          {
            "@type": [
              "schema:HowToStep"
            ],
            "schema:position": 3,
            "schema:name": "Data reduction",
            "schema:description": "AgeCalcML, a new open-source MATLAB package (github.com/kurtsundell/AgeCalcML), based on the in-house Excel macro AgeCalc at the Arizona LaserChron Center (Gehrels et al. 2008) and following the data-reporting protocols of Horstwood et al. (2016). Each isotopic mass is recorded as a discrete time series and individual analyses are parsed from the seven time series by identifying the start of ablation, t0. Quality control filters applied here: 10% uncertainty cut-off, 10% discordance filter on best ages older than 600 Ma, 5% reverse-discordance filter, and a 204Pb filter at 400 cps.",
            "ada:detectionLimitMethod": "missing"
          }
        ]
      },
      "ada:deadTime": -9999
    }
  ],
