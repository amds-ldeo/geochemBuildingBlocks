{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Electron Backscatter Diffraction Analysis Detail",
    "description": "Detail block for EBSD hasPart items. The per-analysis properties are working distance, camera exposure time, map step size and indexing rate; the map step size is usually given in the source's per-sample tables rather than its prose.",
    "allOf": [
        {
            "type": "object",
            "properties": {
                "ada:componentType": {
                    "anyOf": [
                        {
                            "const": "ada:SEMEBSDGrainImageMap"
                        }
                    ]
                },
                "schema:measurementTechnique": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "description": "@id reference to a registered ebsdTAPP TAPP definition.",
                        "properties": {
                            "@id": {
                                "type": "string",
                                "format": "uri"
                            }
                        },
                        "required": [
                            "@id"
                        ]
                    }
                },
                "ada:sessionIdentifier": {
                    "description": "Identifier for the analytical session this record describes — the laboratory's own run, sequence or batch identifier as generated by the instrument or acquisition software. Distinct from any persistent identifier a repository mints on submission.",
                    "type": "string"
                },
                "ada:analyst": {
                    "description": "Name(s) of the analyst(s) who performed the analysis session. ORCID is recommended for persistent identification.",
                    "type": "string"
                },
                "ada:analysisStartDate": {
                    "description": "Date on which the analytical session began. For sessions spanning multiple days, use the date of the first session. Format: YYYY-MM-DD.",
                    "type": "string"
                },
                "ada:analysisEndDate": {
                    "description": "Date on which the analytical session ended. May equal Analysis Start Date for single-day sessions. Format: YYYY-MM-DD.",
                    "type": "string"
                },
                "ada:fundingSourceForAnalysis": {
                    "description": "Grants and other funding sources that supported the specific sample analyses and data collection reported here. Include grant numbers and funding agencies. Distinct from procedure development funding, which may have been awarded years earlier.",
                    "type": "string"
                },
                "ada:sampleName": {
                    "description": "Name or identifier of each sample analysed in this session, as used in the laboratory — a sample mount, section or aliquot counts as one entry where that is what the laboratory tracks. Should match the identifier used in associated publications or data tables.",
                    "type": "string"
                },
                "ada:samplingUnitName": {
                    "description": "The name or label of each sampling unit analysed in this session, as the laboratory records it, together with the sample it belongs to — e.g. a spot number, a grain label, a map or region-of-interest name, or an aliquot identifier. Where units are too numerous to name individually, such as map pixels or reconstructed voxels, name the acquisition area they belong to instead.",
                    "type": "string"
                },
                "ada:workingDistance": {
                    "description": "Working distance during mapping.",
                    "anyOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "string"
                        }
                    ]
                },
                "ada:ebsdCameraExposureTime": {
                    "description": "Exposure time per EBSD pattern.",
                    "anyOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "string"
                        }
                    ]
                },
                "ada:mapStepSize": {
                    "description": "Step size of the EBSD map.",
                    "anyOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "string"
                        }
                    ]
                },
                "ada:ebsdIndexingRate": {
                    "description": "Pattern collection and indexing rate.",
                    "anyOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "string"
                        }
                    ]
                }
            },
            "required": [
                "ada:componentType",
                "ada:sessionIdentifier",
                "ada:analyst",
                "ada:analysisStartDate",
                "ada:analysisEndDate",
                "ada:fundingSourceForAnalysis",
                "ada:sampleName",
                "ada:samplingUnitName",
                "ada:workingDistance",
                "ada:ebsdCameraExposureTime",
                "ada:mapStepSize",
                "ada:ebsdIndexingRate"
            ]
        },
        {
            "type": "object",
            "properties": {
                "schema:additionalProperty": {
                    "type": "array",
                    "description": "Per-dataset schema:PropertyValue entries. All optional.",
                    "items": {
                        "anyOf": [
                            {
                                "$ref": "../../../../registry/parameterValues/schema.yaml#/$defs/ebsd_coupledProcedureDoi"
                            },
                            {
                                "$ref": "../../../../registry/parameterValues/schema.yaml#/$defs/ebsd_coupledDatasetOrPublicationReference"
                            },
                            {
                                "$ref": "../../../../registry/parameterValues/schema.yaml#/$defs/ebsd_samplePersistentIdentifier"
                            },
                            {
                                "$ref": "../../../../registry/parameterValues/schema.yaml#/$defs/ebsd_samplePreparationMethod"
                            },
                            {
                                "$ref": "../../../../registry/parameterValues/schema.yaml#/$defs/ebsd_samplingUnitSelectionCriteria"
                            },
                            {
                                "$ref": "../../../../registry/parameterValues/schema.yaml#/$defs/ebsd_preAnalysisImagingAndScreening"
                            },
                            {
                                "$ref": "../../../../registry/parameterValues/schema.yaml#/$defs/ebsd_dataProcessingSoftware"
                            },
                            {
                                "$ref": "../../../../registry/parameterValues/schema.yaml#/$defs/ebsd_calibrationFactorAndDeterminationMethod"
                            },
                            {
                                "$ref": "../../../../registry/parameterValues/schema.yaml#/$defs/ebsd_constantsAndReferenceValuesUsed"
                            },
                            {
                                "$ref": "../../../../registry/parameterValues/schema.yaml#/$defs/ebsd_acceleratingVoltage"
                            },
                            {
                                "$ref": "../../../../registry/parameterValues/schema.yaml#/$defs/ebsd_beamCurrent"
                            },
                            {
                                "$ref": "../../../../registry/parameterValues/schema.yaml#/$defs/ebsd_houghResolution"
                            },
                            {
                                "$ref": "../../../../registry/parameterValues/schema.yaml#/$defs/ebsd_edsChannels"
                            },
                            {
                                "$ref": "../../../../registry/parameterValues/schema.yaml#/$defs/ebsd_edsProcessTime"
                            },
                            {
                                "$ref": "../../../../registry/parameterValues/schema.yaml#/$defs/ebsd_crystalStructureFileSources"
                            },
                            {
                                "type": "object",
                                "description": "Catch-all for additional schema:PropertyValue entries beyond the ebsdTAPP-derived catalog.",
                                "properties": {
                                    "@type": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        },
                                        "contains": {
                                            "const": "schema:PropertyValue"
                                        }
                                    },
                                    "schema:propertyID": {
                                        "type": "object",
                                        "required": [
                                            "@id"
                                        ],
                                        "properties": {
                                            "@id": {
                                                "type": "string",
                                                "not": {
                                                    "enum": [
                                                        "ada:parameter/ebsdTAPP/coupledProcedureDoi",
                                                        "ada:parameter/ebsdTAPP/coupledDatasetOrPublicationReference",
                                                        "ada:parameter/ebsdTAPP/samplePersistentIdentifier",
                                                        "ada:parameter/ebsdTAPP/samplePreparationMethod",
                                                        "ada:parameter/ebsdTAPP/samplingUnitSelectionCriteria",
                                                        "ada:parameter/ebsdTAPP/preAnalysisImagingAndScreening",
                                                        "ada:parameter/ebsdTAPP/dataProcessingSoftware",
                                                        "ada:parameter/ebsdTAPP/calibrationFactorAndDeterminationMethod",
                                                        "ada:parameter/ebsdTAPP/constantsAndReferenceValuesUsed",
                                                        "ada:parameter/ebsdTAPP/acceleratingVoltage",
                                                        "ada:parameter/ebsdTAPP/beamCurrent",
                                                        "ada:parameter/ebsdTAPP/houghResolution",
                                                        "ada:parameter/ebsdTAPP/edsChannels",
                                                        "ada:parameter/ebsdTAPP/edsProcessTime",
                                                        "ada:parameter/ebsdTAPP/crystalStructureFileSources"
                                                    ]
                                                }
                                            }
                                        }
                                    }
                                },
                                "required": [
                                    "@type",
                                    "schema:propertyID"
                                ]
                            }
                        ]
                    }
                }
            }
        }
    ]
}
