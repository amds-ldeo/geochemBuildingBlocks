{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "ADA S-XRF Product Profile",
    "description": "Path-driven technique-specific profile for ADA S-XRF Product Profile. Extends the base ADA product profile with the SXRF analysis-instance detail on the schema:Dataset root, narrows prov:used to the sXrfTAPP protocol, and constrains valid component types on schema:distribution.hasPart.",
    "allOf": [
        {
            "$ref": "../../../../BaseSchema/geochemProduct/geochemProductSchema.json"
        },
        {
            "$ref": "../detail/detailSchema.json"
        },
        {
            "type": "object",
            "properties": {
                "prov:wasGeneratedBy": {
                    "description": "Pin the sXrfTAPP definition and the instrument where prov:used carries them. Constraint-only if/then, never a narrowed anyOf: prov:used items are role-keyed wrappers, and an anyOf here would allOf-merge with the base union and exclude item shapes the base allows.",
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "prov:used": {
                                "type": "array",
                                "items": {
                                    "allOf": [
                                        {
                                            "if": {
                                                "type": "object",
                                                "required": [
                                                    "schema:instrument"
                                                ]
                                            },
                                            "then": {
                                                "properties": {
                                                    "schema:instrument": {
                                                        "type": "array",
                                                        "minItems": 1,
                                                        "items": {
                                                            "$ref": "../../../../BaseSchema/instrument/instrumentSchema.json"
                                                        }
                                                    }
                                                }
                                            }
                                        },
                                        {
                                            "if": {
                                                "type": "object",
                                                "properties": {
                                                    "@type": {
                                                        "contains": {
                                                            "const": "ada:TAPPDefinition"
                                                        }
                                                    }
                                                },
                                                "required": [
                                                    "@type"
                                                ]
                                            },
                                            "then": {
                                                "$ref": "../tapp/tappSchema.json"
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    }
                },
                "schema:additionalType": {
                    "description": "Must include a SXRF product type identifier.",
                    "contains": {
                        "enum": [
                            "Synchrotron-based X-ray Fluorescence Spectroscopy",
                            "Synchrotron-based X-ray Fluorescence Spectroscopy (S-XRF)",
                            "Synchrotron X-ray fluorescence spectrometry",
                            "Synchrotron X-Ray Fluorescence Analysis",
                            "SYNCHXRF"
                        ]
                    }
                },
                "schema:subjectOf": {
                    "properties": {
                        "dcterms:conformsTo": {
                            "contains": {
                                "type": "object",
                                "properties": {
                                    "@id": {
                                        "const": "https://w3id.org/geochem/metadata/profiles/adaSXRF"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    ]
}
