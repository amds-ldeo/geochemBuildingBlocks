      "ada:proceduralBlankLevel": "missing",
      "schema:actionProcess": {
        "@type": [
          "schema:HowTo"
        ],
        "schema:name": "Mass-independent Ti isotope analysis by MC-ICP-MS in two cup configurations, Thermo Neptune Plus, ETH Zurich",
        "schema:description": "Sample-standard bracketed Ti isotope measurement in medium resolution, two cup configurations per acquisition, 117 runs over two days. Neptune methods used: Ti_MR.met; Ti_MR_oPc.met; Ti_background_MR.met; Ti_wash_MR.met.",
        "schema:step": [
          {
            "@type": [
              "schema:HowToStep"
            ],
            "schema:position": 1,
            "schema:name": "Sample digestion",
            "schema:description": "Samples dissolved, then Ti isolated and purified from the matrix by three-stage anion exchange chromatography after Williams et al. 2021, on pre-cleaned BioRad AG1-X8 resin (100-200 or 200-400 mesh): re-dissolve in 2 mL 4 M HF; load; wash matrix with 10.5 mL 4 M HF; elute Ti in 3 mL 6 M HCl-1 M HF; dry at 80 C; redissolve in 1 mL 0.25 M H2SO4-1% H2O2; second column, Ti collected in 9.5 mL of the same; dry and redissolve in 1 mL 4 M HF; third column, matrix eluted in 6.5 mL 4 M HF then V in 5 mL 0.5 M HCl-0.5 M HF; final Ti fraction collected in 3 mL 6 M HCl-1 M HF. The last column was repeated. For analysis, diluted in 0.5 M HNO3-0.015 M HF and further diluted to machine tuning to give ~30-40 V on 48Ti."
          },
          {
            "@type": [
              "schema:HowToStep"
            ],
            "schema:position": 2,
            "schema:name": "Calibration",
            "schema:description": "Sample-standard bracketing against a Ti wire standard, each sample measurement bracketed immediately before and after. 22 standard runs in this collection. A peak-centre routine was run before every 6th to 8th standard measurement."
          },
          {
            "@type": [
              "schema:HowToStep"
            ],
            "schema:position": 3,
            "schema:name": "Data acquisition",
            "schema:description": "Two cup configurations per acquisition, in all 117 runs. Configuration 1 measures 44Ca, 46Ti, 46.931, 48Ti, 49Ti, 50Ti; configuration 2 measures 49Ti, 49.941, 51V, 52Cr, 53Cr. 49Ti is measured in BOTH, and is the tie used to correct one against the other. An electronic baseline of 30 cycles at 1.048576 s integration preceded each measurement, collected across the whole collector array.",
            "schema:additionalProperty": [
              {
                "@id": "ada:parameter/module/SolutionIntroduction/desolvationSystem",
                "@type": [
                  "schema:PropertyValue"
                ],
                "schema:propertyID": [
                  {
                    "@id": "ada:parameter/module/SolutionIntroduction/desolvationSystem"
                  }
                ],
                "schema:name": "Desolvation System",
                "schema:value": "Aridus II desolvating nebuliser; X-cones"
              }
            ]
          },
          {
            "@type": [
              "schema:HowToStep"
            ],
            "schema:position": 4,
            "schema:name": "Data reduction",
            "schema:description": "Background measurements before and after each sample/standard are averaged and subtracted. Drift between the two cup configurations is corrected for 51V and 53Cr using 49Ti, measured in both. Mass bias by the exponential law from 49Ti/47Ti = 0.749766 (Niederer et al. 1985). Interference corrections for Cr and V on 50Ti and Ca on 46Ti and 48Ti. A 2-standard-deviation outlier rejection was applied. Ratios in the raw .exp files are indicative only and are NOT background corrected.",
            "ada:detectionLimitMethod": "missing",
            "schema:additionalProperty": [
              {
                "@id": "ada:parameter/module/Core/constantsReferenceValues",
                "@type": [
                  "schema:PropertyValue"
                ],
                "schema:propertyID": [
                  {
                    "@id": "ada:parameter/module/Core/constantsReferenceValues"
                  }
                ],
                "schema:name": "Constants Reference Values",
                "schema:value": "Mass bias: exponential law with 49Ti/47Ti = 0.749766 (Niederer et al. 1985), true masses 47Ti = 46.951764 and 49Ti = 48.9479473."
              }
            ]
          }
        ]
      },
      "ada:deadTime": -9999,
