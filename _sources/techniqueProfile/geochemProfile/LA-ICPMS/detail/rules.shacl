@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix ada:    <https://ada.astromat.org/metadata/> .
@prefix cdifd:  <https://cdif.org/validation/0.1/shacl#> .
@base           <https://www.ogc.org/rules/template/> .

# Validates LA-ICPMS detail nodes (ada:LAICPMSTabular, ada:LAICPMSMap, ada:LAICPMSImage).
cdifd:detailLAICPMSShape
    a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            PREFIX ada: <https://ada.astromat.org/metadata/>
            SELECT ?this
            WHERE {
                { ?this a ada:LAICPMSTabular . }
                UNION
                { ?this a ada:LAICPMSMap . }
                UNION
                { ?this a ada:LAICPMSImage . }
            }
        """ ;
    ] ;
    sh:property [
        sh:path ada:analyst ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Warning ;
        sh:message "LA-ICPMS detail should specify the analyst." ;
    ] ;
    .
