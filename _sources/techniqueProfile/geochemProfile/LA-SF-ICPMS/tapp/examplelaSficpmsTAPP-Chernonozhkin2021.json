  "schema:actionProcess": {
    "schema:step": [
      {
        "schema:name": "Sample preparation",
        "schema:description": "Flat polished thick sections (§2.1)",
        "@type": [
          "cdi:Activity",
          "schema:Action",
          "schema:HowToStep"
