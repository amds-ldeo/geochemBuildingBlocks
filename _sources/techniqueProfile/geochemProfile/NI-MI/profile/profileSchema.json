{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "ADA NI-MI Product Profile",
    "description": "Path-driven technique-specific profile for ADA NI-MI Product Profile. Extends the base ADA product profile with the NIMI analysis-instance detail on the schema:Dataset root, and pins the product type and the profile it declares conformance to.",
    "allOf": [
        {
            "$ref": "../../../../BaseSchema/geochemProduct/geochemProductSchema.json"
        },
        {
            "$ref": "../detail/detailSchema.json"
        },
        {
            "type": "object",
            "properties": {
                "schema:additionalType": {
                    "description": "Must include a NIMI product type identifier.",
                    "contains": {
                        "enum": [
                            "Nanoindentation and Microindentation",
                            "Nanoindentation and microindentation (NI-MI)"
                        ]
                    },
                    "title": "Product Type"
                },
                "schema:subjectOf": {
                    "properties": {
                        "dcterms:conformsTo": {
                            "contains": {
                                "type": "object",
                                "properties": {
                                    "@id": {
                                        "const": "https://w3id.org/geochem/metadata/profiles/adaNIMI"
                                    }
                                }
                            }
                        }
                    },
                    "title": "About This Record"
                }
            }
        }
    ]
}
