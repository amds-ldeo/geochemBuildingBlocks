                "type": "string"
              }
            },
            "required": [
              "@id",
              "@type",
              "schema:propertyID",
              "schema:name",
              "schema:value"
            ]
          }
        ]
      },
      "allOf": [
        {
          "contains": {
            "title": "Beam Raster Dimensions",
