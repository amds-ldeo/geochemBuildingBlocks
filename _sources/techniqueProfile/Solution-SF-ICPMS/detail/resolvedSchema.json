              "schema:value": {
                "type": "string"
              }
            },
            "required": [
              "@id",
              "@type",
              "schema:propertyID",
              "schema:name",
              "schema:value"
            ]
          },
          {
            "title": "Uncertainty Propagation Method",
            "description": "Method used to propagate analytical uncertainties from raw signals through to final concentration values.",
            "type": "object",
            "properties": {
              "@id": {
                "const": "ada:parameter/solutionSficpmsTAPP/uncertaintyPropagationMethod"
