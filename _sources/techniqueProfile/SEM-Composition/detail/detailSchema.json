                            "@type",
                            "schema:propertyID",
                            "schema:name",
                            "schema:value"
                        ]
                    }
                ]
            },
            "allOf": [
                {
                    "contains": {
                        "title": "Beam Raster Dimensions",
                        "description": "Dimensions of the small area over which the beam is rastered during a single analysis point, reported as width × height in µm. Applicable when Beam Mode = Rastered; defines the effective spatial footprint of the measurement and distributes dose over a larger area to reduce beam damage on sensitive phases.",
