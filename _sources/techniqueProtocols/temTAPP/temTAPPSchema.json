{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "TEM Technique-Aligned Protocol Profile (temTAPP)",
    "description": "Transmission electron microscopy (TEM/STEM, incl. EDS/EELS) extension of the base TAPP definition. Basic protocol-tier fields are required top-level ada: properties; Advanced protocol-tier fields are schema:additionalProperty[] entries; an ada:analyteTemplate carries per-element columns. Generated from docs/TEM_TAPP_v7.xlsx by tools/build_tapp.py.",
    "allOf": [
        {
            "$ref": "../tappDefinition/tappDefinitionSchema.json"
        },
        {
            "type": "object",
            "properties": {
                "ada:analyticalMode": {
                    "description": "Top-level analytical mode(s) executed under this protocol: TEM Imaging, STEM Imaging, or Electron Diffraction. For multi-mode protocols (e.g., STEM Imaging combined with Electron Diffraction), list all applicable modes. Serves as the protocol-level declaration of measurement type, distinct from \"Analytical Sub-mode\" (which records the specific technique within a mode, e.g., BF-TEM, HAADF-STEM, SAED, PED) and from the mode flag columns which indicate per-field applicability.",
                    "type": "array",
                    "items": {
                        "type": "string",
                        "enum": [
                            "TEM Imaging",
                            "STEM Imaging",
                            "Electron Diffraction"
                        ]
                    }
                },
                "ada:acceleratingVoltageDefault": {
                    "description": "Electron beam accelerating voltage in kilovolts (kV). For beam-sensitive materials (organic matter, phyllosilicates), 60–80 kV may be used to stay below the displacement threshold for C, N, O, and S. The protocol specifies the standard operating voltage; analysts record and justify deviations.",
                    "anyOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "string"
                        }
                    ]
                },
                "ada:analyticalModeDefault": {
                    "description": "Sub-mode(s) of imaging or diffraction performed under this protocol. TEM Imaging options: BF-TEM, DF-TEM, HRTEM, EFTEM. STEM Imaging options: HAADF, ABF, BF-STEM, ADF, MAADF. Electron Diffraction options: SAED, CBED, Nanobeam diffraction, Precession ED, 4D-STEM. Multiple values apply when the protocol covers more than one sub-mode within a given analytical mode.",
                    "type": "array",
                    "items": {
                        "type": "string",
                        "enum": [
                            "TEM Imaging",
                            "STEM Imaging",
                            "Electron Diffraction"
                        ]
                    }
                },
                "ada:convergenceSemiAngle": {
                    "description": "Semi-angle of the converged electron probe in milliradians. Controls probe size (smaller angle = larger probe but less coherent), depth of field, and in 4D-STEM, the size of diffraction discs vs. spatial resolution. For near-parallel-beam 4D-STEM (e.g., phyllosilicate phase mapping), values as small as 0.1 mrad are used.",
                    "anyOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "string"
                        }
                    ]
                },
                "ada:stemDwellTimePerPixelDefault": {
                    "description": "Time spent acquiring signal at each pixel during STEM scanning in milliseconds. Longer dwell improves signal-to-noise but increases total specimen dose; for dose-sensitive materials, minimize dwell and compensate with frame averaging.",
                    "anyOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "string"
                        }
                    ]
                },
                "ada:cameraLengthDefault": {
                    "description": "Nominal camera length in millimeters used for diffraction pattern acquisition. Controls the mapping between reciprocal-space scattering angle and detector position; must be calibrated to convert pixel distances to d-spacings. In STEM mode, also sets HAADF/ABF detector collection angles.",
                    "anyOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "string"
                        }
                    ]
                },
                "ada:edsAcquisitionModeDefault": {
                    "description": "Mode of EDS data acquisition.",
                    "type": "string"
                },
                "ada:edsQuantificationMethod": {
                    "description": "Method used to convert EDS X-ray intensities to elemental concentrations.",
                    "type": "string"
                },
                "ada:eelsAcquisitionModeDefault": {
                    "description": "Mode of EELS data acquisition.",
                    "type": "string"
                },
                "ada:eelsEdgesDefault": {
                    "description": "Ionization edge(s) acquired by EELS, specified by element symbol and edge label (e.g., Fe L2,3; O K). Provides the EELS-specific counterpart to the Analyte field: while Analyte lists elements, EELS Edges documents which ionization edges were used and their approximate energy loss positions. The protocol registers the full intended edge suite; analysts confirm or narrow this list at analysis time.",
                    "type": "string"
                },
                "ada:eelsCollectionSemiAngle": {
                    "description": "Semi-angle of the EELS spectrometer entrance aperture in milliradians. Controls the fraction of inelastically scattered electrons collected and the spectral background level.",
                    "anyOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "string"
                        }
                    ]
                },
                "ada:eelsAcquisitionTimePerSpectrumDefault": {
                    "description": "Exposure time per individual EELS spectrum (or per pixel for spectrum images) in seconds.",
                    "anyOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "string"
                        }
                    ]
                },
                "ada:eelsEnergyLossRangeDefault": {
                    "description": "Energy loss range acquired, defined by onset energy and width in eV. The protocol documents the target range for the registered analyte edges; analysts record the actual range acquired.",
                    "type": "string"
                },
                "ada:phaseIdentificatonMethod": {
                    "description": "Method used to identify crystalline phases from electron diffraction patterns or d-spacings, whether from SAED patterns, spot diffraction, or diffraction data extracted from 4D-STEM datasets.",
                    "type": "string"
                },
                "ada:edsCalibrationStandardDefault": {
                    "description": "Reference material(s) used to validate EDS quantification or determine experimental k-factors or zeta-factors. TEM-EDS is less standardized than EPMA; many protocols rely on manufacturer k-factors without external calibration.",
                    "type": "string"
                },
                "schema:additionalProperty": {
                    "type": "array",
                    "description": "Method-level Advanced-protocol parameters. Editable parameters are schema:PropertyValueSpecification entries (…Default name; the per-dataset value lives in the detail block); read-only parameters are schema:PropertyValue entries carrying the fixed protocol value in schema:value.",
                    "items": {
                        "anyOf": [
                            {
                                "$ref": "../parameterTemplates/schema.yaml#/$defs/temObjectiveApertureDefault"
                            },
                            {
                                "$ref": "../parameterTemplates/schema.yaml#/$defs/eftemEnergyWindowDefault"
                            },
                            {
                                "$ref": "../parameterTemplates/schema.yaml#/$defs/haadfCollectionAnglesDefault"
                            },
                            {
                                "$ref": "../parameterTemplates/schema.yaml#/$defs/stemProbeDiameterDefault"
                            },
                            {
                                "$ref": "../parameterTemplates/schema.yaml#/$defs/stemProbeCurrentDefault"
                            },
                            {
                                "$ref": "../parameterTemplates/schema.yaml#/$defs/stemScanDimensionsDefault"
                            },
                            {
                                "$ref": "../parameterTemplates/schema.yaml#/$defs/stemFrameAveragingDefault"
                            },
                            {
                                "$ref": "../parameterTemplates/schema.yaml#/$defs/selectedAreaApertureSizeDefault"
                            },
                            {
                                "$ref": "../parameterTemplates/schema.yaml#/$defs/precessionAngleDefault"
                            },
                            {
                                "$ref": "../parameterTemplates/schema.yaml#/$defs/4dStemScanGridAndAreaDefault"
                            },
                            {
                                "$ref": "../parameterTemplates/schema.yaml#/$defs/4dStemDwellTimePerProbePositionDefault"
                            },
                            {
                                "$ref": "../parameterTemplates/schema.yaml#/$defs/diffractionCameraLengthCalibrationMethodDefault"
                            },
                            {
                                "$ref": "../parameterTemplates/schema.yaml#/$defs/edsLiveTimePerPointOrPixelDefault"
                            },
                            {
                                "$ref": "../parameterTemplates/schema.yaml#/$defs/edsEnergyRangeDefault"
                            },
                            {
                                "$ref": "../parameterTemplates/schema.yaml#/$defs/eelsBackgroundSubtractionMethodDefault"
                            },
                            {
                                "$ref": "../parameterTemplates/schema.yaml#/$defs/eelsPluralScatteringCorrectionDefault"
                            },
                            {
                                "$ref": "../parameterTemplates/schema.yaml#/$defs/imageProcessingMethodsAppliedDefault"
                            },
                            {
                                "$ref": "../parameterTemplates/schema.yaml#/$defs/specimenThicknessDeterminationMethodDefault"
                            },
                            {
                                "$ref": "../parameterTemplates/schema.yaml#/$defs/eelsEnergyCalibrationDefault"
                            },
                            {
                                "$ref": "../parameterTemplates/schema.yaml#/$defs/diffractionCalibrationReferenceDefault"
                            },
                            {
                                "$ref": "../parameterTemplates/schema.yaml#/$defs/edsDetectionLimitDefault"
                            },
                            {
                                "$ref": "../parameterTemplates/schema.yaml#/$defs/edsCountingStatisticsAccumulationCriterionDefault"
                            },
                            {
                                "$ref": "../parameterTemplates/schema.yaml#/$defs/eelsSensitivityAndDetectionLimitDefault"
                            },
                            {
                                "$ref": "../parameterValues/schema.yaml#/$defs/eelsEnergyDispersion"
                            },
                            {
                                "$ref": "../parameterValues/schema.yaml#/$defs/eelsEnergyResolution"
                            },
                            {
                                "$ref": "../parameterValues/schema.yaml#/$defs/4dStemOrientationMappingMethod"
                            },
                            {
                                "$ref": "../parameterValues/schema.yaml#/$defs/tem_edsSpectralProcessingType"
                            }
                        ]
                    },
                    "allOf": [
                        {
                            "contains": {
                                "$ref": "../parameterTemplates/schema.yaml#/$defs/temObjectiveApertureDefault"
                            },
                            "minContains": 0,
                            "maxContains": 1
                        },
                        {
                            "contains": {
                                "$ref": "../parameterTemplates/schema.yaml#/$defs/eftemEnergyWindowDefault"
                            },
                            "minContains": 0,
                            "maxContains": 1
                        },
                        {
                            "contains": {
                                "$ref": "../parameterTemplates/schema.yaml#/$defs/haadfCollectionAnglesDefault"
                            },
                            "minContains": 0,
                            "maxContains": 1
                        },
                        {
                            "contains": {
                                "$ref": "../parameterTemplates/schema.yaml#/$defs/stemProbeDiameterDefault"
                            },
                            "minContains": 0,
                            "maxContains": 1
                        },
                        {
                            "contains": {
                                "$ref": "../parameterTemplates/schema.yaml#/$defs/stemProbeCurrentDefault"
                            },
                            "minContains": 0,
                            "maxContains": 1
                        },
                        {
                            "contains": {
                                "$ref": "../parameterTemplates/schema.yaml#/$defs/stemScanDimensionsDefault"
                            },
                            "minContains": 0,
                            "maxContains": 1
                        },
                        {
                            "contains": {
                                "$ref": "../parameterTemplates/schema.yaml#/$defs/stemFrameAveragingDefault"
                            },
                            "minContains": 0,
                            "maxContains": 1
                        },
                        {
                            "contains": {
                                "$ref": "../parameterTemplates/schema.yaml#/$defs/selectedAreaApertureSizeDefault"
                            },
                            "minContains": 0,
                            "maxContains": 1
                        },
                        {
                            "contains": {
                                "$ref": "../parameterTemplates/schema.yaml#/$defs/precessionAngleDefault"
                            },
                            "minContains": 0,
                            "maxContains": 1
                        },
                        {
                            "contains": {
                                "$ref": "../parameterTemplates/schema.yaml#/$defs/4dStemScanGridAndAreaDefault"
                            },
                            "minContains": 0,
                            "maxContains": 1
                        },
                        {
                            "contains": {
                                "$ref": "../parameterTemplates/schema.yaml#/$defs/4dStemDwellTimePerProbePositionDefault"
                            },
                            "minContains": 0,
                            "maxContains": 1
                        },
                        {
                            "contains": {
                                "$ref": "../parameterTemplates/schema.yaml#/$defs/diffractionCameraLengthCalibrationMethodDefault"
                            },
                            "minContains": 0,
                            "maxContains": 1
                        },
                        {
                            "contains": {
                                "$ref": "../parameterTemplates/schema.yaml#/$defs/edsLiveTimePerPointOrPixelDefault"
                            },
                            "minContains": 0,
                            "maxContains": 1
                        },
                        {
                            "contains": {
                                "$ref": "../parameterTemplates/schema.yaml#/$defs/edsEnergyRangeDefault"
                            },
                            "minContains": 0,
                            "maxContains": 1
                        },
                        {
                            "contains": {
                                "$ref": "../parameterTemplates/schema.yaml#/$defs/eelsBackgroundSubtractionMethodDefault"
                            },
                            "minContains": 0,
                            "maxContains": 1
                        },
                        {
                            "contains": {
                                "$ref": "../parameterTemplates/schema.yaml#/$defs/eelsPluralScatteringCorrectionDefault"
                            },
                            "minContains": 0,
                            "maxContains": 1
                        },
                        {
                            "contains": {
                                "$ref": "../parameterTemplates/schema.yaml#/$defs/imageProcessingMethodsAppliedDefault"
                            },
                            "minContains": 0,
                            "maxContains": 1
                        },
                        {
                            "contains": {
                                "$ref": "../parameterTemplates/schema.yaml#/$defs/specimenThicknessDeterminationMethodDefault"
                            },
                            "minContains": 0,
                            "maxContains": 1
                        },
                        {
                            "contains": {
                                "$ref": "../parameterTemplates/schema.yaml#/$defs/eelsEnergyCalibrationDefault"
                            },
                            "minContains": 0,
                            "maxContains": 1
                        },
                        {
                            "contains": {
                                "$ref": "../parameterTemplates/schema.yaml#/$defs/diffractionCalibrationReferenceDefault"
                            },
                            "minContains": 0,
                            "maxContains": 1
                        },
                        {
                            "contains": {
                                "$ref": "../parameterTemplates/schema.yaml#/$defs/edsDetectionLimitDefault"
                            },
                            "minContains": 0,
                            "maxContains": 1
                        },
                        {
                            "contains": {
                                "$ref": "../parameterTemplates/schema.yaml#/$defs/edsCountingStatisticsAccumulationCriterionDefault"
                            },
                            "minContains": 0,
                            "maxContains": 1
                        },
                        {
                            "contains": {
                                "$ref": "../parameterTemplates/schema.yaml#/$defs/eelsSensitivityAndDetectionLimitDefault"
                            },
                            "minContains": 0,
                            "maxContains": 1
                        },
                        {
                            "contains": {
                                "$ref": "../parameterValues/schema.yaml#/$defs/eelsEnergyDispersion"
                            },
                            "minContains": 0,
                            "maxContains": 1
                        },
                        {
                            "contains": {
                                "$ref": "../parameterValues/schema.yaml#/$defs/eelsEnergyResolution"
                            },
                            "minContains": 0,
                            "maxContains": 1
                        },
                        {
                            "contains": {
                                "$ref": "../parameterValues/schema.yaml#/$defs/4dStemOrientationMappingMethod"
                            },
                            "minContains": 0,
                            "maxContains": 1
                        },
                        {
                            "contains": {
                                "$ref": "../parameterValues/schema.yaml#/$defs/tem_edsSpectralProcessingType"
                            },
                            "minContains": 0,
                            "maxContains": 1
                        }
                    ]
                }
            },
            "required": [
                "ada:acceleratingVoltageDefault",
                "ada:analyticalModeDefault",
                "ada:convergenceSemiAngle",
                "ada:stemDwellTimePerPixelDefault",
                "ada:cameraLengthDefault",
                "ada:edsAcquisitionModeDefault",
                "ada:edsQuantificationMethod",
                "ada:eelsAcquisitionModeDefault",
                "ada:eelsEdgesDefault",
                "ada:eelsCollectionSemiAngle",
                "ada:eelsAcquisitionTimePerSpectrumDefault",
                "ada:eelsEnergyLossRangeDefault",
                "ada:phaseIdentificatonMethod",
                "ada:edsCalibrationStandardDefault"
            ]
        }
    ]
}
