{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ada:vocab/empaTAPP/Technique",
  "title": "Technique",
  "description": "Top-level analytical technique identifier.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "schema:DefinedTermSet"
    },
    "schema:name": {
      "const": "Technique"
    },
    "schema:hasDefinedTerm": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "@type": {
            "const": "schema:DefinedTerm"
          },
          "schema:termCode": {
            "enum": [
              "EPMA-WDS",
              "EPMA-EDS",
              "EPMA-WDS+EDS",
              "other"
            ]
          }
        },
        "required": [
          "@type",
          "schema:termCode"
        ]
      }
    }
  },
  "required": [
    "@type",
    "schema:hasDefinedTerm"
  ],
  "examples": [
    {
      "@context": {
        "schema": "http://schema.org/",
        "ada": "https://ada.astromat.org/metadata/"
      },
      "@id": "ada:vocab/empaTAPP/Technique",
      "@type": "schema:DefinedTermSet",
      "schema:name": "Technique",
      "schema:description": "Top-level analytical technique identifier.",
      "schema:hasDefinedTerm": [
        {
          "@type": "schema:DefinedTerm",
          "schema:termCode": "EPMA-WDS",
          "schema:name": "EPMA-WDS"
        },
        {
          "@type": "schema:DefinedTerm",
          "schema:termCode": "EPMA-EDS",
          "schema:name": "EPMA-EDS"
        },
        {
          "@type": "schema:DefinedTerm",
          "schema:termCode": "EPMA-WDS+EDS",
          "schema:name": "EPMA-WDS+EDS"
        },
        {
          "@type": "schema:DefinedTerm",
          "schema:termCode": "other",
          "schema:name": "other"
        }
      ]
    }
  ]
}
