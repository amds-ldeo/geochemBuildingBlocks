{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ada:vocab/empaTAPP/matrixCorrectionMethod",
  "title": "Matrix Correction Method",
  "description": "X-ray matrix correction algorithm applied during data reduction.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "schema:DefinedTermSet"
    },
    "schema:name": {
      "const": "Matrix Correction Method"
    },
    "schema:hasDefinedTerm": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "@type": {
            "const": "schema:DefinedTerm"
          },
          "schema:termCode": {
            "enum": [
              "PAP (Pouchou & Pichoir Full)",
              "XPP (Simplified PAP)",
              "PhiRhoZ Bastin (EPQ-91)",
              "Love-Scott I",
              "Love-Scott II",
              "Armstrong/Love-Scott",
              "Heinrich/Duncumb-Reed",
              "Conventional Philibert/Duncumb-Reed",
              "Other",
              "Unknown"
            ]
          }
        },
        "required": [
          "@type",
          "schema:termCode"
        ]
      }
    }
  },
  "required": [
    "@type",
    "schema:hasDefinedTerm"
  ],
  "examples": [
    {
      "@context": {
        "schema": "http://schema.org/",
        "ada": "https://ada.astromat.org/metadata/"
      },
      "@id": "ada:vocab/empaTAPP/matrixCorrectionMethod",
      "@type": "schema:DefinedTermSet",
      "schema:name": "Matrix Correction Method",
      "schema:description": "X-ray matrix correction algorithm applied during data reduction.",
      "schema:hasDefinedTerm": [
        {
          "@type": "schema:DefinedTerm",
          "schema:termCode": "PAP (Pouchou & Pichoir Full)",
          "schema:name": "PAP (Pouchou & Pichoir Full)"
        },
        {
          "@type": "schema:DefinedTerm",
          "schema:termCode": "XPP (Simplified PAP)",
          "schema:name": "XPP (Simplified PAP)"
        },
        {
          "@type": "schema:DefinedTerm",
          "schema:termCode": "PhiRhoZ Bastin (EPQ-91)",
          "schema:name": "PhiRhoZ Bastin (EPQ-91)"
        },
        {
          "@type": "schema:DefinedTerm",
          "schema:termCode": "Love-Scott I",
          "schema:name": "Love-Scott I"
        },
        {
          "@type": "schema:DefinedTerm",
          "schema:termCode": "Love-Scott II",
          "schema:name": "Love-Scott II"
        },
        {
          "@type": "schema:DefinedTerm",
          "schema:termCode": "Armstrong/Love-Scott",
          "schema:name": "Armstrong/Love-Scott"
        },
        {
          "@type": "schema:DefinedTerm",
          "schema:termCode": "Heinrich/Duncumb-Reed",
          "schema:name": "Heinrich/Duncumb-Reed"
        },
        {
          "@type": "schema:DefinedTerm",
          "schema:termCode": "Conventional Philibert/Duncumb-Reed",
          "schema:name": "Conventional Philibert/Duncumb-Reed"
        },
        {
          "@type": "schema:DefinedTerm",
          "schema:termCode": "Other",
          "schema:name": "Other"
        },
        {
          "@type": "schema:DefinedTerm",
          "schema:termCode": "Unknown",
          "schema:name": "Unknown"
        }
      ]
    }
  ]
}
