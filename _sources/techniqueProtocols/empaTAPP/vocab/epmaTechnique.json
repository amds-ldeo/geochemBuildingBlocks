{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ada:vocab/empaTAPP/epmaTechnique",
  "title": "EPMA Technique per Element",
  "description": "Whether this element was measured by WDS or EDS.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "schema:DefinedTermSet"
    },
    "schema:name": {
      "const": "EPMA Technique per Element"
    },
    "schema:hasDefinedTerm": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "@type": {
            "const": "schema:DefinedTerm"
          },
          "schema:name": {
            "type": "string"
          },
          "schema:description": {
            "type": "string"
          }
        },
        "required": [
          "@type",
          "@id",
          "schema:termCode"
        ],
        "oneOf": [
          {
            "properties": {
              "@id": {
                "const": "ada:WDS"
              },
              "schema:termCode": {
                "const": "WDS"
              }
            }
          },
          {
            "properties": {
              "@id": {
                "const": "ada:EDS"
              },
              "schema:termCode": {
                "const": "EDS"
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "@type",
    "schema:hasDefinedTerm"
  ],
  "examples": [
    {
      "@context": {
        "schema": "http://schema.org/",
        "ada": "https://ada.astromat.org/metadata/"
      },
      "@id": "ada:vocab/empaTAPP/epmaTechnique",
      "@type": "schema:DefinedTermSet",
      "schema:name": "EPMA Technique per Element",
      "schema:description": "Whether this element was measured by WDS or EDS.",
      "schema:hasDefinedTerm": [
        {
          "@type": "schema:DefinedTerm",
          "@id": "ada:WDS",
          "schema:termCode": "WDS",
          "schema:name": "WDS"
        },
        {
          "@type": "schema:DefinedTerm",
          "@id": "ada:EDS",
          "schema:termCode": "EDS",
          "schema:name": "EDS"
        }
      ]
    }
  ]
}
