{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ada:vocab/empaTAPP/edsSpectralProcessingType",
  "title": "EDS Spectral Processing Type",
  "description": "Method used to process EDS spectra and extract net peak intensities.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "schema:DefinedTermSet"
    },
    "schema:name": {
      "const": "EDS Spectral Processing Type"
    },
    "schema:hasDefinedTerm": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "@type": {
            "const": "schema:DefinedTerm"
          },
          "schema:name": {
            "type": "string"
          },
          "schema:description": {
            "type": "string"
          }
        },
        "required": [
          "@type",
          "@id",
          "schema:termCode"
        ],
        "oneOf": [
          {
            "properties": {
              "@id": {
                "const": "ada:Background fitting"
              },
              "schema:termCode": {
                "const": "Background fitting"
              }
            }
          },
          {
            "properties": {
              "@id": {
                "const": "ada:Peak deconvolution"
              },
              "schema:termCode": {
                "const": "Peak deconvolution"
              }
            }
          },
          {
            "properties": {
              "@id": {
                "const": "ada:Top hat"
              },
              "schema:termCode": {
                "const": "Top hat"
              }
            }
          },
          {
            "properties": {
              "@id": {
                "const": "ada:Gaussian"
              },
              "schema:termCode": {
                "const": "Gaussian"
              }
            }
          },
          {
            "properties": {
              "@id": {
                "const": "ada:Filter fit"
              },
              "schema:termCode": {
                "const": "Filter fit"
              }
            }
          },
          {
            "properties": {
              "@id": {
                "const": "ada:Other"
              },
              "schema:termCode": {
                "const": "Other"
              }
            }
          },
          {
            "properties": {
              "@id": {
                "const": "ada:Unknown"
              },
              "schema:termCode": {
                "const": "Unknown"
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "@type",
    "schema:hasDefinedTerm"
  ],
  "examples": [
    {
      "@context": {
        "schema": "http://schema.org/",
        "ada": "https://ada.astromat.org/metadata/"
      },
      "@id": "ada:vocab/empaTAPP/edsSpectralProcessingType",
      "@type": "schema:DefinedTermSet",
      "schema:name": "EDS Spectral Processing Type",
      "schema:description": "Method used to process EDS spectra and extract net peak intensities.",
      "schema:hasDefinedTerm": [
        {
          "@type": "schema:DefinedTerm",
          "@id": "ada:Background fitting",
          "schema:termCode": "Background fitting",
          "schema:name": "Background fitting"
        },
        {
          "@type": "schema:DefinedTerm",
          "@id": "ada:Peak deconvolution",
          "schema:termCode": "Peak deconvolution",
          "schema:name": "Peak deconvolution"
        },
        {
          "@type": "schema:DefinedTerm",
          "@id": "ada:Top hat",
          "schema:termCode": "Top hat",
          "schema:name": "Top hat"
        },
        {
          "@type": "schema:DefinedTerm",
          "@id": "ada:Gaussian",
          "schema:termCode": "Gaussian",
          "schema:name": "Gaussian"
        },
        {
          "@type": "schema:DefinedTerm",
          "@id": "ada:Filter fit",
          "schema:termCode": "Filter fit",
          "schema:name": "Filter fit"
        },
        {
          "@type": "schema:DefinedTerm",
          "@id": "ada:Other",
          "schema:termCode": "Other",
          "schema:name": "Other"
        },
        {
          "@type": "schema:DefinedTerm",
          "@id": "ada:Unknown",
          "schema:termCode": "Unknown",
          "schema:name": "Unknown"
        }
      ]
    }
  ]
}
