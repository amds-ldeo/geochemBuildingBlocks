{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ada:vocab/empaTAPP/edsSpectralProcessingType",
  "title": "EDS Spectral Processing Type",
  "description": "Method used to process EDS spectra and extract net peak intensities.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "schema:DefinedTermSet"
    },
    "schema:name": {
      "const": "EDS Spectral Processing Type"
    },
    "schema:hasDefinedTerm": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "@type": {
            "const": "schema:DefinedTerm"
          },
          "schema:termCode": {
            "enum": [
              "Background fitting",
              "Peak deconvolution",
              "Top hat",
              "Gaussian",
              "Filter fit",
              "Other",
              "Unknown"
            ]
          }
        },
        "required": [
          "@type",
          "schema:termCode"
        ]
      }
    }
  },
  "required": [
    "@type",
    "schema:hasDefinedTerm"
  ],
  "examples": [
    {
      "@context": {
        "schema": "http://schema.org/",
        "ada": "https://ada.astromat.org/metadata/"
      },
      "@id": "ada:vocab/empaTAPP/edsSpectralProcessingType",
      "@type": "schema:DefinedTermSet",
      "schema:name": "EDS Spectral Processing Type",
      "schema:description": "Method used to process EDS spectra and extract net peak intensities.",
      "schema:hasDefinedTerm": [
        {
          "@type": "schema:DefinedTerm",
          "schema:termCode": "Background fitting",
          "schema:name": "Background fitting"
        },
        {
          "@type": "schema:DefinedTerm",
          "schema:termCode": "Peak deconvolution",
          "schema:name": "Peak deconvolution"
        },
        {
          "@type": "schema:DefinedTerm",
          "schema:termCode": "Top hat",
          "schema:name": "Top hat"
        },
        {
          "@type": "schema:DefinedTerm",
          "schema:termCode": "Gaussian",
          "schema:name": "Gaussian"
        },
        {
          "@type": "schema:DefinedTerm",
          "schema:termCode": "Filter fit",
          "schema:name": "Filter fit"
        },
        {
          "@type": "schema:DefinedTerm",
          "schema:termCode": "Other",
          "schema:name": "Other"
        },
        {
          "@type": "schema:DefinedTerm",
          "schema:termCode": "Unknown",
          "schema:name": "Unknown"
        }
      ]
    }
  ]
}
