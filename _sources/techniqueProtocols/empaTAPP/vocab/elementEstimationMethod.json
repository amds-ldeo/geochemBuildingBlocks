{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ada:vocab/empaTAPP/elementEstimationMethod",
  "title": "Element Estimation Method",
  "description": "How elemental concentrations were calculated — directly from measured X-ray intensities or via cation stoichiometry.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "schema:DefinedTermSet"
    },
    "schema:name": {
      "const": "Element Estimation Method"
    },
    "schema:hasDefinedTerm": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "@type": {
            "const": "schema:DefinedTerm"
          },
          "schema:name": {
            "type": "string"
          },
          "schema:description": {
            "type": "string"
          }
        },
        "required": [
          "@type",
          "@id",
          "schema:termCode"
        ],
        "oneOf": [
          {
            "properties": {
              "@id": {
                "const": "ada:Direct (measured)"
              },
              "schema:termCode": {
                "const": "Direct (measured)"
              }
            }
          },
          {
            "properties": {
              "@id": {
                "const": "ada:Estimated via cation stoichiometry"
              },
              "schema:termCode": {
                "const": "Estimated via cation stoichiometry"
              }
            }
          },
          {
            "properties": {
              "@id": {
                "const": "ada:Unknown"
              },
              "schema:termCode": {
                "const": "Unknown"
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "@type",
    "schema:hasDefinedTerm"
  ],
  "examples": [
    {
      "@context": {
        "schema": "http://schema.org/",
        "ada": "https://ada.astromat.org/metadata/"
      },
      "@id": "ada:vocab/empaTAPP/elementEstimationMethod",
      "@type": "schema:DefinedTermSet",
      "schema:name": "Element Estimation Method",
      "schema:description": "How elemental concentrations were calculated — directly from measured X-ray intensities or via cation stoichiometry.",
      "schema:hasDefinedTerm": [
        {
          "@type": "schema:DefinedTerm",
          "@id": "ada:Direct (measured)",
          "schema:termCode": "Direct (measured)",
          "schema:name": "Direct (measured)"
        },
        {
          "@type": "schema:DefinedTerm",
          "@id": "ada:Estimated via cation stoichiometry",
          "schema:termCode": "Estimated via cation stoichiometry",
          "schema:name": "Estimated via cation stoichiometry"
        },
        {
          "@type": "schema:DefinedTerm",
          "@id": "ada:Unknown",
          "schema:termCode": "Unknown",
          "schema:name": "Unknown"
        }
      ]
    }
  ]
}
