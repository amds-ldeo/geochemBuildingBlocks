{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ada:vocab/empaTAPP/backgroundCorrectionMethod",
  "title": "Background Correction Method",
  "description": "Method used to estimate and subtract background X-ray intensity beneath the peak.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "schema:DefinedTermSet"
    },
    "schema:name": {
      "const": "Background Correction Method"
    },
    "schema:hasDefinedTerm": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "@type": {
            "const": "schema:DefinedTerm"
          },
          "schema:termCode": {
            "enum": [
              "2-point off-peak linear",
              "2-point off-peak exponential",
              "2-point off-peak polynomial",
              "1-point high with slope factor",
              "1-point low with slope factor",
              "Multi-point linear",
              "Multi-point exponential",
              "Mean Atomic Number (MAN)",
              "EDS background fit",
              "other",
              "N/A"
            ]
          }
        },
        "required": [
          "@type",
          "schema:termCode"
        ]
      }
    }
  },
  "required": [
    "@type",
    "schema:hasDefinedTerm"
  ],
  "examples": [
    {
      "@context": {
        "schema": "http://schema.org/",
        "ada": "https://ada.astromat.org/metadata/"
      },
      "@id": "ada:vocab/empaTAPP/backgroundCorrectionMethod",
      "@type": "schema:DefinedTermSet",
      "schema:name": "Background Correction Method",
      "schema:description": "Method used to estimate and subtract background X-ray intensity beneath the peak.",
      "schema:hasDefinedTerm": [
        {
          "@type": "schema:DefinedTerm",
          "schema:termCode": "2-point off-peak linear",
          "schema:name": "2-point off-peak linear"
        },
        {
          "@type": "schema:DefinedTerm",
          "schema:termCode": "2-point off-peak exponential",
          "schema:name": "2-point off-peak exponential"
        },
        {
          "@type": "schema:DefinedTerm",
          "schema:termCode": "2-point off-peak polynomial",
          "schema:name": "2-point off-peak polynomial"
        },
        {
          "@type": "schema:DefinedTerm",
          "schema:termCode": "1-point high with slope factor",
          "schema:name": "1-point high with slope factor"
        },
        {
          "@type": "schema:DefinedTerm",
          "schema:termCode": "1-point low with slope factor",
          "schema:name": "1-point low with slope factor"
        },
        {
          "@type": "schema:DefinedTerm",
          "schema:termCode": "Multi-point linear",
          "schema:name": "Multi-point linear"
        },
        {
          "@type": "schema:DefinedTerm",
          "schema:termCode": "Multi-point exponential",
          "schema:name": "Multi-point exponential"
        },
        {
          "@type": "schema:DefinedTerm",
          "schema:termCode": "Mean Atomic Number (MAN)",
          "schema:name": "Mean Atomic Number (MAN)"
        },
        {
          "@type": "schema:DefinedTerm",
          "schema:termCode": "EDS background fit",
          "schema:name": "EDS background fit"
        },
        {
          "@type": "schema:DefinedTerm",
          "schema:termCode": "other",
          "schema:name": "other"
        },
        {
          "@type": "schema:DefinedTerm",
          "schema:termCode": "N/A",
          "schema:name": "N/A"
        }
      ]
    }
  ]
}
