{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ada:vocab/empaTAPP/timeDependentIntensityCorrection",
  "title": "Time-Dependent Intensity Correction",
  "description": "Type of time-dependent intensity correction applied for volatile or beam-sensitive elements.",
  "type": "object",
  "properties": {
    "@type": {
      "const": "schema:DefinedTermSet"
    },
    "schema:name": {
      "const": "Time-Dependent Intensity Correction"
    },
    "schema:hasDefinedTerm": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "@type": {
            "const": "schema:DefinedTerm"
          },
          "schema:termCode": {
            "enum": [
              "None",
              "Linear",
              "Exponential",
              "Double exponential",
              "Other",
              "Unknown"
            ]
          }
        },
        "required": [
          "@type",
          "schema:termCode"
        ]
      }
    }
  },
  "required": [
    "@type",
    "schema:hasDefinedTerm"
  ],
  "examples": [
    {
      "@context": {
        "schema": "http://schema.org/",
        "ada": "https://ada.astromat.org/metadata/"
      },
      "@id": "ada:vocab/empaTAPP/timeDependentIntensityCorrection",
      "@type": "schema:DefinedTermSet",
      "schema:name": "Time-Dependent Intensity Correction",
      "schema:description": "Type of time-dependent intensity correction applied for volatile or beam-sensitive elements.",
      "schema:hasDefinedTerm": [
        {
          "@type": "schema:DefinedTerm",
          "schema:termCode": "None",
          "schema:name": "None"
        },
        {
          "@type": "schema:DefinedTerm",
          "schema:termCode": "Linear",
          "schema:name": "Linear"
        },
        {
          "@type": "schema:DefinedTerm",
          "schema:termCode": "Exponential",
          "schema:name": "Exponential"
        },
        {
          "@type": "schema:DefinedTerm",
          "schema:termCode": "Double exponential",
          "schema:name": "Double exponential"
        },
        {
          "@type": "schema:DefinedTerm",
          "schema:termCode": "Other",
          "schema:name": "Other"
        },
        {
          "@type": "schema:DefinedTerm",
          "schema:termCode": "Unknown",
          "schema:name": "Unknown"
        }
      ]
    }
  ]
}
