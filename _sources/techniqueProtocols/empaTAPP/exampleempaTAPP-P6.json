        "schema:description": "JEOL (e2v/Gresham) silicon-drift EDS spectrometer"
      }
    ]
  },
  "bios:computationalTool": [
    {
      "@type": [
        "schema:SoftwareApplication"
      ],
      "schema:name": "Probe for EPMA",
      "ada:toolRole": "acquisition"
