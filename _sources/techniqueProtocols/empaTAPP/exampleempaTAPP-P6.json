      "ada:fieldScope": "session",
      "schema:readonlyValue": true,
      "ada:tier": "R",
      "schema:defaultValue": "Yes (F correction for fluorine-bearing phosphates; CO2 by stoichiometry for carbonates)"
    }
  ],
  "ada:analyteTemplate": {
