@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <http://schema.org/> .
@prefix ada:    <https://ada.astromat.org/metadata/> .
@prefix cdifd:  <https://cdif.org/validation/0.1/shacl#> .
@base           <https://www.ogc.org/rules/template/> .

# Validates EMPA TAPP definitions (extends the ada:TAPPDefinition shape).
cdifd:empaTAPPShape
    a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            PREFIX ada: <https://ada.astromat.org/metadata/>
            SELECT ?this
            WHERE {
                ?this a ada:TAPPDefinition .
                ?this ada:beamMode ?bm .
            }
        """ ;
    ] ;
    sh:property [
        sh:path ada:beamMode ;
        sh:in ( "Focused" "Defocused" "Raster" ) ;
        sh:severity sh:Violation ;
        sh:message "ada:beamMode must be one of Focused, Defocused, Raster (per empaTAPP)." ;
    ] ;
    .
