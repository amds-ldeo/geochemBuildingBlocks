  "schema:actionProcess": {
    "@type": ["schema:HowTo"],
    "@id": "ex:howto-empaTAPP-all-workflow",
    "schema:name": "EPMA WDS analytical workflow (5 steps)",
    "schema:description": "Standard EPMA-WDS workflow exercising sample prep, calibration, acquisition, processing, QC.",
    "schema:url": "https://example.org/protocols/empaTAPP-all",
    "schema:step": [
      {
        "@type": ["schema:HowToStep", "cdi:Activity", "schema:Action"],
        "schema:name": "Sample preparation",
        "schema:description": "Polished thin section, carbon coated.",
        "schema:position": 1,
        "schema:additionalType": ["bios:LabProcess"]
      },
      {
        "@type": ["schema:HowToStep", "cdi:Activity", "schema:Action"],
        "schema:name": "Instrument calibration",
        "schema:description": "Primary calibration on natural-mineral standards.",
        "schema:position": 2
      },
      {
        "@type": ["schema:HowToStep", "cdi:Activity", "schema:Action"],
        "schema:name": "WDS acquisition",
        "schema:description": "Per-element peak/background acquisition.",
        "schema:position": 3
      },
      {
        "@type": ["schema:HowToStep", "cdi:Activity", "schema:Action"],
        "schema:name": "Data processing",
        "schema:description": "Matrix correction (PAP), TDI correction.",
        "schema:position": 4
      },
      {
        "@type": ["schema:HowToStep", "cdi:Activity", "schema:Action"],
        "schema:name": "Quality control",
        "schema:description": "Drift monitoring; precision/accuracy assessment vs secondary standards.",
        "schema:position": 5
      }
    ]
  },

