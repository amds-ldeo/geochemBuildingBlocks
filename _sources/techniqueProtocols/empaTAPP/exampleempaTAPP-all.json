      {
        "@type": [
          "schema:HowToStep",
          "cdi:Activity",
          "schema:Action"
        ],
        "schema:name": "WDS acquisition",
        "schema:description": "Per-element peak/background acquisition.",
        "schema:position": 3
      },
      {
        "@type": [
          "schema:HowToStep",
          "cdi:Activity",
          "schema:Action"
        ],
        "schema:name": "Data processing",
        "schema:description": "Matrix correction (PAP), TDI correction.",
        "schema:position": 4
