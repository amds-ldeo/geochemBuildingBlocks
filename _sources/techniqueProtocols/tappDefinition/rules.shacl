@prefix rdf:         <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:        <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:          <http://www.w3.org/ns/shacl#> .
@prefix xsd:         <http://www.w3.org/2001/XMLSchema#> .
@prefix schema:      <http://schema.org/> .
@prefix ada:         <https://ada.astromat.org/metadata/> .
@prefix bios:        <https://bioschemas.org/> .
@prefix dqv:         <http://www.w3.org/ns/dqv#> .
@prefix prov:        <http://www.w3.org/ns/prov#> .
@prefix cdi:         <http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/> .
@prefix cdifd: <https://cdif.org/validation/0.1/shacl#> .
@base <https://www.ogc.org/rules/template/> .

# Validates Technique-Aligned Protocol Profile (TAPP) definition nodes typed as ada:TAPPDefinition.
cdifd:tappDefinitionShape
    a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            PREFIX ada: <https://ada.astromat.org/metadata/>
            SELECT ?this
            WHERE {
                ?this a ada:TAPPDefinition .
            }
        """ ;
    ] ;
    sh:property [
        sh:path schema:name ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation ;
        sh:message "TAPP definition must have a schema:name." ;
    ] ;
    sh:property [
        sh:path schema:measurementTechnique ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "TAPP definition must specify a schema:measurementTechnique." ;
    ] ;
    sh:property [
        sh:path schema:actionProcess ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
        sh:message "TAPP definition should include a schema:actionProcess workflow." ;
    ] ;
    sh:property [
        sh:path schema:version ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Warning ;
        sh:message "TAPP definition should specify a schema:version." ;
    ] ;
    sh:property [
        sh:path schema:datePublished ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Warning ;
        sh:message "TAPP definition should specify schema:datePublished." ;
    ] ;
    sh:property [
        sh:path schema:instrument ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
        sh:message "TAPP definition should specify a primary instrument." ;
    ] ;
    sh:property [
        sh:path ada:analyteTemplate ;
        sh:maxCount 1 ;
        sh:severity sh:Info ;
        sh:message "TAPP definition may include an ada:analyteTemplate." ;
    ] ;
    sh:message "TAPP definition nodes (ada:TAPPDefinition) must have name and technique." ;
    .


# Within any schema:HowTo workflow, every step's schema:name and schema:position must be unique.
# JSON Schema can't express per-property uniqueness across array items; SHACL does it via SPARQL.
cdifd:WorkflowStepUniqueNamesShape
    a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            PREFIX schema: <http://schema.org/>
            SELECT DISTINCT ?this
            WHERE { ?howto schema:step ?this . }
        """ ;
    ] ;
    sh:sparql [
        sh:select """
            PREFIX schema: <http://schema.org/>
            SELECT $this ?value
            WHERE {
                ?howto schema:step $this .
                $this schema:name ?value .
                ?other schema:name ?value .
                ?howto schema:step ?other .
                FILTER ( ?other != $this )
            }
        """ ;
        sh:message "schema:name {$value} is duplicated across workflow steps; step names must be unique within a schema:HowTo." ;
    ] ;
    sh:sparql [
        sh:select """
            PREFIX schema: <http://schema.org/>
            SELECT $this ?value
            WHERE {
                ?howto schema:step $this .
                $this schema:position ?value .
                ?other schema:position ?value .
                ?howto schema:step ?other .
                FILTER ( ?other != $this )
            }
        """ ;
        sh:message "schema:position {$value} is duplicated across workflow steps; step positions must be unique within a schema:HowTo." ;
    ] ;
    .

