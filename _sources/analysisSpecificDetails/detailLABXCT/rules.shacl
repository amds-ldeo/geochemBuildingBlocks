@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix ada:    <https://ada.astromat.org/metadata/> .
@prefix cdifd:  <https://cdif.org/validation/0.1/shacl#> .
@base           <https://www.ogc.org/rules/template/> .

# Validates Lab-XCT detail nodes (ada:XCTVolume, ada:XCTSegmentationVolume, ada:XCTQuantitativeTabular).
cdifd:detailLABXCTShape
    a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            PREFIX ada: <https://ada.astromat.org/metadata/>
            SELECT ?this
            WHERE {
                { ?this a ada:XCTVolume . }
                UNION
                { ?this a ada:XCTSegmentationVolume . }
                UNION
                { ?this a ada:XCTQuantitativeTabular . }
            }
        """ ;
    ] ;
    sh:property [
        sh:path ada:analyst ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Warning ;
        sh:message "Lab-XCT detail should specify the analyst." ;
    ] ;
    sh:property [
        sh:path ada:sampleName ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Warning ;
        sh:message "Lab-XCT detail should specify the sample name." ;
    ] ;
    .
