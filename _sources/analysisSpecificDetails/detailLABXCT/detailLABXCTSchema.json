{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Lab-XCT Analysis Detail",
    "description": "Detail block for Lab-XCT hasPart items. Discriminates on ada:componentType, carries analysis-level required properties and an @id reference to a registered labxctTAPP definition, and per-dataset schema:additionalProperty entries constrained via $refs to the parameterValues registry plus a catch-all. Generated by tools/build_tapp.py.",
    "allOf": [
        {
            "type": "object",
            "properties": {
                "ada:componentType": {
                    "anyOf": [
                        {
                            "const": "ada:XCTVolume"
                        },
                        {
                            "const": "ada:XCTProjectionImageSet"
                        },
                        {
                            "const": "ada:XCTSegmentationVolume"
                        },
                        {
                            "const": "ada:XCTRenderedImage"
                        },
                        {
                            "const": "ada:XCTQuantitativeTabular"
                        }
                    ]
                },
                "schema:measurementTechnique": {
                    "type": "object",
                    "description": "@id reference to a registered labxctTAPP TAPP definition.",
                    "properties": {
                        "@id": {
                            "type": "string",
                            "format": "uri"
                        }
                    },
                    "required": [
                        "@id"
                    ]
                },
                "ada:analyst": {
                    "description": "Name(s) of the analyst(s) who operated the CT instrument for this specific analysis session. ORCID recommended.",
                    "type": "string"
                },
                "ada:analysisStartDate": {
                    "description": "Date on which the CT scan session began. For analyses spanning multiple days, use the date of the first session.",
                    "type": "string"
                },
                "ada:analysisEndDate": {
                    "description": "Date on which the CT scan session ended. May equal Analysis Start Date for single-day sessions.",
                    "type": "string"
                },
                "ada:fundingSourceForAnalysis": {
                    "description": "Grants and other funding sources that supported the specific sample analyses reported here. Distinct from protocol development funding, which may have been awarded years earlier.",
                    "type": "string"
                },
                "ada:sampleDimensions": {
                    "description": "Physical dimensions of the sample in mm, reported as length × width × height (or equivalent three orthogonal measurements). The maximum dimension constrains the minimum achievable field of view and therefore the coarsest achievable voxel size. The minimum dimension determines how many voxels span the smallest feature of interest.",
                    "type": "string"
                },
                "ada:sampleName": {
                    "description": "Name or identifier of the sample as used in the laboratory. Should match the identifier used in associated publications or data tables.",
                    "type": "string"
                },
                "ada:numberOfSubVolumes": {
                    "description": "Total number of overlapping sub-volume scans acquired to cover the full sample length. This is an analysis-level parameter: the number of sub-volumes depends on the length of the specific sample being scanned and cannot be fixed in the protocol in advance. Applies only to Mode B (multi-volume stitching).",
                    "type": "integer"
                },
                "ada:voiApplied": {
                    "description": "Actual Volume of Interest used in this specific analysis, including dimensions or defining criteria. Analysis-level companion to VOI Selection Criteria.",
                    "type": "string"
                },
                "ada:subVolumeOverlap": {
                    "description": "Actual number of reconstructed slices overlapping between adjacent sub-volumes as used in this analysis. May differ from the minimum sub-volume overlap required specified in the protocol (Group 4) if sample geometry or operator decisions resulted in greater or lesser overlap.",
                    "type": "integer"
                }
            },
            "required": [
                "ada:componentType",
                "ada:analyst",
                "ada:analysisStartDate",
                "ada:analysisEndDate",
                "ada:fundingSourceForAnalysis",
                "ada:sampleDimensions",
                "ada:sampleName",
                "ada:voiApplied"
            ]
        },
        {
            "type": "object",
            "properties": {
                "schema:additionalProperty": {
                    "type": "array",
                    "description": "Per-dataset schema:PropertyValue entries. All optional.",
                    "items": {
                        "anyOf": [
                            {
                                "$ref": "../../techniqueProtocols/parameterValues/schema.yaml#/$defs/coupledProtocolDoi"
                            },
                            {
                                "$ref": "../../techniqueProtocols/parameterValues/schema.yaml#/$defs/coupledDatasetOrPublicationReference"
                            },
                            {
                                "$ref": "../../techniqueProtocols/parameterValues/schema.yaml#/$defs/sampleMass"
                            },
                            {
                                "$ref": "../../techniqueProtocols/parameterValues/schema.yaml#/$defs/sampleMountingMethod"
                            },
                            {
                                "$ref": "../../techniqueProtocols/parameterValues/schema.yaml#/$defs/samplePersistentIdentifier"
                            },
                            {
                                "$ref": "../../techniqueProtocols/parameterValues/schema.yaml#/$defs/samplePreparationNotes"
                            },
                            {
                                "$ref": "../../techniqueProtocols/parameterValues/schema.yaml#/$defs/reconstructionSoftware"
                            },
                            {
                                "$ref": "../../techniqueProtocols/parameterValues/schema.yaml#/$defs/segmentationAndAnalysisSoftware"
                            },
                            {
                                "$ref": "../../techniqueProtocols/parameterValues/schema.yaml#/$defs/labxct_acceleratingVoltage"
                            },
                            {
                                "$ref": "../../techniqueProtocols/parameterValues/schema.yaml#/$defs/tubeCurrent"
                            },
                            {
                                "$ref": "../../techniqueProtocols/parameterValues/schema.yaml#/$defs/xRayPower"
                            },
                            {
                                "$ref": "../../techniqueProtocols/parameterValues/schema.yaml#/$defs/xRayPreFilter"
                            },
                            {
                                "$ref": "../../techniqueProtocols/parameterValues/schema.yaml#/$defs/sourceToObjectDistance"
                            },
                            {
                                "$ref": "../../techniqueProtocols/parameterValues/schema.yaml#/$defs/sourceToDetectorDistance"
                            },
                            {
                                "$ref": "../../techniqueProtocols/parameterValues/schema.yaml#/$defs/voxelSize"
                            },
                            {
                                "$ref": "../../techniqueProtocols/parameterValues/schema.yaml#/$defs/rotationRange"
                            },
                            {
                                "$ref": "../../techniqueProtocols/parameterValues/schema.yaml#/$defs/numberOfProjections"
                            },
                            {
                                "$ref": "../../techniqueProtocols/parameterValues/schema.yaml#/$defs/rotationStepSize"
                            },
                            {
                                "$ref": "../../techniqueProtocols/parameterValues/schema.yaml#/$defs/exposureTimePerProjection"
                            },
                            {
                                "$ref": "../../techniqueProtocols/parameterValues/schema.yaml#/$defs/framesAveragedPerProjection"
                            },
                            {
                                "$ref": "../../techniqueProtocols/parameterValues/schema.yaml#/$defs/detectorBinning"
                            },
                            {
                                "$ref": "../../techniqueProtocols/parameterValues/schema.yaml#/$defs/flatFieldCorrection"
                            },
                            {
                                "$ref": "../../techniqueProtocols/parameterValues/schema.yaml#/$defs/rotationMode"
                            },
                            {
                                "$ref": "../../techniqueProtocols/parameterValues/schema.yaml#/$defs/totalScanDuration"
                            },
                            {
                                "$ref": "../../techniqueProtocols/parameterValues/schema.yaml#/$defs/reconstructionConvolutionFilter"
                            },
                            {
                                "$ref": "../../techniqueProtocols/parameterValues/schema.yaml#/$defs/beamHardeningCorrectionParameter"
                            },
                            {
                                "$ref": "../../techniqueProtocols/parameterValues/schema.yaml#/$defs/ringArtifactCorrectionMethod"
                            },
                            {
                                "$ref": "../../techniqueProtocols/parameterValues/schema.yaml#/$defs/outputDataFormat"
                            },
                            {
                                "$ref": "../../techniqueProtocols/parameterValues/schema.yaml#/$defs/ctNumberCalibration"
                            },
                            {
                                "$ref": "../../techniqueProtocols/parameterValues/schema.yaml#/$defs/segmentationMethod"
                            },
                            {
                                "$ref": "../../techniqueProtocols/parameterValues/schema.yaml#/$defs/segmentationThresholdValuesOrCriteria"
                            },
                            {
                                "$ref": "../../techniqueProtocols/parameterValues/schema.yaml#/$defs/phaseIdentificationMethod"
                            },
                            {
                                "$ref": "../../techniqueProtocols/parameterValues/schema.yaml#/$defs/voiSelectionCriteria"
                            },
                            {
                                "$ref": "../../techniqueProtocols/parameterValues/schema.yaml#/$defs/subVolumeStitchingAndRegistrationMethod"
                            },
                            {
                                "$ref": "../../techniqueProtocols/parameterValues/schema.yaml#/$defs/outputBitDepth"
                            },
                            {
                                "$ref": "../../techniqueProtocols/parameterValues/schema.yaml#/$defs/spatialResolution"
                            },
                            {
                                "$ref": "../../techniqueProtocols/parameterValues/schema.yaml#/$defs/beamHardeningArtifactAssessment"
                            },
                            {
                                "$ref": "../../techniqueProtocols/parameterValues/schema.yaml#/$defs/ringArtifactSeverityAndCorrectionOutcome"
                            },
                            {
                                "$ref": "../../techniqueProtocols/parameterValues/schema.yaml#/$defs/metalStreakArtifactAssessment"
                            },
                            {
                                "$ref": "../../techniqueProtocols/parameterValues/schema.yaml#/$defs/partialVolumeEffectCriteria"
                            },
                            {
                                "$ref": "../../techniqueProtocols/parameterValues/schema.yaml#/$defs/partialVolumeEffectAssessment"
                            },
                            {
                                "$ref": "../../techniqueProtocols/parameterValues/schema.yaml#/$defs/minimumResolvableFeatureSize"
                            },
                            {
                                "$ref": "../../techniqueProtocols/parameterValues/schema.yaml#/$defs/signalToNoiseRatio"
                            },
                            {
                                "$ref": "../../techniqueProtocols/parameterValues/schema.yaml#/$defs/crossValidationProtocolRequirement"
                            },
                            {
                                "$ref": "../../techniqueProtocols/parameterValues/schema.yaml#/$defs/crossValidationOutcome"
                            },
                            {
                                "type": "object",
                                "description": "Catch-all for additional schema:PropertyValue entries beyond the labxctTAPP-derived catalog.",
                                "properties": {
                                    "@type": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        },
                                        "contains": {
                                            "const": "schema:PropertyValue"
                                        }
                                    },
                                    "schema:propertyID": {
                                        "type": "string",
                                        "not": {
                                            "enum": [
                                                "ada:parameter/labxctTAPP/coupledProtocolDoi",
                                                "ada:parameter/labxctTAPP/coupledDatasetOrPublicationReference",
                                                "ada:parameter/labxctTAPP/sampleMass",
                                                "ada:parameter/labxctTAPP/sampleMountingMethod",
                                                "ada:parameter/labxctTAPP/samplePersistentIdentifier",
                                                "ada:parameter/labxctTAPP/samplePreparationNotes",
                                                "ada:parameter/labxctTAPP/reconstructionSoftware",
                                                "ada:parameter/labxctTAPP/segmentationAndAnalysisSoftware",
                                                "ada:parameter/labxctTAPP/acceleratingVoltage",
                                                "ada:parameter/labxctTAPP/tubeCurrent",
                                                "ada:parameter/labxctTAPP/xRayPower",
                                                "ada:parameter/labxctTAPP/xRayPreFilter",
                                                "ada:parameter/labxctTAPP/sourceToObjectDistance",
                                                "ada:parameter/labxctTAPP/sourceToDetectorDistance",
                                                "ada:parameter/labxctTAPP/voxelSize",
                                                "ada:parameter/labxctTAPP/rotationRange",
                                                "ada:parameter/labxctTAPP/numberOfProjections",
                                                "ada:parameter/labxctTAPP/rotationStepSize",
                                                "ada:parameter/labxctTAPP/exposureTimePerProjection",
                                                "ada:parameter/labxctTAPP/framesAveragedPerProjection",
                                                "ada:parameter/labxctTAPP/detectorBinning",
                                                "ada:parameter/labxctTAPP/flatFieldCorrection",
                                                "ada:parameter/labxctTAPP/rotationMode",
                                                "ada:parameter/labxctTAPP/totalScanDuration",
                                                "ada:parameter/labxctTAPP/reconstructionConvolutionFilter",
                                                "ada:parameter/labxctTAPP/beamHardeningCorrectionParameter",
                                                "ada:parameter/labxctTAPP/ringArtifactCorrectionMethod",
                                                "ada:parameter/labxctTAPP/outputDataFormat",
                                                "ada:parameter/labxctTAPP/ctNumberCalibration",
                                                "ada:parameter/labxctTAPP/segmentationMethod",
                                                "ada:parameter/labxctTAPP/segmentationThresholdValuesOrCriteria",
                                                "ada:parameter/labxctTAPP/phaseIdentificationMethod",
                                                "ada:parameter/labxctTAPP/voiSelectionCriteria",
                                                "ada:parameter/labxctTAPP/subVolumeStitchingAndRegistrationMethod",
                                                "ada:parameter/labxctTAPP/outputBitDepth",
                                                "ada:parameter/labxctTAPP/spatialResolution",
                                                "ada:parameter/labxctTAPP/beamHardeningArtifactAssessment",
                                                "ada:parameter/labxctTAPP/ringArtifactSeverityAndCorrectionOutcome",
                                                "ada:parameter/labxctTAPP/metalStreakArtifactAssessment",
                                                "ada:parameter/labxctTAPP/partialVolumeEffectCriteria",
                                                "ada:parameter/labxctTAPP/partialVolumeEffectAssessment",
                                                "ada:parameter/labxctTAPP/minimumResolvableFeatureSize",
                                                "ada:parameter/labxctTAPP/signalToNoiseRatio",
                                                "ada:parameter/labxctTAPP/crossValidationProtocolRequirement",
                                                "ada:parameter/labxctTAPP/crossValidationOutcome"
                                            ]
                                        }
                                    }
                                },
                                "required": [
                                    "@type",
                                    "schema:propertyID"
                                ]
                            }
                        ]
                    }
                }
            }
        }
    ]
}
