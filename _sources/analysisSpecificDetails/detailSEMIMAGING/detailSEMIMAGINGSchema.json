{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "SEM Imaging Analysis Detail",
    "description": "Detail block for SEM imaging hasPart items. Discriminates on ada:componentType, carries analysis-level required properties and an @id reference to a registered semImagingTAPP definition, and per-dataset schema:additionalProperty entries constrained via $refs to the parameterValues registry plus a catch-all. Generated by tools/build_tapp.py.",
    "allOf": [
        {
            "type": "object",
            "properties": {
                "ada:componentType": {
                    "anyOf": [
                        {
                            "const": "ada:SEMImage"
                        },
                        {
                            "const": "ada:BSEImage"
                        },
                        {
                            "const": "ada:CLImage"
                        },
                        {
                            "const": "ada:CLSpectrum"
                        },
                        {
                            "const": "ada:EBSDMap"
                        },
                        {
                            "const": "ada:SEMTabular"
                        }
                    ]
                },
                "schema:measurementTechnique": {
                    "type": "object",
                    "description": "@id reference to a registered semImagingTAPP TAPP definition.",
                    "properties": {
                        "@id": {
                            "type": "string",
                            "format": "uri"
                        }
                    },
                    "required": [
                        "@id"
                    ]
                },
                "ada:analyst": {
                    "description": "Name of the analyst who conducted the analysis session.",
                    "type": "string"
                },
                "ada:analysisStartDate": {
                    "description": "Date on which the analysis session began.",
                    "type": "string"
                },
                "ada:analysisEndDate": {
                    "description": "Date on which the analysis session ended (if spanning multiple days).",
                    "type": "string"
                },
                "ada:fundingSourceForAnalysis": {
                    "description": "Grants and funding that supported this analytical campaign. Include grant IDs.",
                    "type": "string"
                },
                "ada:sampleName": {
                    "description": "Name or identifier of the sample or sample mount analyzed in this session.",
                    "type": "string"
                },
                "ada:imagePixelSize": {
                    "description": "Physical size of each image pixel at the sample surface, in nm or µm. Defines spatial sampling of SE or BSE images. For large-area mosaic imaging, report the pixel size of individual tiles and the number and arrangement of tiles.",
                    "anyOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "string"
                        }
                    ]
                },
                "ada:meanAngularDeviation": {
                    "description": "Mean angular deviation (MAD) of the EBSD pattern indexing solution in degrees. MAD quantifies the misfit between experimental Kikuchi band positions and the best-fit crystal orientation. Values above ~1.5 degrees typically indicate unreliable indexing.",
                    "anyOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "string"
                        }
                    ]
                },
                "ada:indexingRate": {
                    "description": "Fraction of EBSD map points successfully indexed, expressed as a percentage of total map points. Low indexing rate may indicate surface damage, amorphisation, severe deformation, or phase misidentification.",
                    "anyOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "string"
                        }
                    ]
                }
            },
            "required": [
                "ada:componentType",
                "ada:analyst",
                "ada:analysisStartDate",
                "ada:analysisEndDate",
                "ada:fundingSourceForAnalysis",
                "ada:sampleName",
                "ada:imagePixelSize",
                "ada:meanAngularDeviation",
                "ada:indexingRate"
            ]
        },
        {
            "type": "object",
            "properties": {
                "schema:additionalProperty": {
                    "type": "array",
                    "description": "Per-dataset schema:PropertyValue entries. All optional.",
                    "items": {
                        "anyOf": [
                            {
                                "$ref": "../../techniqueProtocols/parameterValues/schema.yaml#/$defs/semImaging_coupledProtocolDoi"
                            },
                            {
                                "$ref": "../../techniqueProtocols/parameterValues/schema.yaml#/$defs/semImaging_coupledDatasetOrPublicationReference"
                            },
                            {
                                "$ref": "../../techniqueProtocols/parameterValues/schema.yaml#/$defs/semImaging_samplePersistentIdentifier"
                            },
                            {
                                "$ref": "../../techniqueProtocols/parameterValues/schema.yaml#/$defs/semImaging_acceleratingVoltage"
                            },
                            {
                                "$ref": "../../techniqueProtocols/parameterValues/schema.yaml#/$defs/semImaging_beamCurrent"
                            },
                            {
                                "$ref": "../../techniqueProtocols/parameterValues/schema.yaml#/$defs/workingDistance"
                            },
                            {
                                "$ref": "../../techniqueProtocols/parameterValues/schema.yaml#/$defs/chamberPressure"
                            },
                            {
                                "$ref": "../../techniqueProtocols/parameterValues/schema.yaml#/$defs/dwellTimePerPixel"
                            },
                            {
                                "$ref": "../../techniqueProtocols/parameterValues/schema.yaml#/$defs/clIntegrationTime"
                            },
                            {
                                "$ref": "../../techniqueProtocols/parameterValues/schema.yaml#/$defs/stepSize"
                            },
                            {
                                "$ref": "../../techniqueProtocols/parameterValues/schema.yaml#/$defs/frameTime"
                            },
                            {
                                "$ref": "../../techniqueProtocols/parameterValues/schema.yaml#/$defs/phaseList"
                            },
                            {
                                "$ref": "../../techniqueProtocols/parameterValues/schema.yaml#/$defs/crystalStructureDatabase"
                            },
                            {
                                "$ref": "../../techniqueProtocols/parameterValues/schema.yaml#/$defs/patternQualityThreshold"
                            },
                            {
                                "$ref": "../../techniqueProtocols/parameterValues/schema.yaml#/$defs/clWavelengthCalibrationReference"
                            },
                            {
                                "type": "object",
                                "description": "Catch-all for additional schema:PropertyValue entries beyond the semImagingTAPP-derived catalog.",
                                "properties": {
                                    "@type": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        },
                                        "contains": {
                                            "const": "schema:PropertyValue"
                                        }
                                    },
                                    "schema:propertyID": {
                                        "type": "object",
                                        "required": [
                                            "@id"
                                        ],
                                        "properties": {
                                            "@id": {
                                                "type": "string",
                                                "not": {
                                                    "enum": [
                                                        "ada:parameter/semImagingTAPP/coupledProtocolDoi",
                                                        "ada:parameter/semImagingTAPP/coupledDatasetOrPublicationReference",
                                                        "ada:parameter/semImagingTAPP/samplePersistentIdentifier",
                                                        "ada:parameter/semImagingTAPP/acceleratingVoltage",
                                                        "ada:parameter/semImagingTAPP/beamCurrent",
                                                        "ada:parameter/semImagingTAPP/workingDistance",
                                                        "ada:parameter/semImagingTAPP/chamberPressure",
                                                        "ada:parameter/semImagingTAPP/dwellTimePerPixel",
                                                        "ada:parameter/semImagingTAPP/clIntegrationTime",
                                                        "ada:parameter/semImagingTAPP/stepSize",
                                                        "ada:parameter/semImagingTAPP/frameTime",
                                                        "ada:parameter/semImagingTAPP/phaseList",
                                                        "ada:parameter/semImagingTAPP/crystalStructureDatabase",
                                                        "ada:parameter/semImagingTAPP/patternQualityThreshold",
                                                        "ada:parameter/semImagingTAPP/clWavelengthCalibrationReference"
                                                    ]
                                                }
                                            }
                                        }
                                    }
                                },
                                "required": [
                                    "@type",
                                    "schema:propertyID"
                                ]
                            }
                        ]
                    }
                }
            }
        }
    ]
}
