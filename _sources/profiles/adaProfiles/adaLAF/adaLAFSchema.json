{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "ADA LAF Product Profile",
    "description": "Technique-specific profile for Laser-Assisted Fluorination (LAF) products. Extends the base ADA product profile with constraints on valid LAF component types and detailLAF requirements.",
    "allOf": [
        {
            "$ref": "../adaProduct/adaProductSchema.json"
        },
        {
            "type": "object",
            "properties": {
                "schema:additionalType": {
                    "description": "Must include a LAF product type identifier.",
                    "contains": {
                        "enum": [
                            "Laser Assisted Fluorination (LAF) Processed",
                            "Laser Assisted Fluorination (LAF) Raw",
                            "Laser Assisted Fluorination"
                        ]
                    }
                },
                "schema:distribution": {
                    "description": "Distribution items for adaLAF. Archive hasPart items must have ada:componentType from technique-specific or universal values.",
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "schema:hasPart": {
                                "items": {
                                    "type": "object",
                                    "anyOf": [
                                        {
                                            "$ref": "../adaProduct/schema.yaml#/$defs/universalComponentTypeBranch"
                                        },
                                        {
                                            "$ref": "../../../geochemProperties/detailLAF/detailLAFSchema.json"
                                        }
                                    ]
                                }
                            }
                        }
                    }
                },
                "schema:subjectOf": {
                    "properties": {
                        "dcterms:conformsTo": {
                            "contains": {
                                "type": "object",
                                "properties": {
                                    "@id": {
                                        "const": "https://w3id.org/geochem/metadata/profiles/adaLAF"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    ]
}
