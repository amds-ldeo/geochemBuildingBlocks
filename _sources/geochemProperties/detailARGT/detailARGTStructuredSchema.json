{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ARGT Instrument Detail",
  "description": "ARGT (Argon) document type with phase and isotope analysis",
  "type": "object",
  "properties": {
    "ada:componentType": {
      "const": "ada:ARGTDocument"
    },
    "ada:phaseAnalyzed": {
      "type": "string"
    },
    "ada:isotopeType": {
      "type": "string"
    }
  },
  "required": [
    "ada:componentType"
  ]
}
